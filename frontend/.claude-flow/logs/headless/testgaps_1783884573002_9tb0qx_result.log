  "output": "## Test Coverage Analysis\n\n**Tested:** `utils/routes.ts`, `utils/validation.ts`\n**Untested:** `api.ts`, `utils/config.ts`, `utils/errors.ts`, `utils/cache.ts`, `utils/formatting.ts`, `utils/transcript.ts`, `hooks/useCountUp.ts`, `hooks/useKeyboardShortcuts.ts`, `hooks/useToasts.ts`\n\n### 1. `api.ts` — token storage + `request()` + `apiUrl()` (highest priority — auth/network core, zero tests)\n\nGaps: 401 auto-clears token, non-2xx throws `ApiError` with status, 204 returns undefined, `apiUrl` protocol passthrough vs relative-path join, missing leading slash handling.\n\n```ts\n// src/api.test.ts\nimport { describe, it, expect, beforeEach, vi } from 'vitest';\nimport { apiUrl, getToken, setToken, clearToken, ApiError } from './api';\n\ndescribe('token storage', () => {\n  beforeEach(() => localStorage.clear());\n  it('round-trips a token', () => {\n    setToken('abc');\n    expect(getToken()).toBe('abc');\n  });\n  it('returns empty string when no token set', () => {\n    expect(getToken()).toBe('');\n  });\n  it('clears token', () => {\n    setToken('abc'); clearToken();\n    expect(getToken()).toBe('');\n  });\n});\n\ndescribe('apiUrl', () => {\n  it('passes through absolute http(s) urls unchanged', () => {\n    expect(apiUrl('https://x.test/y')).toBe('https://x.test/y');\n  });\n  it('joins relative paths without leading slash', () => {\n    expect(apiUrl('foo')).toBe(`${API_BASE}/foo`);\n  });\n  it('does not double the leading slash', () => {\n    expect(apiUrl('/foo')).toBe(`${API_BASE}/foo`);\n  });\n});\n\ndescribe('request (via fetch mock)', () => {\n  beforeEach(() => { localStorage.clear(); vi.restoreAllMocks(); });\n\n  it('clears token and throws ApiError on 401', async () => {\n    setToken('stale');\n    vi.stubGlobal('fetch', vi.fn().mockResolvedValue(\n      new Response('unauthorized', { status: 401 })\n    ));\n    // call whatever exported function wraps request(), e.g. listBots()\n    await expect(listBots()).rejects.toBeInstanceOf(ApiError);\n    expect(getToken()).toBe('');\n  });\n\n  it('throws ApiError with status + body text on non-ok response', async () => {\n    vi.stubGlobal('fetch', vi.fn().mockResolvedValue(\n      new Response('boom', { status: 500, statusText: 'Server Error' })\n    ));\n    await expect(listBots()).rejects.toMatchObject({ status: 500, message: 'boom' });\n  });\n\n  it('returns undefined on 204 No Content', async () => {\n    vi.stubGlobal('fetch', vi.fn().mockResolvedValue(new Response(null, { status: 204 })));\n    await expect(deleteBot('id')).resolves.toBeUndefined();\n  });\n\n  it('sends Authorization header only when a token is set', async () => {\n    const fetchMock = vi.fn().mockResolvedValue(new Response('{}', { status: 200 }));\n    vi.stubGlobal('fetch', fetchMock);\n    await listBots();\n    expect(fetchMock.mock.calls[0][1].headers.Authorization).toBeUndefined();\n    setToken('t1');\n    await listBots();\n    expect(fetchMock.mock.calls[1][1].headers.Authorization).toBe('Bearer t1');\n  });\n});\n```\n*(swap `listBots`/`deleteBot` for actual exported wrappers in `api.ts` — file was truncated, so confirm exact names.)*\n\n### 2. `utils/errors.ts` — `classifyNetworkError` / `friendlyApiError` / `friendlyTestError` (untested branch-heavy logic)\n\n```ts\n// src/utils/errors.test.ts\nimport { describe, it, expect } from 'vitest';\nimport { friendlyApiError, friendlyTestError, summarizeDetails, average, buildDiagnostic } from './errors';\n\ndescribe('friendlyApiError', () => {\n  it('adds context for \"network timeout\"', () => {\n    expect(friendlyApiError(new Error('network timeout'))).toMatch(/Mongo\\/LiveKit/);\n  });\n  it('adds context for \"failed to fetch\"', () => {\n    expect(friendlyApiError(new Error('failed to fetch'))).toMatch(/start_api\\.sh/);\n  });\n  it('passes through unrecognized errors verbatim', () => {\n    expect(friendlyApiError(new Error('weird one-off'))).toBe('weird one-off');\n  });\n  it('handles non-Error thrown values', () => {\n    expect(friendlyApiError('plain string')).toBe('plain string');\n  });\n});\n\ndescribe('friendlyTestError', () => {\n  it('flags missing LiveKit config', () => {\n    expect(friendlyTestError(new Error('LiveKit is not configured'))).toMatch(/LIVEKIT_URL/);\n  });\n  it('flags room-creation failure', () => {\n    expect(friendlyTestError(new Error('Could not create LiveKit test room'))).toMatch(/LiveKit server/);\n  });\n  it('flags microphone permission errors', () => {\n    expect(friendlyTestError(new Error('permission denied'))).toMatch(/microphone/i);\n  });\n  it('flags websocket/network errors', () => {\n    expect(friendlyTestError(new Error('websocket closed'))).toMatch(/ws\\/wss/);\n  });\n  it('falls back to generic message for unknown errors', () => {\n    expect(friendlyTestError(new Error(''))).toMatch(/Unknown test call error/);\n  });\n});\n\ndescribe('summarizeDetails', () => {\n  it('joins up to 4 entries, stringifying objects', () => {\n    const out = summarizeDetails({ a: 1, b: { x: 1 }, c: 'y', d: true, e: 'dropped' });\n    expect(out.split(' | ')).toHaveLength(4);\n    expect(out).toContain('b: {\"x\":1}');\n  });\n  it('returns empty string for empty object', () => {\n    expect(summarizeDetails({})).toBe('');\n  });\n});\n\ndescribe('average', () => {\n  it('returns 0 for empty array', () => expect(average([])).toBe(0));\n  it('rounds the mean', () => expect(average([1, 2])).toBe(2));\n});\n\ndescribe('buildDiagnostic', () => {\n  it('truncates messages over 220 chars with ellipsis', () => {\n    const d = buildDiagnostic('scope', new Error('x'.repeat(300)));\n    expect(d.message.endsWith('...')).toBe(true);\n    expect(d.message.length).toBe(223);\n  });\n  it('defaults severity to error', () => {\n    expect(buildDiagnostic('scope', new Error('x')).severity).toBe('error');\n  });\n});\n```\n\n### 3. `utils/transcript.ts` — `buildConversationItems` (complex merge/sort logic, zero tests, high regression risk)\n\nEdge cases not covered: no transcript → `[]`; verified transcript present but status not `succeeded` (should fall back); turns with no `created_at` (uses event-anchored fallback ordering); mixed turns where only some have timestamps.\n\n```ts\n// src/utils/transcript.test.ts\nimport { describe, it, expect } from 'vitest';\nimport { buildConversationItems, normalizeTranscriptRole, timestampValue, transcriptSourceLabel } from './transcript';\n\ndescribe('buildConversationItems', () => {\n  it('returns empty array when transcript is undefined', () => {\n    expect(buildConversationItems(undefined, [])).toEqual([]);\n  });\n\n  it('prefers verified_transcript when status is succeeded and non-empty', () => {\n    const t = {\n      verified_transcript_status: 'succeeded',\n      verified_transcript: [{ role: 'user', text: 'v', created_at: '2026-01-01T00:00:00Z' }],\n      transcript: [{ role: 'user', text: 'plain' }],\n    } as any;\n    const items = buildConversationItems(t, []);\n    expect(items.some((i) => i.kind === 'turn' && (i as any).text === 'v')).toBe(true);\n  });\n\n  it('falls back to transcript when verified_transcript_status is pending', () => {\n    const t = { verified_transcript_status: 'pending', verified_transcript: [{ role: 'user', text: 'v' }],\n      transcript: [{ role: 'user', text: 'plain', created_at: '2026-01-01T00:00:00Z' }] } as any;\n    const items = buildConversationItems(t, []);\n    expect(items.some((i) => i.kind === 'turn' && (i as any).text === 'plain')).toBe(true);\n  });\n\n  it('sorts turns and inline events chronologically when turns have timestamps', () => {\n    const t = { transcript: [\n      { role: 'user', text: 'second', created_at: '2026-01-01T00:00:02Z' },\n      { role: 'assistant', text: 'first', created_at: '2026-01-01T00:00:01Z' },\n    ]} as any;\n    const items = buildConversationItems(t, []);\n    expect((items[0] as any).text).toBe('first');\n  });\n\n  it('uses start/end event bucketing fallback when no turn has created_at', () => {\n    const t = { transcript: [{ role: 'user', text: 'no-ts' }] } as any;\n    const events = [\n      { _id: '1', event_type: 'call_started', created_at: '2026-01-01T00:00:00Z' },\n      { _id: '2', event_type: 'call_ended', created_at: '2026-01-01T00:00:05Z' },\n    ];\n    const items = buildConversationItems(t, events as any);\n    expect(items[0]).toMatchObject({ kind: 'event', title: 'call_started' });\n    expect(items[items.length - 1]).toMatchObject({ kind: 'event', title: 'call_ended' });\n  });\n\n  it('marks a turn interrupted via event_type containing \"interrupt\"', () => {\n    const t = { transcript: [{ role: 'user', text: 'x', event_type: 'user_interruption' }] } as any;\n    const items = buildConversationItems(t, []);\n    expect((items[0] as any).interrupted).toBe(true);\n  });\n\n  it('filters non-inline event types out of the merged list', () => {\n    const t = { transcript: [{ role: 'user', text: 'x', created_at: '2026-01-01T00:00:00Z' }] } as any;\n    const events = [{ _id: '9', event_type: 'not_in_inline_set', created_at: '2026-01-01T00:00:00Z' }];\n    const items = buildConversationItems(t, events as any);\n    expect(items.some((i) => i.kind === 'event')).toBe(false);\n  });\n});\n\ndescribe('normalizeTranscriptRole', () => {\n  it('maps synonyms to canonical roles', () => {\n    expect(normalizeTranscriptRole('agent')).toBe('assistant');\n    expect(normalizeTranscriptRole('caller')).toBe('user');\n    expect(normalizeTranscriptRole('recording')).toBe('recording');\n  });\n  it('defaults to system for empty/unknown role', () => {\n    expect(normalizeTranscriptRole('')).toBe('system');\n    expect(normalizeTranscriptRole('weird')).toBe('weird');\n  });\n});\n\ndescribe('timestampValue', () => {\n  it('returns MAX_SAFE_INTEGER for missing or unparsable dates', () => {\n    expect(timestampValue(undefined)).toBe(Number.MAX_SAFE_INTEGER);\n    expect(timestampValue('not-a-date')).toBe(Number.MAX_SAFE_INTEGER);\n  });\n});\n\ndescribe('transcriptSourceLabel', () => {\n  it.each([\n    ['succeeded', 'Verified recording'],\n    ['pending', 'Live transcript, verification pending'],\n    ['failed', 'Live transcript, verification failed'],\n    ['unavailable', 'Live transcript, recording unavailable'],\n  ])('status=%s -> %s', (status, label) => {\n    expect(transcriptSourceLabel({ verified_transcript_status: status } as any)).toBe(label);\n  });\n});\n```\n\n### 4. `utils/formatting.ts` — date/time formatting, no timezone handling tests\n\n```ts\n// src/utils/formatting.test.ts\nimport { describe, it, expect } from 'vitest';\nimport { shortId, parseApiDate, formatDate, titleCase, timeAgo } from './formatting';\n\ndescribe('shortId', () => {\n  it('returns \"-\" for empty input', () => expect(shortId('')).toBe('-'));\n  it('leaves short ids unchanged', () => expect(shortId('abc123')).toBe('abc123'));\n  it('truncates long ids with ellipsis', () => {\n    expect(shortId('abcdefghijklmnop')).toBe('abcdefgh...mnop');\n  });\n});\n\ndescribe('parseApiDate', () => {\n  it('appends Z when no timezone is present', () => {\n    const d = parseApiDate('2026-01-01T00:00:00');\n    expect(d.toISOString()).toBe('2026-01-01T00:00:00.000Z');\n  });\n  it('respects an existing timezone offset', () => {\n    const d = parseApiDate('2026-01-01T00:00:00+05:30');\n    expect(d.getUTCHours()).toBe(18); // prior day 18:30 UTC\n  });\n});\n\ndescribe('formatDate / timeAgo edge cases', () => {\n  it('returns \"-\" for undefined input', () => {\n    expect(formatDate(undefined)).toBe('-');\n    expect(timeAgo(undefined)).toBe('-');\n  });\n  it('returns the raw string for an unparsable date', () => {\n    expect(formatDate('not-a-date')).toBe('not-a-date');\n  });\n  it('timeAgo buckets: just now / min / hr / yesterday / full date', () => {\n    const now = Date.now();\n    expect(timeAgo(new Date(now - 30_000).toISOString())).toBe('just now');\n    expect(timeAgo(new Date(now - 5 * 60_000).toISOString())).toMatch(/min ago/);\n    expect(timeAgo(new Date(now - 3 * 3600_000).toISOString())).toMatch(/hr ago/);\n    expect(timeAgo(new Date(now - 30 * 3600_000).toISOString())).toBe('yesterday');\n  });\n});\n\ndescribe('titleCase', () => {\n  it('handles underscores, dashes and multiple spaces', () => {\n    expect(titleCase('call_started-now')).toBe('Call Started Now');\n  });\n  it('returns \"-\" for undefined/empty', () => expect(titleCase(undefined)).toBe('-'));\n});\n```\n\n### 5. `utils/cache.ts` — localStorage best-effort wrappers (error-swallowing paths untested)\n\n```ts\n// src/utils/cache.test.ts\nimport { describe, it, expect, vi, beforeEach } from 'vitest';\nimport { cacheSet, cacheGet, pruneOldCache, CACHE_PREFIX } from './cache';\n\ndescribe('cacheSet/cacheGet', () => {\n  beforeEach(() => localStorage.clear());\n  it('round-trips a value', () => {\n    cacheSet('k', { a: 1 });\n    expect(cacheGet('k', null)).toEqual({ a: 1 });\n  });\n  it('returns fallback when key is missing', () => {\n    expect(cacheGet('missing', 'fb')).toBe('fb');\n  });\n  it('returns fallback when stored value is corrupt JSON', () => {\n    localStorage.setItem(`${CACHE_PREFIX}bad`, '{not json');\n    expect(cacheGet('bad', 'fb')).toBe('fb');\n  });\n  it('swallows setItem errors (e.g. quota exceeded)', () => {\n    vi.spyOn(Storage.prototype, 'setItem').mockImplementation(() => { throw new Error('quota'); });\n    expect(() => cacheSet('k', 'v')).not.toThrow();\n    vi.restoreAllMocks();\n  });\n});\n\ndescribe('pruneOldCache', () => {\n  it('removes keys from older cache versions but keeps current-version keys', () => {\n    localStorage.setItem('jd-vb:v1:old', '1');\n    localStorage.setItem(`${CACHE_PREFIX}new`, '1');\n    pruneOldCache();\n    expect(localStorage.getItem('jd-vb:v1:old')).toBeNull();\n    expect(localStorage.getItem(`${CACHE_PREFIX}new`)).toBe('1');\n  });\n});\n```\n\n### 6. `utils/config.ts` — `parseConfig` / `deriveAgentState` (state machine untested)\n\n```ts\n// src/utils/config.test.ts\nimport { describe, it, expect } from 'vitest';\nimport { parseConfig, deriveAgentState } from './config';\n\ndescribe('parseConfig', () => {\n  it('returns ok:true with parsed value for valid JSON', () => {\n    expect(parseConfig('{\"a\":1}')).toEqual({ ok: true, value: { a: 1 } });\n  });\n  it('returns ok:false with an error message for invalid JSON', () => {\n    const r = parseConfig('{bad');\n    expect(r.ok).toBe(false);\n  });\n});\n\ndescribe('deriveAgentState', () => {\n  it('is idle when hasRoom is false regardless of status', () => {\n    expect(deriveAgentState('speaking', true, false)).toBe('idle');\n  });\n  it('is idle for disconnected status', () => {\n    expect(deriveAgentState('Disconnected', false, true)).toBe('idle');\n  });\n  it('is connecting for creating/connecting/requesting/reconnecting', () => {\n    expect(deriveAgentState('Reconnecting', false, true)).toBe('connecting');\n  });\n  it('is speaking when remoteAudioReady even if status text does not say so', () => {\n    expect(deriveAgentState('some other status', true, true)).toBe('speaking');\n  });\n  it('is thinking for \"waiting for bot\"/\"participant joined\"', () => {\n    expect(deriveAgentState('Participant joined', false, true)).toBe('thinking');\n  });\n  it('defaults to listening otherwise', () => {\n    expect(deriveAgentState('normal', false, true)).toBe('listening');\n  });\n});\n```\n\n### 7. `hooks/useToasts.ts` — timers + id counter untested\n\n```ts\n// src/hooks/useToasts.test.tsx\nimport { describe, it, expect, vi, beforeEach, afterEach } from 'vitest';\nimport { renderHook, act } from '@testing-library/react';\nimport { useToasts } from './useToasts';\n\ndescribe('useToasts', () => {\n  beforeEach(() => vi.useFakeTimers());\n  afterEach(() => vi.useRealTimers());\n\n  it('adds a toast with incrementing ids', () => {\n    const { result } = renderHook(() => useToasts());\n    act(() => { result.current.showToast('hi'); });\n    expect(result.current.toasts).toHaveLength(1);\n    expect(result.current.toasts[0].id).toBe('toast-1');\n  });\n\n  it('auto-dismisses after the default duration', () => {\n    const { result } = renderHook(() => useToasts());\n    act(() => { result.current.showToast('bye'); });\n    act(() => { vi.advanceTimersByTime(4000); });\n    expect(result.current.toasts).toHaveLength(0);\n  });\n\n  it('does not auto-dismiss when durationMs is 0', () => {\n    const { result } = renderHook(() => useToasts());\n    act(() => { result.current.showToast('sticky', 'info', 0); });\n    act(() => { vi.advanceTimersByTime(100000); });\n    expect(result.current.toasts).toHaveLength(1);\n  });\n\n  it('dismissToast removes only the targeted toast', () => {\n    const { result } = renderHook(() => useToasts());\n    act(() => { result.current.showToast('a'); result.current.showToast('b'); });\n    act(() => { result.current.dismissToast('toast-1'); });\n    expect(result.current.toasts.map((t) => t.id)).toEqual(['toast-2']);\n  });\n});\n```\n\n### 8. `hooks/useKeyboardShortcuts.ts` — key-dispatch matrix untested\n\n```ts\n// src/hooks/useKeyboardShortcuts.test.tsx\nimport { describe, it, expect, vi } from 'vitest';\nimport { renderHook } from '@testing-library/react';\nimport { useKeyboardShortcuts } from './useKeyboardShortcuts';\n\nfunction fireKey(key: string, opts: Partial<KeyboardEvent> = {}) {\n  window.dispatchEvent(new KeyboardEvent('keydown', { key, bubbles: true, ...opts }));\n}\n\ndescribe('useKeyboardShortcuts', () => {\n  it('calls closeModal on Escape', () => {\n    const close = vi.fn();\n    renderHook(() => useKeyboardShortcuts(vi.fn(), vi.fn(), close));\n    fireKey('Escape');\n    expect(close).toHaveBeenCalled();\n  });\n\n  it('calls toggleShortcuts on \"?\"', () => {\n    const toggle = vi.fn();\n    renderHook(() => useKeyboardShortcuts(vi.fn(), toggle, vi.fn()));\n    fireKey('?');\n    expect(toggle).toHaveBeenCalled();\n  });\n\n  it('ignores keystrokes when a modifier key is held', () => {\n    const nav = vi.fn();\n    renderHook(() => useKeyboardShortcuts(nav, vi.fn(), vi.fn()));\n    fireKey('a', { metaKey: true } as any);\n    expect(nav).not.toHaveBeenCalled();\n  });\n\n  it('ignores keystrokes targeting an input/textarea/select', () => {\n    const nav = vi.fn();\n    renderHook(() => useKeyboardShortcuts(nav, vi.fn(), vi.fn()));\n    const input = document.createElement('input');\n    document.body.appendChild(input);\n    input.dispatchEvent(new KeyboardEvent('keydown', { key: 'a', bubbles: true }));\n    expect(nav).not.toHaveBeenCalled();\n    input.remove();\n  });\n\n  it('navigates using the latest callback via ref even after re-render', () => {\n    const nav1 = vi.fn();\n    const nav2 = vi.fn();\n    const { rerender } = renderHook(({ nav }) => useKeyboardShortcuts(nav, vi.fn(), vi.fn()), {\n      initialProps: { nav: nav1 },\n    });\n    rerender({ nav: nav2 });\n    fireKey('b'); // assuming 'b' maps to a SHORTCUT_MAP entry — adjust to a real mapped key\n    expect(nav1).not.toHaveBeenCalled();\n    expect(nav2).toHaveBeenCalled();\n  });\n});\n```\n\n### 9. `hooks/useCountUp.ts` — animation logic, needs rAF control\n\n```ts\n// src/hooks/useCountUp.test.tsx\nimport { describe, it, expect, vi } from 'vitest';\nimport { renderHook } from '@testing-library/react';\nimport { useCountUp } from './useCountUp';\n\ndescribe('useCountUp', () => {\n  it('stays at 0 immediately when target is 0', () => {\n    const { result } = renderHook(() => useCountUp(0));\n    expect(result.current.value).toBe(0);\n  });\n\n  it('resets to 0 when target changes back to 0', () => {\n    const { result, rerender } = renderHook(({ t }) => useCountUp(t), { initialProps: { t: 100 } });\n    rerender({ t: 0 });\n    expect(result.current.value).toBe(0);\n  });\n\n  // Full rAF-driven progression to `target` requires mocking requestAnimationFrame/performance.now\n  // with a controllable fake clock — flag as integration-test gap if not covered elsewhere.\n});\n```\n\n## Missing error-handling tests (call out explicitly, not just gaps in normal paths)\n\n- `api.ts`: no test asserts `ApiError.status` is preserved through catch blocks in calling code, or what happens if `response.text()` itself rejects (`.catch(() => '')` path is silently untested).\n- `cache.ts`: `cacheGet`/`cacheSet` swallow *all* errors — no test differentiates quota errors from `JSON.parse` errors from storage being unavailable (private browsing / SSR).\n- `config.ts` `parseConfig`: no test for non-string/circular input, or config missing required fields downstream.\n- `transcript.ts`: no test for malformed `CallEvent`/`Transcript` (missing `_id`, `event_type` undefined) — `eventToConversationItem` will throw on `event.event_type.replace` if `event_type` is undefined.\n\n## Integration-test gaps\n\n1. **Auth flow end-to-end**: token set → 401 response → token cleared → app redirects to login — no test exercises this across `api.ts` + whatever consumes it (likely `App.tsx`).\n2. **Transcript view assembly**: `buildConversationItems` + `formatTime`/`normalizeTranscriptRole` combined against a realistic API payload fixture, not just unit-level mocks.\n3. **Route sync with browser history**: `routes.ts` is unit-tested, but nothing verifies `popstate`/back-button behavior wired through the app shell.\n4. **Toast + API error pipeline**: `friendlyApiError`/`buildDiagnostic` → `useToasts` → rendered UI has no test confirming a failed API call actually surfaces a toast with the friendly message.\n\nHighest priority to close first: **`api.ts` request/token handling** and **`transcript.ts` buildConversationItems** — both are complex, branch-heavy, and sit on the critical path (auth security, call-data correctness) with currently zero coverage.\n",

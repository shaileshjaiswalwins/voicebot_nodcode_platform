        "code": "// src/utils/transcript.test.ts\nimport {\n  buildConversationItems, normalizeTranscriptRole, transcriptSourceLabel,\n  maxResponseDelayLabel, timestampValue, eventToConversationItem\n} from './transcript';\nimport type { Transcript, CallEvent } from '../api';\n\ndescribe('buildConversationItems', () => {\n  it('returns [] when transcript is undefined', () => {\n    expect(buildConversationItems(undefined, [])).toEqual([]);\n  });\n  it('prefers verified_transcript when status is succeeded', () => {\n    const t = {\n      verified_transcript_status: 'succeeded',\n      verified_transcript: [{ role: 'user', text: 'hi' }],\n      transcript: [{ role: 'user', text: 'ignored' }],\n    } as unknown as Transcript;\n    const items = buildConversationItems(t, []);\n    expect(items.some(i => i.kind === 'turn' && i.text === 'hi')).toBe(true);\n  });\n  it('falls back to transcript then live_transcript when not verified', () => {\n    const t = { transcript: [], live_transcript: [{ role: 'agent', text: 'fallback' }] } as unknown as Transcript;\n    const items = buildConversationItems(t, []);\n    expect(items.some(i => i.kind === 'turn' && i.text === 'fallback')).toBe(true);\n  });\n  it('sorts by sortAt when turns have created_at timestamps', () => {\n    const t = {\n      transcript: [\n        { role: 'user', text: 'second', created_at: '2026-01-01T00:00:02Z' },\n        { role: 'agent', text: 'first', created_at: '2026-01-01T00:00:01Z' },\n      ],\n    } as unknown as Transcript;\n    const items = buildConversationItems(t, []);\n    expect(items.map(i => (i as any).text)).toEqual(['first', 'second']);\n  });\n  it('buckets start/mid/end events around turns when no turn has created_at', () => {\n    const t = { transcript: [{ role: 'user', text: 'mid' }] } as unknown as Transcript;\n    const events = [\n      { _id: '1', event_type: 'call_started', created_at: '2026-01-01T00:00:00Z' } as CallEvent,\n      { _id: '2', event_type: 'call_ended', created_at: '2026-01-01T00:00:05Z' } as CallEvent,\n    ];\n    const items = buildConversationItems(t, events);\n    expect(items[0]).toMatchObject({ kind: 'event', title: 'call_started' });\n    expect(items[items.length - 1]).toMatchObject({ kind: 'event', title: 'call_ended' });\n  });\n});\n\ndescribe('normalizeTranscriptRole', () => {\n  it.each([\n    ['assistant', 'assistant'], ['bot', 'assistant'], ['model', 'assistant'],\n    ['user', 'user'], ['caller', 'user'],\n    ['recording', 'recording'],\n    ['', 'system'], ['weird_role', 'weird_role'],\n  ])('maps %s -> %s', (input, expected) => {\n    expect(normalizeTranscriptRole(input)).toBe(expected);\n  });\n});\n\ndescribe('transcriptSourceLabel', () => {\n  it.each([\n    ['succeeded', 'Verified recording'],\n    ['pending', 'Live transcript, verification pending'],\n    ['failed', 'Live transcript, verification failed'],\n    ['unavailable', 'Live transcript, recording unavailable'],\n  ])('status %s -> %s', (status, expected) => {\n    expect(transcriptSourceLabel({ verified_transcript_status: status } as Transcript)).toBe(expected);\n  });\n  it('falls back to analysis_transcript_source title-cased', () => {\n    expect(transcriptSourceLabel({ analysis_transcript_source: 'gemini_live' } as Transcript)).toBe('Gemini Live');\n  });\n});\n\ndescribe('maxResponseDelayLabel', () => {\n  it('returns \"-\" when no delay recorded', () => {\n    expect(maxResponseDelayLabel({} as Transcript)).toBe('-');\n  });\n  it('flags >=8000ms as high', () => {\n    expect(maxResponseDelayLabel({ latency_metrics: { max_response_delay_ms: 9000 } } as Transcript)).toBe('9000ms high');\n  });\n  it('flags >=3000ms as slow', () => {\n    expect(maxResponseDelayLabel({ latency_metrics: { max_response_delay_ms: 3500 } } as Transcript)).toBe('3500ms slow');\n  });\n  it('returns plain ms below 3000', () => {\n    expect(maxResponseDelayLabel({ latency_metrics: { max_response_delay_ms: 1200 } } as Transcript)).toBe('1200ms');\n  });\n});\n\ndescribe('timestampValue', () => {\n  it('returns MAX_SAFE_INTEGER for undefined or unparseable dates', () => {\n    expect(timestampValue(undefined)).toBe(Number.MAX_SAFE_INTEGER);\n    expect(timestampValue('not-a-date')).toBe(Number.MAX_SAFE_INTEGER);\n  });\n});"

)).toBe('A B C');\n  });\n});\n\ndescribe('timeAgo', () => {\n  it('returns \"-\" for undefined', () => expect(timeAgo(undefined)).toBe('-'));\n  it('returns \"just now\" under 60s', () => {\n    expect(timeAgo(new Date(Date.now() - 5_000).toISOString())).toBe('just now');\n  });\n  it('returns minutes under an hour', () => {\n    expect(timeAgo(new Date(Date.now() - 5 * 60_000).toISOString())).toBe('5 min ago');\n  });\n  it('returns hours under a day', () => {\n    expect(timeAgo(new Date(Date.now() - 5 * 3_600_000).toISOString())).toBe('5 hr ago');\n  });\n  it('returns \"yesterday\" for 1-2 days ago', () => {\n    expect(timeAgo(new Date(Date.now() - 100_000_000).toISOString())).toBe('yesterday');\n  });\n  it('falls back to formatDate beyond 2 days', () => {\n    const iso = new Date(Date.now() - 5 * 86_400_000).toISOString();\n    expect(timeAgo(iso)).toBe(formatDate(iso));\n  });\n});\n```\n\n### 2. `src/utils/errors.ts` — fully untested, has branching classification logic\nGaps: `classifyNetworkError` for both contexts, all `friendlyTestError` substring branches (LiveKit config, room creation, permission/microphone, websocket), `buildDiagnostic` truncation at 220 chars, `summarizeDetails` object-vs-primitive formatting and the 4-item slice.\n\n```ts\n// src/utils/errors.test.ts\nimport { friendlyApiError, friendlyTestError, summarizeDetails, average, buildDiagnostic } from './errors';\n\ndescribe('friendlyApiError', () => {\n  it('adds context for \"failed to fetch\"', () => {\n    expect(friendlyApiError(new Error('Failed to fetch'))).toContain('Cannot reach the FastAPI backend');\n  });\n  it('adds context for network timeout', () => {\n    expect(friendlyApiError(new Error('Network timeout'))).toContain('backend may be slow');\n  });\n  it('passes through unrelated errors unchanged', () => {\n    expect(friendlyApiError(new Error('boom'))).toBe('boom');\n  });\n  it('stringifies non-Error values', () => {\n    expect(friendlyApiError('plain string')).toBe('plain string');\n  });\n});\n\ndescribe('friendlyTestError', () => {\n  it('flags missing LiveKit configuration', () => {\n    expect(friendlyTestError(new Error('LiveKit is not configured'))).toContain('LIVEKIT_URL');\n  });\n  it('flags room creation failure', () => {\n    expect(friendlyTestError(new Error('Could not create LiveKit test room'))).toContain('LiveKit credentials');\n  });\n  it('flags microphone permission errors case-insensitively', () => {\n    expect(friendlyTestError(new Error('Permission denied for microphone'))).toContain('microphone permission');\n  });\n  it('flags websocket/network errors', () => {\n    expect(friendlyTestError(new Error('WebSocket connection failed'))).toContain('ws/wss');\n  });\n  it('falls back to a generic message for unknown errors', () => {\n    expect(friendlyTestError(new Error(''))).toBe('Unknown test call error. Check backend logs and LiveKit server status.');\n  });\n});\n\ndescribe('summarizeDetails', () => {\n  it('joins up to 4 entries with key: value', () => {\n    expect(summarizeDetails({ a: 1, b: 'x' })).toBe('a: 1 | b: x');\n  });\n  it('truncates to the first 4 entries', () => {\n    const details = { a: 1, b: 2, c: 3, d: 4, e: 5 };\n    expect(summarizeDetails(details).split(' | ')).toHaveLength(4);\n  });\n  it('JSON-stringifies object values', () => {\n    expect(summarizeDetails({ meta: { x: 1 } })).toBe('meta: {\"x\":1}');\n  });\n});\n\ndescribe('average', () => {\n  it('returns 0 for an empty array', () => expect(average([])).toBe(0));\n  it('rounds the mean', () => expect(average([1, 2, 4])).toBe(2));\n});\n\ndescribe('buildDiagnostic', () => {\n  it('truncates messages over 220 chars with ellipsis', () => {\n    const d = buildDiagnostic('scope', new Error('x'.repeat(300)));\n    expect(d.message.endsWith('...')).toBe(true);\n    expect(d.message.length).toBe(223);\n  });\n  it('defaults severity to error', () => {\n    expect(buildDiagnostic('scope', new Error('boom')).severity).toBe('error');\n  });\n});\n```\n\n### 3. `src/utils/cache.ts` — fully untested, has try/catch fallbacks that need forced-failure coverage\nGaps: `cacheSet`/`cacheGet` happy path, `cacheGet` fallback on corrupt JSON, `cacheSet` swallowing a `localStorage.setItem` throw (quota exceeded), `pruneOldCache` removing stale-prefixed keys while preserving current-version keys.\n\n```ts\n// src/utils/cache.test.ts\nimport { cacheSet, cacheGet, pruneOldCache, CACHE_PREFIX } from './cache';\n\ndescribe('cacheSet / cacheGet', () => {\n  beforeEach(() => window.localStorage.clear());\n\n  it('round-trips a value', () => {\n    cacheSet('k', { a: 1 });\n    expect(cacheGet('k', null)).toEqual({ a: 1 });\n  });\n  it('returns fallback when key is missing', () => {\n    expect(cacheGet('missing', 'fallback')).toBe('fallback');\n  });\n  it('returns fallback when stored value is corrupt JSON', () => {\n    window.localStorage.setItem(`${CACHE_PREFIX}bad`, '{not json');\n    expect(cacheGet('bad', 'fallback')).toBe('fallback');\n  });\n  it('swallows a setItem quota error instead of throwing', () => {\n    const spy = vi.spyOn(Storage.prototype, 'setItem').mockImplementation(() => { throw new Error('quota'); });\n    expect(() => cacheSet('k', 'v')).not.toThrow();\n    spy.mockRestore();\n  });\n});\n\ndescribe('pruneOldCache', () => {\n  it('removes keys with a stale jd-vb: prefix but keeps current-version keys', () => {\n    window.localStorage.setItem('jd-vb:v1:old', 'x');\n    window.localStorage.setItem(`${CACHE_PREFIX}new`, 'y');\n    pruneOldCache();\n    expect(window.localStorage.getItem('jd-vb:v1:old')).toBeNull();\n    expect(window.localStorage.getItem(`${CACHE_PREFIX}new`)).toBe('y');\n  });\n});\n```\n\n### 4. `src/utils/config.ts` — fully untested\nGaps: `parseConfig` valid/invalid JSON, every `deriveAgentState` priority branch (order matters — `remoteAudioReady` should win even mid-\"thinking\" status text; `!hasRoom` should force idle regardless of status).\n\n```ts\n// src/utils/config.test.ts\nimport { parseConfig, deriveAgentState } from './config';\n\ndescribe('parseConfig', () => {\n  it('parses valid JSON', () => {\n    expect(parseConfig('{\"a\":1}')).toEqual({ ok: true, value: { a: 1 } });\n  });\n  it('returns an error result for invalid JSON', () => {\n    const result = parseConfig('{bad');\n    expect(result.ok).toBe(false);\n  });\n});\n\ndescribe('deriveAgentState', () => {\n  it('is idle when there is no room, regardless of status text', () => {\n    expect(deriveAgentState('speaking', false, false)).toBe('idle');\n  });\n  it('is idle for explicit idle/disconnected status', () => {\n    expect(deriveAgentState('Disconnected', false, true)).toBe('idle');\n  });\n  it('is connecting for creating/connecting/requesting/reconnecting', () => {\n    expect(deriveAgentState('Reconnecting...', false, true)).toBe('connecting');\n  });\n  it('is speaking when remoteAudioReady is true even if status says thinking', () => {\n    expect(deriveAgentState('thinking', true, true)).toBe('speaking');\n  });\n  it('is thinking for waiting-for-bot/participant-joined status', () => {\n    expect(deriveAgentState('Participant joined', false, true)).toBe('thinking');\n  });\n  it('defaults to listening for unmatched status', () => {\n    expect(deriveAgentState('unknown-state', false, true)).toBe('listening');\n  });\n});\n```\n\n### 5. `src/utils/transcript.ts` — fully untested, most complex pure-logic file\nGaps: `buildConversationItems` verified-vs-live-vs-raw transcript source selection, sort-by-time vs event-bucketing fallback when turns lack timestamps, `normalizeTranscriptRole` mapping table, `transcriptSourceLabel` all four `verified_transcript_status` branches, `maxResponseDelayLabel` thresholds (0/<3000/<8000/>=8000), `timestampValue` invalid-date fallback to MAX_SAFE_INTEGER.\n\n```ts\n// src/utils/transcript.test.ts\nimport {\n  buildConversationItems, normalizeTranscriptRole, transcriptSourceLabel,\n  maxResponseDelayLabel, timestampValue, eventToConversationItem\n} from './transcript';\nimport type { Transcript, CallEvent } from '../api';\n\ndescribe('buildConversationItems', () => {\n  it('returns [] when transcript is undefined', () => {\n    expect(buildConversationItems(undefined, [])).toEqual([]);\n  });\n  it('prefers verified_transcript when status is succeeded', () => {\n    const t = {\n      verified_transcript_status: 'succeeded',\n      verified_transcript: [{ role: 'user', text: 'hi' }],\n      transcript: [{ role: 'user', text: 'ignored' }],\n    } as unknown as Transcript;\n    const items = buildConversationItems(t, []);\n    expect(items.some(i => i.kind === 'turn' && i.text === 'hi')).toBe(true);\n  });\n  it('falls back to transcript then live_transcript when not verified', () => {\n    const t = { transcript: [], live_transcript: [{ role: 'agent', text: 'fallback' }] } as unknown as Transcript;\n    const items = buildConversationItems(t, []);\n    expect(items.some(i => i.kind === 'turn' && i.text === 'fallback')).toBe(true);\n  });\n  it('sorts by sortAt when turns have created_at timestamps', () => {\n    const t = {\n      transcript: [\n        { role: 'user', text: 'second', created_at: '2026-01-01T00:00:02Z' },\n        { role: 'agent', text: 'first', created_at: '2026-01-01T00:00:01Z' },\n      ],\n    } as unknown as Transcript;\n    const items = buildConversationItems(t, []);\n    expect(items.map(i => (i as any).text)).toEqual(['first', 'second']);\n  });\n  it('buckets start/mid/end events around turns when no turn has created_at', () => {\n    const t = { transcript: [{ role: 'user', text: 'mid' }] } as unknown as Transcript;\n    const events = [\n      { _id: '1', event_type: 'call_started', created_at: '2026-01-01T00:00:00Z' } as CallEvent,\n      { _id: '2', event_type: 'call_ended', created_at: '2026-01-01T00:00:05Z' } as CallEvent,\n    ];\n    const items = buildConversationItems(t, events);\n    expect(items[0]).toMatchObject({ kind: 'event', title: 'call_started' });\n    expect(items[items.length - 1]).toMatchObject({ kind: 'event', title: 'call_ended' });\n  });\n});\n\ndescribe('normalizeTranscriptRole', () => {\n  it.each([\n    ['assistant', 'assistant'], ['bot', 'assistant'], ['model', 'assistant'],\n    ['user', 'user'], ['caller', 'user'],\n    ['recording', 'recording'],\n    ['', 'system'], ['weird_role', 'weird_role'],\n  ])('maps %s -> %s', (input, expected) => {\n    expect(normalizeTranscriptRole(input)).toBe(expected);\n  });\n});\n\ndescribe('transcriptSourceLabel', () => {\n  it.each([\n    ['succeeded', 'Verified recording'],\n    ['pending', 'Live transcript, verification pending'],\n    ['failed', 'Live transcript, verification failed'],\n    ['unavailable', 'Live transcript, recording unavailable'],\n  ])('status %s -> %s', (status, expected) => {\n    expect(transcriptSourceLabel({ verified_transcript_status: status } as Transcript)).toBe(expected);\n  });\n  it('falls back to analysis_transcript_source title-cased', () => {\n    expect(transcriptSourceLabel({ analysis_transcript_source: 'gemini_live' } as Transcript)).toBe('Gemini Live');\n  });\n});\n\ndescribe('maxResponseDelayLabel', () => {\n  it('returns \"-\" when no delay recorded', () => {\n    expect(maxResponseDelayLabel({} as Transcript)).toBe('-');\n  });\n  it('flags >=8000ms as high', () => {\n    expect(maxResponseDelayLabel({ latency_metrics: { max_response_delay_ms: 9000 } } as Transcript)).toBe('9000ms high');\n  });\n  it('flags >=3000ms as slow', () => {\n    expect(maxResponseDelayLabel({ latency_metrics: { max_response_delay_ms: 3500 } } as Transcript)).toBe('3500ms slow');\n  });\n  it('returns plain ms below 3000', () => {\n    expect(maxResponseDelayLabel({ latency_metrics: { max_response_delay_ms: 1200 } } as Transcript)).toBe('1200ms');\n  });\n});\n\ndescribe('timestampValue', () => {\n  it('returns MAX_SAFE_INTEGER for undefined or unparseable dates', () => {\n    expect(timestampValue(undefined)).toBe(Number.MAX_SAFE_INTEGER);\n    expect(timestampValue('not-a-date')).toBe(Number.MAX_SAFE_INTEGER);\n  });\n});\n```\n\n### 6. Hooks — `useCountUp`, `useKeyboardShortcuts`, `useToasts` — fully untested\nGaps: `useToasts` add/auto-dismiss/manual-dismiss/`durationMs=0` (no auto-dismiss); `useKeyboardShortcuts` ignoring keys while focused in input/textarea/select/contentEditable, Escape and `?` handling, modifier-key bailout, shortcut-map navigation; `useCountUp` reaching target and zero-target short-circuit.\n\n```ts\n// src/hooks/useToasts.test.ts\nimport { renderHook, act } from '@testing-library/react';\nimport { useToasts } from './useToasts';\n\ndescribe('useToasts', () => {\n  beforeEach(() => vi.useFakeTimers());\n  afterEach(() => vi.useRealTimers());\n\n  it('adds a toast and auto-dismisses after duration', () => {\n    const { result } = renderHook(() => useToasts());\n    act(() => { result.current.showToast('hi', 'success', 1000); });\n    expect(result.current.toasts).toHaveLength(1);\n    act(() => { vi.advanceTimersByTime(1000); });\n    expect(result.current.toasts).toHaveLength(0);\n  });\n\n  it('does not auto-dismiss when durationMs is 0', () => {\n    const { result } = renderHook(() => useToasts());\n    act(() => { result.current.showToast('sticky', 'info', 0); });\n    act(() => { vi.advanceTimersByTime(10_000); });\n    expect(result.current.toasts).toHaveLength(1);\n  });\n\n  it('dismissToast removes a specific toast by id', () => {\n    const { result } = renderHook(() => useToasts());\n    let id = '';\n    act(() => { id = result.current.showToast('x', 'error', 0); });\n    act(() => { result.current.dismissToast(id); });\n    expect(result.current.toasts).toHaveLength(0);\n  });\n\n  it('assigns unique incrementing ids across multiple toasts', () => {\n    const { result } = renderHook(() => useToasts());\n    act(() => {\n      result.current.showToast('a', 'success', 0);\n      result.current.showToast('b', 'success', 0);\n    });\n    expect(new Set(result.current.toasts.map(t => t.id)).size).toBe(2);\n  });\n});\n```\n\n```ts\n// src/hooks/useKeyboardShortcuts.test.ts\nimport { renderHook } from '@testing-library/react';\nimport { useKeyboardShortcuts } from './useKeyboardShortcuts';\nimport { SHORTCUT_MAP } from '../constants/ui';\n\nfunction fire(key: string, target: HTMLElement = document.body, opts: KeyboardEventInit = {}) {\n  const event = new KeyboardEvent('keydown', { key, bubbles: true, ...opts });\n  Object.defineProperty(event, 'target', { value: target });\n  window.dispatchEvent(event);\n}\n\ndescribe('useKeyboardShortcuts', () => {\n  it('calls closeModal on Escape', () => {\n    const closeModal = vi.fn();\n    renderHook(() => useKeyboardShortcuts(vi.fn(), vi.fn(), closeModal));\n    fire('Escape');\n    expect(closeModal).toHaveBeenCalled();\n  });\n\n  it('calls toggleShortcuts on \"?\"', () => {\n    const toggle = vi.fn();\n    renderHook(() => useKeyboardShortcuts(vi.fn(), toggle, vi.fn()));\n    fire('?');\n    expect(toggle).toHaveBeenCalled();\n  });\n\n  it('ignores keys when focus is inside an input', () => {\n    const navigate = vi.fn();\n    renderHook(() => useKeyboardShortcuts(navigate, vi.fn(), vi.fn()));\n    const input = document.createElement('input');\n    fire(SHORTCUT_MAP[0].key, input);\n    expect(navigate).not.toHaveBeenCalled();\n  });\n\n  it('ignores keys with a modifier held', () => {\n    const navigate = vi.fn();\n    renderHook(() => useKeyboardShortcuts(navigate, vi.fn(), vi.fn()));\n    fire(SHORTCUT_MAP[0].key, document.body, { metaKey: true });\n    expect(navigate).not.toHaveBeenCalled();\n  });\n\n  it('navigates on a matching shortcut key', () => {\n    const navigate = vi.fn();\n    renderHook(() => useKeyboardShortcuts(navigate, vi.fn(), vi.fn()));\n    fire(SHORTCUT_MAP[0].key);\n    expect(navigate).toHaveBeenCalledWith(SHORTCUT_MAP[0].view);\n  });\n});\n```\n\n```ts\n// src/hooks/useCountUp.test.ts\nimport { renderHook, act } from '@testing-library/react';\nimport { useCountUp } from './useCountUp';\n\ndescribe('useCountUp', () => {\n  it('stays at 0 immediately when target is 0', () => {\n    const { result } = renderHook(() => useCountUp(0));\n    expect(result.current.value).toBe(0);\n  });\n\n  it('eventually reaches the target value', async () => {\n    const { result } = renderHook(() => useCountUp(100, 50));\n    await act(async () => { await new Promise(r => setTimeout(r, 120)); });\n    expect(result.current.value).toBe(100);\n  });\n});\n```\n\n## Not covered here (already flagged in prior session, still open)\n- `callback_worker/analysis.py` (`generate_call_analysis`, `fuzzy_match_opt_id`, `status_to_outcome`, `fallback_analysis`) — zero tests, and `generate_call_analysis` is 2,184 lines in one function, needs decomposition before it's meaningfully testable.\n- `callback_worker/callback.py` (`send_callback`, `build_callback_payload`) and `worker.py` (`_process_doc`) — zero tests, retry/dedup and orchestration logic.\n- `src/api.ts` — the `request()` wrapper's 401-clears-token and non-ok-throws-ApiError paths are untested; would need `fetch` mocking (MSW or `vi.stubGlobal('fetch', ...)`).\n\nPriority order if implementing: `formatting.ts` → `errors.ts` → `cache.ts` → `config.ts` → `transcript.ts` → hooks. All are pure/isolated with no new dependencies needed (vitest + `@testing-library/react` already present in the repo).\n",

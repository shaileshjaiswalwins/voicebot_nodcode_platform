        "language": "ts",
        "code": "// src/utils/formatting.test.ts\nimport { shortId, parseApiDate, formatDate, formatTime, titleCase, timeAgo } from './formatting';\n\ndescribe('shortId', () => {\n  it('returns \"-\" for empty string', () => expect(shortId('')).toBe('-'));\n  it('returns value unchanged at or under 12 chars', () => expect(shortId('123456789012')).toBe('123456789012'));\n  it('truncates strings over 12 chars', () => expect(shortId('abcdefghijklmnop')).toBe('abcdefgh...mnop'));\n});\n\ndescribe('parseApiDate', () => {\n  it('appends Z when no timezone present', () => {\n    expect(parseApiDate('2026-01-01T00:00:00').toISOString()).toBe('2026-01-01T00:00:00.000Z');\n  });\n  it('leaves an explicit timezone offset untouched', () => {\n    expect(parseApiDate('2026-01-01T00:00:00+05:30').getTime())\n      .toBe(new Date('2026-01-01T00:00:00+05:30').getTime());\n  });\n});\n\ndescribe('formatDate / formatTime', () => {\n  it('returns \"-\" for undefined/empty input', () => {\n    expect(formatDate(undefined)).toBe('-');\n    expect(formatTime('')).toBe('-');\n  });\n  it('returns the raw value when the date is unparseable', () => {\n    expect(formatDate('not-a-date')).toBe('not-a-date');\n  });\n});\n\ndescribe('titleCase', () => {\n  it('capitalizes each word split on space/underscore/dash', () => {\n    expect(titleCase('call_ended-now here')).toBe('Call Ended Now Here');\n  });\n  it('collapses repeated delimiters without empty segments', () => {\n    expect(titleCase('a__b--c')).toBe('A B C');\n  });\n});\n\ndescribe('timeAgo', () => {\n  it('returns \"-\" for undefined', () => expect(timeAgo(undefined)).toBe('-'));\n  it('returns \"just now\" under 60s', () => {\n    expect(timeAgo(new Date(Date.now() - 5_000).toISOString())).toBe('just now');\n  });\n  it('returns minutes under an hour', () => {\n    expect(timeAgo(new Date(Date.now() - 5 * 60_000).toISOString())).toBe('5 min ago');\n  });\n  it('returns hours under a day', () => {\n    expect(timeAgo(new Date(Date.now() - 5 * 3_600_000).toISOString())).toBe('5 hr ago');\n  });\n  it('returns \"yesterday\" for 1-2 days ago', () => {\n    expect(timeAgo(new Date(Date.now() - 100_000_000).toISOString())).toBe('yesterday');\n  });\n  it('falls back to formatDate beyond 2 days', () => {\n    const iso = new Date(Date.now() - 5 * 86_400_000).toISOString();\n    expect(timeAgo(iso)).toBe(formatDate(iso));\n  });\n});"

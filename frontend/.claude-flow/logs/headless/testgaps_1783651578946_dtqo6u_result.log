        "code": "// src/hooks/useKeyboardShortcuts.test.ts\nimport { renderHook } from '@testing-library/react';\nimport { useKeyboardShortcuts } from './useKeyboardShortcuts';\nimport { SHORTCUT_MAP } from '../constants/ui';\n\nfunction fire(key: string, target: HTMLElement = document.body, opts: KeyboardEventInit = {}) {\n  const event = new KeyboardEvent('keydown', { key, bubbles: true, ...opts });\n  Object.defineProperty(event, 'target', { value: target });\n  window.dispatchEvent(event);\n}\n\ndescribe('useKeyboardShortcuts', () => {\n  it('calls closeModal on Escape', () => {\n    const closeModal = vi.fn();\n    renderHook(() => useKeyboardShortcuts(vi.fn(), vi.fn(), closeModal));\n    fire('Escape');\n    expect(closeModal).toHaveBeenCalled();\n  });\n\n  it('calls toggleShortcuts on \"?\"', () => {\n    const toggle = vi.fn();\n    renderHook(() => useKeyboardShortcuts(vi.fn(), toggle, vi.fn()));\n    fire('?');\n    expect(toggle).toHaveBeenCalled();\n  });\n\n  it('ignores keys when focus is inside an input', () => {\n    const navigate = vi.fn();\n    renderHook(() => useKeyboardShortcuts(navigate, vi.fn(), vi.fn()));\n    const input = document.createElement('input');\n    fire(SHORTCUT_MAP[0].key, input);\n    expect(navigate).not.toHaveBeenCalled();\n  });\n\n  it('ignores keys with a modifier held', () => {\n    const navigate = vi.fn();\n    renderHook(() => useKeyboardShortcuts(navigate, vi.fn(), vi.fn()));\n    fire(SHORTCUT_MAP[0].key, document.body, { metaKey: true });\n    expect(navigate).not.toHaveBeenCalled();\n  });\n\n  it('navigates on a matching shortcut key', () => {\n    const navigate = vi.fn();\n    renderHook(() => useKeyboardShortcuts(navigate, vi.fn(), vi.fn()));\n    fire(SHORTCUT_MAP[0].key);\n    expect(navigate).toHaveBeenCalledWith(SHORTCUT_MAP[0].view);\n  });\n});"

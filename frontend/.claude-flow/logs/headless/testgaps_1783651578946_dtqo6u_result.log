        "title": "6. Hooks — `useCountUp`, `useKeyboardShortcuts`, `useToasts` — fully untested",
        "content": "Gaps: `useToasts` add/auto-dismiss/manual-dismiss/`durationMs=0` (no auto-dismiss); `useKeyboardShortcuts` ignoring keys while focused in input/textarea/select/contentEditable, Escape and `?` handling, modifier-key bailout, shortcut-map navigation; `useCountUp` reaching target and zero-target short-circuit.\n\n```ts\n// src/hooks/useToasts.test.ts\nimport { renderHook, act } from '@testing-library/react';\nimport { useToasts } from './useToasts';\n\ndescribe('useToasts', () => {\n  beforeEach(() => vi.useFakeTimers());\n  afterEach(() => vi.useRealTimers());\n\n  it('adds a toast and auto-dismisses after duration', () => {\n    const { result } = renderHook(() => useToasts());\n    act(() => { result.current.showToast('hi', 'success', 1000); });\n    expect(result.current.toasts).toHaveLength(1);\n    act(() => { vi.advanceTimersByTime(1000); });\n    expect(result.current.toasts).toHaveLength(0);\n  });\n\n  it('does not auto-dismiss when durationMs is 0', () => {\n    const { result } = renderHook(() => useToasts());\n    act(() => { result.current.showToast('sticky', 'info', 0); });\n    act(() => { vi.advanceTimersByTime(10_000); });\n    expect(result.current.toasts).toHaveLength(1);\n  });\n\n  it('dismissToast removes a specific toast by id', () => {\n    const { result } = renderHook(() => useToasts());\n    let id = '';\n    act(() => { id = result.current.showToast('x', 'error', 0); });\n    act(() => { result.current.dismissToast(id); });\n    expect(result.current.toasts).toHaveLength(0);\n  });\n\n  it('assigns unique incrementing ids across multiple toasts', () => {\n    const { result } = renderHook(() => useToasts());\n    act(() => {\n      result.current.showToast('a', 'success', 0);\n      result.current.showToast('b', 'success', 0);\n    });\n    expect(new Set(result.current.toasts.map(t => t.id)).size).toBe(2);\n  });\n});\n```\n\n```ts\n// src/hooks/useKeyboardShortcuts.test.ts\nimport { renderHook } from '@testing-library/react';\nimport { useKeyboardShortcuts } from './useKeyboardShortcuts';\nimport { SHORTCUT_MAP } from '../constants/ui';\n\nfunction fire(key: string, target: HTMLElement = document.body, opts: KeyboardEventInit = {}) {\n  const event = new KeyboardEvent('keydown', { key, bubbles: true, ...opts });\n  Object.defineProperty(event, 'target', { value: target });\n  window.dispatchEvent(event);\n}\n\ndescribe('useKeyboardShortcuts', () => {\n  it('calls closeModal on Escape', () => {\n    const closeModal = vi.fn();\n    renderHook(() => useKeyboardShortcuts(vi.fn(), vi.fn(), closeModal));\n    fire('Escape');\n    expect(closeModal).toHaveBeenCalled();\n  });\n\n  it('calls toggleShortcuts on \"?\"', () => {\n    const toggle = vi.fn();\n    renderHook(() => useKeyboardShortcuts(vi.fn(), toggle, vi.fn()));\n    fire('?');\n    expect(toggle).toHaveBeenCalled();\n  });\n\n  it('ignores keys when focus is inside an input', () => {\n    const navigate = vi.fn();\n    renderHook(() => useKeyboardShortcuts(navigate, vi.fn(), vi.fn()));\n    const input = document.createElement('input');\n    fire(SHORTCUT_MAP[0].key, input);\n    expect(navigate).not.toHaveBeenCalled();\n  });\n\n  it('ignores keys with a modifier held', () => {\n    const navigate = vi.fn();\n    renderHook(() => useKeyboardShortcuts(navigate, vi.fn(), vi.fn()));\n    fire(SHORTCUT_MAP[0].key, document.body, { metaKey: true });\n    expect(navigate).not.toHaveBeenCalled();\n  });\n\n  it('navigates on a matching shortcut key', () => {\n    const navigate = vi.fn();\n    renderHook(() => useKeyboardShortcuts(navigate, vi.fn(), vi.fn()));\n    fire(SHORTCUT_MAP[0].key);\n    expect(navigate).toHaveBeenCalledWith(SHORTCUT_MAP[0].view);\n  });\n});\n```\n\n```ts\n// src/hooks/useCountUp.test.ts\nimport { renderHook, act } from '@testing-library/react';\nimport { useCountUp } from './useCountUp';\n\ndescribe('useCountUp', () => {\n  it('stays at 0 immediately when target is 0', () => {\n    const { result } = renderHook(() => useCountUp(0));\n    expect(result.current.value).toBe(0);\n  });\n\n  it('eventually reaches the target value', async () => {\n    const { result } = renderHook(() => useCountUp(100, 50));\n    await act(async () => { await new Promise(r => setTimeout(r, 120)); });\n    expect(result.current.value).toBe(100);\n  });\n});\n```\n\n",
        "level": 3
      },

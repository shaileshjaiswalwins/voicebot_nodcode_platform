  "output": "Confirmed: `src/utils/formatting.ts`, `src/utils/errors.ts`, `src/utils/transcript.ts`, `src/utils/config.ts`, `src/utils/cache.ts`, `src/api.ts`, and all hooks (`useCountUp`, `useKeyboardShortcuts`, `useToasts`) have zero test files. That's the gap set to focus on.\n\n## Untested modules & gaps\n\n### 1. `src/utils/formatting.ts` — fully untested\nEdge cases missed: empty/undefined input, missing timezone offset (`parseApiDate` appends `Z`), invalid date strings, `timeAgo` boundary values (59s/60s, 3599s/3600s, 23h59m/24h, 47h59m/48h).\n\n```ts\n// src/utils/formatting.test.ts\nimport { describe, it, expect } from 'vitest';\nimport { shortId, parseApiDate, formatDate, formatTime, titleCase, timeAgo } from './formatting';\n\ndescribe('shortId', () => {\n  it('returns \"-\" for empty string', () => {\n    expect(shortId('')).toBe('-');\n  });\n  it('truncates long ids to head...tail', () => {\n    expect(shortId('abcdefghijklmnop')).toBe('abcdefgh...mnop');\n  });\n  it('returns short ids unchanged', () => {\n    expect(shortId('abc')).toBe('abc');\n  });\n});\n\ndescribe('parseApiDate', () => {\n  it('appends Z when no timezone present', () => {\n    const d = parseApiDate('2026-01-01T00:00:00');\n    expect(d.getTime()).toBe(new Date('2026-01-01T00:00:00Z').getTime());\n  });\n  it('respects an existing timezone offset', () => {\n    const d = parseApiDate('2026-01-01T00:00:00+05:30');\n    expect(d.toISOString()).toBe(new Date('2026-01-01T00:00:00+05:30').toISOString());\n  });\n});\n\ndescribe('formatDate/formatTime', () => {\n  it('returns \"-\" for undefined', () => {\n    expect(formatDate(undefined)).toBe('-');\n    expect(formatTime(undefined)).toBe('-');\n  });\n  it('returns the raw value for an unparseable date', () => {\n    expect(formatDate('not-a-date')).toBe('not-a-date');\n  });\n});\n\ndescribe('titleCase', () => {\n  it('splits on spaces/underscores/hyphens and capitalizes', () => {\n    expect(titleCase('call_started-now')).toBe('Call Started Now');\n  });\n  it('handles empty string', () => {\n    expect(titleCase('')).toBe('');\n  });\n});\n\ndescribe('timeAgo', () => {\n  it('returns \"-\" for undefined', () => {\n    expect(timeAgo(undefined)).toBe('-');\n  });\n  it('returns \"just now\" under 60s', () => {\n    expect(timeAgo(new Date(Date.now() - 30_000).toISOString())).toBe('just now');\n  });\n  it('returns minutes ago between 60s and 1h', () => {\n    expect(timeAgo(new Date(Date.now() - 5 * 60_000).toISOString())).toBe('5 min ago');\n  });\n  it('returns hours ago between 1h and 24h', () => {\n    expect(timeAgo(new Date(Date.now() - 3 * 3600_000).toISOString())).toBe('3 hr ago');\n  });\n  it('returns \"yesterday\" between 24h and 48h', () => {\n    expect(timeAgo(new Date(Date.now() - 30 * 3600_000).toISOString())).toBe('yesterday');\n  });\n  it('falls back to formatDate beyond 48h', () => {\n    const iso = new Date(Date.now() - 72 * 3600_000).toISOString();\n    expect(timeAgo(iso)).toBe(formatDate(iso));\n  });\n});\n```\n\n### 2. `src/utils/errors.ts` — fully untested, has branching error-classification logic (the actual bug-prone part)\n\n```ts\n// src/utils/errors.test.ts\nimport { describe, it, expect } from 'vitest';\nimport { friendlyApiError, friendlyTestError, summarizeDetails, average, buildDiagnostic } from './errors';\n\ndescribe('friendlyApiError', () => {\n  it('classifies \"network timeout\" for api context', () => {\n    expect(friendlyApiError(new Error('network timeout'))).toContain('backend may be slow');\n  });\n  it('classifies \"failed to fetch\"', () => {\n    expect(friendlyApiError(new Error('Failed to fetch'))).toContain('start_api.sh');\n  });\n  it('passes through unrecognized errors', () => {\n    expect(friendlyApiError(new Error('boom'))).toBe('boom');\n  });\n  it('stringifies non-Error values', () => {\n    expect(friendlyApiError('plain string')).toBe('plain string');\n  });\n});\n\ndescribe('friendlyTestError', () => {\n  it('flags missing LiveKit config', () => {\n    expect(friendlyTestError(new Error('LiveKit is not configured'))).toContain('LIVEKIT_URL');\n  });\n  it('flags room creation failure', () => {\n    expect(friendlyTestError(new Error('Could not create LiveKit test room'))).toContain('LiveKit server');\n  });\n  it('flags microphone permission errors case-insensitively', () => {\n    expect(friendlyTestError(new Error('Permission denied for microphone'))).toContain('microphone permission');\n  });\n  it('flags websocket/network errors', () => {\n    expect(friendlyTestError(new Error('WebSocket connection failed'))).toContain('ws/wss');\n  });\n  it('falls back to a generic message for unrecognized errors', () => {\n    expect(friendlyTestError(new Error(''))).toBe('Unknown test call error. Check backend logs and LiveKit server status.');\n  });\n});\n\ndescribe('summarizeDetails', () => {\n  it('joins up to 4 entries and stringifies objects', () => {\n    const result = summarizeDetails({ a: 1, b: { x: 1 }, c: 'y', d: 2, e: 3 });\n    expect(result.split(' | ')).toHaveLength(4);\n    expect(result).toContain('b: {\"x\":1}');\n  });\n  it('returns empty string for empty object', () => {\n    expect(summarizeDetails({})).toBe('');\n  });\n});\n\ndescribe('average', () => {\n  it('returns 0 for empty array', () => {\n    expect(average([])).toBe(0);\n  });\n  it('rounds the mean', () => {\n    expect(average([1, 2])).toBe(2); // rounds 1.5 -> 2\n  });\n});\n\ndescribe('buildDiagnostic', () => {\n  it('truncates messages over 220 chars with ellipsis', () => {\n    const long = 'x'.repeat(300);\n    const d = buildDiagnostic('scope', new Error(long));\n    expect(d.message.endsWith('...')).toBe(true);\n    expect(d.message.length).toBe(223);\n  });\n  it('defaults severity to error', () => {\n    const d = buildDiagnostic('scope', new Error('e'));\n    expect(d.severity).toBe('error');\n  });\n});\n```\n\n### 3. `src/utils/transcript.ts` — untested, has the most complex conditional logic in `src/utils` (conversation ordering, fallback transcript source selection)\n\n```ts\n// src/utils/transcript.test.ts\nimport { describe, it, expect } from 'vitest';\nimport {\n  buildConversationItems, eventToConversationItem, timestampValue,\n  normalizeTranscriptRole, transcriptSourceLabel, maxResponseDelayLabel,\n} from './transcript';\nimport type { Transcript, CallEvent } from '../api';\n\ndescribe('buildConversationItems', () => {\n  it('returns [] when transcript is undefined', () => {\n    expect(buildConversationItems(undefined, [])).toEqual([]);\n  });\n  it('prefers verified_transcript when status succeeded', () => {\n    const t = {\n      verified_transcript_status: 'succeeded',\n      verified_transcript: [{ role: 'user', text: 'hi', created_at: '2026-01-01T00:00:00Z' }],\n      transcript: [{ role: 'user', text: 'ignored' }],\n    } as unknown as Transcript;\n    const items = buildConversationItems(t, []);\n    expect(items.some((i) => i.kind === 'turn' && i.text === 'hi')).toBe(true);\n  });\n  it('falls back to live_transcript when transcript missing', () => {\n    const t = { live_transcript: [{ role: 'agent', text: 'hello' }] } as unknown as Transcript;\n    const items = buildConversationItems(t, []);\n    expect(items.some((i) => i.kind === 'turn' && i.text === 'hello')).toBe(true);\n  });\n  it('interleaves inline events by timestamp when turns have timestamps', () => {\n    const t = {\n      transcript: [{ role: 'user', text: 'hi', created_at: '2026-01-01T00:00:02Z' }],\n    } as unknown as Transcript;\n    const events = [{ _id: 'e1', event_type: 'call_started', created_at: '2026-01-01T00:00:01Z' }] as CallEvent[];\n    const items = buildConversationItems(t, events);\n    expect(items[0].kind).toBe('event');\n  });\n  it('buckets events into start/middle/end when turns lack timestamps', () => {\n    const t = { transcript: [{ role: 'user', text: 'hi' }] } as unknown as Transcript;\n    const events = [\n      { _id: 'e1', event_type: 'call_started', created_at: '' },\n      { _id: 'e2', event_type: 'call_ended', created_at: '' },\n    ] as CallEvent[];\n    const items = buildConversationItems(t, events);\n    expect(items[0].kind === 'event' && items[0].title).toBe('call_started');\n    expect(items[items.length - 1].kind === 'event' && items[items.length - 1].title).toBe('call_ended');\n  });\n});\n\ndescribe('normalizeTranscriptRole', () => {\n  it('maps known aliases', () => {\n    expect(normalizeTranscriptRole('bot')).toBe('assistant');\n    expect(normalizeTranscriptRole('caller')).toBe('user');\n    expect(normalizeTranscriptRole('verified_recording')).toBe('recording');\n  });\n  it('defaults unknown/empty role to system', () => {\n    expect(normalizeTranscriptRole('')).toBe('system');\n    expect(normalizeTranscriptRole('weird')).toBe('weird');\n  });\n});\n\ndescribe('timestampValue', () => {\n  it('returns MAX_SAFE_INTEGER for missing/invalid values', () => {\n    expect(timestampValue(undefined)).toBe(Number.MAX_SAFE_INTEGER);\n    expect(timestampValue('not-a-date')).toBe(Number.MAX_SAFE_INTEGER);\n  });\n});\n\ndescribe('transcriptSourceLabel', () => {\n  it.each([\n    ['succeeded', 'Verified recording'],\n    ['pending', 'Live transcript, verification pending'],\n    ['failed', 'Live transcript, verification failed'],\n    ['unavailable', 'Live transcript, recording unavailable'],\n  ])('maps status %s', (status, label) => {\n    expect(transcriptSourceLabel({ verified_transcript_status: status } as Transcript)).toBe(label);\n  });\n  it('falls back to analysis_transcript_source title-cased', () => {\n    expect(transcriptSourceLabel({ analysis_transcript_source: 'gemini_live' } as Transcript)).toBe('Gemini Live');\n  });\n});\n\ndescribe('maxResponseDelayLabel', () => {\n  it('returns \"-\" when no latency metrics', () => {\n    expect(maxResponseDelayLabel({} as Transcript)).toBe('-');\n  });\n  it('flags high delay >= 8000ms', () => {\n    expect(maxResponseDelayLabel({ latency_metrics: { max_response_delay_ms: 9000 } } as Transcript)).toBe('9000ms high');\n  });\n  it('flags slow delay >= 3000ms and < 8000ms', () => {\n    expect(maxResponseDelayLabel({ latency_metrics: { max_response_delay_ms: 3000 } } as Transcript)).toBe('3000ms slow');\n  });\n});\n```\n\n### 4. `src/utils/config.ts` — untested (`deriveAgentState` has many branches feeding the live-call UI)\n\n```ts\n// src/utils/config.test.ts\nimport { describe, it, expect } from 'vitest';\nimport { parseConfig, deriveAgentState } from './config';\n\ndescribe('parseConfig', () => {\n  it('parses valid JSON', () => {\n    const result = parseConfig('{\"agent_name\":\"a\"}');\n    expect(result).toEqual({ ok: true, value: { agent_name: 'a' } });\n  });\n  it('returns error for invalid JSON', () => {\n    const result = parseConfig('{bad');\n    expect(result.ok).toBe(false);\n  });\n});\n\ndescribe('deriveAgentState', () => {\n  it('returns idle when hasRoom is false regardless of status', () => {\n    expect(deriveAgentState('speaking', false, false)).toBe('idle');\n  });\n  it('returns idle for disconnected status', () => {\n    expect(deriveAgentState('Disconnected', false, true)).toBe('idle');\n  });\n  it('returns connecting for connecting-like statuses', () => {\n    expect(deriveAgentState('Reconnecting', false, true)).toBe('connecting');\n  });\n  it('returns speaking when remoteAudioReady is true', () => {\n    expect(deriveAgentState('anything', true, true)).toBe('speaking');\n  });\n  it('returns thinking for waiting-for-bot status', () => {\n    expect(deriveAgentState('Waiting for bot', false, true)).toBe('thinking');\n  });\n  it('defaults to listening otherwise', () => {\n    expect(deriveAgentState('normal', false, true)).toBe('listening');\n  });\n});\n```\n\n### 5. `src/utils/cache.ts` — untested, silently swallows `localStorage` errors (quota exceeded, disabled storage) — no test proves the try/catch actually protects callers\n\n```ts\n// src/utils/cache.test.ts\nimport { describe, it, expect, vi, beforeEach } from 'vitest';\nimport { cacheSet, cacheGet, CACHE_PREFIX } from './cache';\n\ndescribe('cacheSet/cacheGet', () => {\n  beforeEach(() => window.localStorage.clear());\n\n  it('round-trips a value', () => {\n    cacheSet('key', { a: 1 });\n    expect(cacheGet('key', null)).toEqual({ a: 1 });\n  });\n  it('returns fallback when key is missing', () => {\n    expect(cacheGet('missing', 'fallback')).toBe('fallback');\n  });\n  it('returns fallback and does not throw when localStorage.getItem throws', () => {\n    const spy = vi.spyOn(window.localStorage, 'getItem').mockImplementation(() => { throw new Error('quota'); });\n    expect(cacheGet('key', 'fallback')).toBe('fallback');\n    spy.mockRestore();\n  });\n  it('does not throw when localStorage.setItem throws (quota exceeded)', () => {\n    const spy = vi.spyOn(window.localStorage, 'setItem').mockImplementation(() => { throw new Error('quota'); });\n    expect(() => cacheSet('key', 'value')).not.toThrow();\n    spy.mockRestore();\n  });\n  it('prefixes keys with CACHE_PREFIX', () => {\n    cacheSet('foo', 'bar');\n    expect(window.localStorage.getItem(`${CACHE_PREFIX}foo`)).toBe('\"bar\"');\n  });\n});\n```\n\n### 6. `src/api.ts` — fully untested; this is the highest-risk gap (auth token lifecycle, 401 handling, error propagation)\n\n```ts\n// src/api.test.ts\nimport { describe, it, expect, vi, beforeEach, afterEach } from 'vitest';\nimport { getToken, setToken, clearToken, apiUrl, ApiError, API_BASE } from './api';\n\ndescribe('token storage', () => {\n  beforeEach(() => window.localStorage.clear());\n  it('returns empty string when no token set', () => {\n    expect(getToken()).toBe('');\n  });\n  it('round-trips set/get/clear', () => {\n    setToken('abc');\n    expect(getToken()).toBe('abc');\n    clearToken();\n    expect(getToken()).toBe('');\n  });\n});\n\ndescribe('apiUrl', () => {\n  it('passes through absolute http(s) URLs unchanged', () => {\n    expect(apiUrl('http://other.host/x')).toBe('http://other.host/x');\n  });\n  it('prefixes relative paths with API_BASE, normalizing leading slash', () => {\n    expect(apiUrl('/bots')).toBe(`${API_BASE}/bots`);\n    expect(apiUrl('bots')).toBe(`${API_BASE}/bots`);\n  });\n});\n\ndescribe('request() via a public method, e.g. listing bots', () => {\n  // Assumes an exported wrapper like listBots() calls request() internally;\n  // adjust the import to whatever public function exercises request().\n  beforeEach(() => {\n    vi.stubGlobal('fetch', vi.fn());\n    window.localStorage.clear();\n  });\n  afterEach(() => vi.unstubAllGlobals());\n\n  it('attaches Authorization header when a token is present', async () => {\n    setToken('tok123');\n    (fetch as any).mockResolvedValue(new Response('{}', { status: 200, headers: { 'Content-Type': 'application/json' } }));\n    // await listBots();\n    const headers = (fetch as any).mock.calls[0][1].headers;\n    expect(headers.Authorization).toBe('Bearer tok123');\n  });\n\n  it('clears the token on a 401 response', async () => {\n    setToken('tok123');\n    (fetch as any).mockResolvedValue(new Response('', { status: 401 }));\n    // await listBots().catch(() => {});\n    expect(getToken()).toBe('');\n  });\n\n  it('throws ApiError with status and body text on non-ok response', async () => {\n    (fetch as any).mockResolvedValue(new Response('bad request detail', { status: 400 }));\n    // await expect(listBots()).rejects.toBeInstanceOf(ApiError);\n    // await expect(listBots()).rejects.toMatchObject({ status: 400, message: 'bad request detail' });\n  });\n\n  it('returns undefined for a 204 response instead of parsing JSON', async () => {\n    (fetch as any).mockResolvedValue(new Response(null, { status: 204 }));\n    // expect(await deleteBot('id')).toBeUndefined();\n  });\n});\n```\n*Note: the `request()` and `ApiError` tests need a concrete exported function (e.g. `listBots`, `getBot`) to call, since `request` itself isn't exported — swap in the actual public API surface from the untruncated `api.ts`.*\n\n### 7. Hooks — `useCountUp`, `useKeyboardShortcuts`, `useToasts` all untested\n\n```ts\n// src/hooks/useToasts.test.ts\nimport { describe, it, expect, vi } from 'vitest';\nimport { renderHook, act } from '@testing-library/react';\nimport { useToasts } from './useToasts';\n\ndescribe('useToasts', () => {\n  it('adds a toast with default tone and duration', () => {\n    const { result } = renderHook(() => useToasts());\n    act(() => { result.current.showToast('hi'); });\n    expect(result.current.toasts).toEqual([{ id: 'toast-1', message: 'hi', tone: 'success' }]);\n  });\n  it('auto-dismisses after the given duration', () => {\n    vi.useFakeTimers();\n    const { result } = renderHook(() => useToasts());\n    act(() => { result.current.showToast('hi', 'info', 1000); });\n    act(() => { vi.advanceTimersByTime(1000); });\n    expect(result.current.toasts).toHaveLength(0);\n    vi.useRealTimers();\n  });\n  it('does not auto-dismiss when durationMs is 0', () => {\n    vi.useFakeTimers();\n    const { result } = renderHook(() => useToasts());\n    act(() => { result.current.showToast('hi', 'info', 0); });\n    act(() => { vi.advanceTimersByTime(10_000); });\n    expect(result.current.toasts).toHaveLength(1);\n    vi.useRealTimers();\n  });\n  it('dismissToast removes only the matching toast', () => {\n    const { result } = renderHook(() => useToasts());\n    act(() => {\n      result.current.showToast('a');\n      result.current.showToast('b');\n    });\n    const idToRemove = result.current.toasts[0].id;\n    act(() => result.current.dismissToast(idToRemove));\n    expect(result.current.toasts.map((t) => t.message)).toEqual(['b']);\n  });\n});\n```\n\n```ts\n// src/hooks/useKeyboardShortcuts.test.ts\nimport { describe, it, expect, vi } from 'vitest';\nimport { renderHook } from '@testing-library/react';\nimport { useKeyboardShortcuts } from './useKeyboardShortcuts';\n\nfunction fireKey(key: string, opts: Partial<KeyboardEventInit> = {}, target: EventTarget = window) {\n  const event = new KeyboardEvent('keydown', { key, bubbles: true, ...opts });\n  Object.defineProperty(event, 'target', { value: target });\n  window.dispatchEvent(event);\n}\n\ndescribe('useKeyboardShortcuts', () => {\n  it('calls closeModal on Escape', () => {\n    const navigate = vi.fn(), toggle = vi.fn(), close = vi.fn();\n    renderHook(() => useKeyboardShortcuts(navigate, toggle, close));\n    fireKey('Escape');\n    expect(close).toHaveBeenCalled();\n  });\n  it('calls toggleShortcuts on \"?\"', () => {\n    const navigate = vi.fn(), toggle = vi.fn(), close = vi.fn();\n    renderHook(() => useKeyboardShortcuts(navigate, toggle, close));\n    fireKey('?');\n    expect(toggle).toHaveBeenCalled();\n  });\n  it('ignores shortcuts when target is an input/textarea/select', () => {\n    const navigate = vi.fn(), toggle = vi.fn(), close = vi.fn();\n    renderHook(() => useKeyboardShortcuts(navigate, toggle, close));\n    const input = document.createElement('input');\n    fireKey('?', {}, input);\n    expect(toggle).not.toHaveBeenCalled();\n  });\n  it('ignores key combos with modifier keys held', () => {\n    const navigate = vi.fn(), toggle = vi.fn(), close = vi.fn();\n    renderHook(() => useKeyboardShortcuts(navigate, toggle, close));\n    fireKey('b', { metaKey: true });\n    expect(navigate).not.toHaveBeenCalled();\n  });\n  it('navigates via SHORTCUT_MAP for a mapped key', () => {\n    const navigate = vi.fn(), toggle = vi.fn(), close = vi.fn();\n    renderHook(() => useKeyboardShortcuts(navigate, toggle, close));\n    fireKey('b'); // adjust to an actual key in SHORTCUT_MAP\n    // expect(navigate).toHaveBeenCalledWith(expectedView);\n  });\n  it('always uses the latest callback after a re-render (ref pattern)', () => {\n    const closeA = vi.fn(), closeB = vi.fn();\n    const { rerender } = renderHook(({ close }) => useKeyboardShortcuts(vi.fn(), vi.fn(), close), { initialProps: { close: closeA } });\n    rerender({ close: closeB });\n    fireKey('Escape');\n    expect(closeB).toHaveBeenCalled();\n    expect(closeA).not.toHaveBeenCalled();\n  });\n});\n```\n\n```ts\n// src/hooks/useCountUp.test.ts\nimport { describe, it, expect, vi } from 'vitest';\nimport { renderHook } from '@testing-library/react';\nimport { useCountUp } from './useCountUp';\n\ndescribe('useCountUp', () => {\n  it('stays at 0 when target is 0', () => {\n    const { result } = renderHook(() => useCountUp(0));\n    expect(result.current.value).toBe(0);\n  });\n  it('resets to 0 when target changes to 0 mid-animation', () => {\n    const { result, rerender } = renderHook(({ t }) => useCountUp(t), { initialProps: { t: 100 } });\n    rerender({ t: 0 });\n    expect(result.current.value).toBe(0);\n  });\n  // Full animation-frame progression is brittle to unit test without a rAF\n  // polyfill; cover it at the integration level (e.g. a component snapshot\n  // after `vi.advanceTimersByTime` with a mocked requestAnimationFrame).\n});\n```\n\n## Integration test gaps (beyond unit coverage)\n- **`api.ts` 401 flow end-to-end**: no test verifies a view (e.g. `BotsView`) actually redirects to login / shows an auth error when `request()` clears the token — only unit-level coverage of `clearToken` exists elsewhere.\n- **`constants/outcomes.ts` / `constants/dialing.ts`**: static data, no assertions that `DEFAULT_OUTCOME_RULES` outcomes all exist as keys in `OUTCOME_CATEGORIES` (would catch silent drift when someone adds an outcome to one but not the other) — worth a cheap consistency test:\n```ts\n// src/constants/outcomes.test.ts\nimport { DEFAULT_OUTCOME_RULES, OUTCOME_CATEGORIES } from './outcomes';\nit('every default outcome rule has a matching category entry', () => {\n  DEFAULT_OUTCOME_RULES.forEach((rule) => {\n    expect(OUTCOME_CATEGORIES[rule.outcome]).toBeDefined();\n  });\n});\n```\n- **Transcript source-of-truth fallback chain** (`transcript || live_transcript`) is only exercised in isolation above; no test drives it through `TranscriptsView` with a mocked API response missing `transcript` but present `live_transcript`.\n\nWant me to actually create these test files and wire them into the suite, starting with `api.ts` and `errors.ts` since those carry the most risk?\n",

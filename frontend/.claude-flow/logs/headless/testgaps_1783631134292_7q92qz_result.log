        "code": "// src/utils/errors.test.ts\nimport { describe, it, expect } from 'vitest';\nimport { friendlyApiError, friendlyTestError, summarizeDetails, average, buildDiagnostic } from './errors';\n\ndescribe('friendlyApiError', () => {\n  it('classifies \"network timeout\" for api context', () => {\n    expect(friendlyApiError(new Error('network timeout'))).toContain('backend may be slow');\n  });\n  it('classifies \"failed to fetch\"', () => {\n    expect(friendlyApiError(new Error('Failed to fetch'))).toContain('start_api.sh');\n  });\n  it('passes through unrecognized errors', () => {\n    expect(friendlyApiError(new Error('boom'))).toBe('boom');\n  });\n  it('stringifies non-Error values', () => {\n    expect(friendlyApiError('plain string')).toBe('plain string');\n  });\n});\n\ndescribe('friendlyTestError', () => {\n  it('flags missing LiveKit config', () => {\n    expect(friendlyTestError(new Error('LiveKit is not configured'))).toContain('LIVEKIT_URL');\n  });\n  it('flags room creation failure', () => {\n    expect(friendlyTestError(new Error('Could not create LiveKit test room'))).toContain('LiveKit server');\n  });\n  it('flags microphone permission errors case-insensitively', () => {\n    expect(friendlyTestError(new Error('Permission denied for microphone'))).toContain('microphone permission');\n  });\n  it('flags websocket/network errors', () => {\n    expect(friendlyTestError(new Error('WebSocket connection failed'))).toContain('ws/wss');\n  });\n  it('falls back to a generic message for unrecognized errors', () => {\n    expect(friendlyTestError(new Error(''))).toBe('Unknown test call error. Check backend logs and LiveKit server status.');\n  });\n});\n\ndescribe('summarizeDetails', () => {\n  it('joins up to 4 entries and stringifies objects', () => {\n    const result = summarizeDetails({ a: 1, b: { x: 1 }, c: 'y', d: 2, e: 3 });\n    expect(result.split(' | ')).toHaveLength(4);\n    expect(result).toContain('b: {\"x\":1}');\n  });\n  it('returns empty string for empty object', () => {\n    expect(summarizeDetails({})).toBe('');\n  });\n});\n\ndescribe('average', () => {\n  it('returns 0 for empty array', () => {\n    expect(average([])).toBe(0);\n  });\n  it('rounds the mean', () => {\n    expect(average([1, 2])).toBe(2); // rounds 1.5 -> 2\n  });\n});\n\ndescribe('buildDiagnostic', () => {\n  it('truncates messages over 220 chars with ellipsis', () => {\n    const long = 'x'.repeat(300);\n    const d = buildDiagnostic('scope', new Error(long));\n    expect(d.message.endsWith('...')).toBe(true);\n    expect(d.message.length).toBe(223);\n  });\n  it('defaults severity to error', () => {\n    const d = buildDiagnostic('scope', new Error('e'));\n    expect(d.severity).toBe('error');\n  });\n});"

        "content": "**Gaps:** token storage round-trip, `apiUrl` path-joining edge cases, `request()`'s 401 auto-clear, non-2xx → `ApiError`, 204 no-content, malformed JSON body.\n\n```ts\n// src/api.test.ts\nimport { describe, it, expect, vi, beforeEach } from 'vitest';\nimport { getToken, setToken, clearToken, apiUrl, ApiError } from './api';\n\ndescribe('token storage', () => {\n  beforeEach(() => localStorage.clear());\n  it('returns empty string when no token stored', () => {\n    expect(getToken()).toBe('');\n  });\n  it('round-trips a token', () => {\n    setToken('abc123');\n    expect(getToken()).toBe('abc123');\n    clearToken();\n    expect(getToken()).toBe('');\n  });\n});\n\ndescribe('apiUrl', () => {\n  it('passes through absolute http(s) URLs unchanged', () => {\n    expect(apiUrl('https://other.host/x')).toBe('https://other.host/x');\n  });\n  it('prefixes relative paths with API_BASE, normalizing missing leading slash', () => {\n    expect(apiUrl('bots')).toMatch(/\\/bots$/);\n    expect(apiUrl('/bots')).toMatch(/\\/bots$/);\n  });\n});\n\ndescribe('ApiError', () => {\n  it('carries status and message', () => {\n    const err = new ApiError(404, 'not found');\n    expect(err.status).toBe(404);\n    expect(err.message).toBe('not found');\n  });\n});\n```\n\n`request()` itself needs a `fetch` mock — this is the highest-value gap since every view depends on it:\n\n```ts\n// src/api.request.test.ts\nimport { describe, it, expect, vi, beforeEach } from 'vitest';\nimport * as api from './api';\n\ndescribe('request (via a public wrapper or exported helper)', () => {\n  beforeEach(() => {\n    localStorage.clear();\n    vi.restoreAllMocks();\n  });\n\n  it('attaches Authorization header when a token is present', async () => {\n    api.setToken('tok');\n    const fetchSpy = vi.spyOn(global, 'fetch').mockResolvedValue(\n      new Response(JSON.stringify({ ok: true }), { status: 200 })\n    );\n    // call whatever public function wraps request(), e.g. api.getBots()\n    await api.getBots?.();\n    const headers = fetchSpy.mock.calls[0][1]?.headers as Record<string, string>;\n    expect(headers.Authorization).toBe('Bearer tok');\n  });\n\n  it('clears the stored token on a 401 response', async () => {\n    api.setToken('stale');\n    vi.spyOn(global, 'fetch').mockResolvedValue(new Response('', { status: 401 }));\n    await expect(api.getBots?.()).rejects.toThrow();\n    expect(api.getToken()).toBe('');\n  });\n\n  it('throws ApiError with response body text on non-ok status', async () => {\n    vi.spyOn(global, 'fetch').mockResolvedValue(new Response('bad request', { status: 400 }));\n    await expect(api.getBots?.()).rejects.toMatchObject({ status: 400, message: 'bad request' });\n  });\n\n  it('returns undefined for 204 responses without parsing JSON', async () => {\n    vi.spyOn(global, 'fetch').mockResolvedValue(new Response(null, { status: 204 }));\n    await expect(api.getBots?.()).resolves.toBeUndefined();\n  });\n});\n```\n*(Note: `request` isn't exported — either export it for direct testing or test through a public API function; the file as shown has none, so this needs a small export tweak or the fuller api.ts file to target real functions.)*\n\n",
        "level": 3
      },
      {
        "title": "2. `src/utils/config.ts` — untested",
        "content": "**Gaps:** invalid JSON in `parseConfig`, every branch of `deriveAgentState`'s string-matching priority order (untested edge case: `hasRoom=false` should win over all status strings; `remoteAudioReady` overriding a non-matching status string).\n\n```ts\n// src/utils/config.test.ts\nimport { describe, it, expect } from 'vitest';\nimport { parseConfig, deriveAgentState } from './config';\n\ndescribe('parseConfig', () => {\n  it('parses valid JSON', () => {\n    const result = parseConfig('{\"a\":1}');\n    expect(result).toEqual({ ok: true, value: { a: 1 } });\n  });\n  it('returns an error result for malformed JSON', () => {\n    const result = parseConfig('{not json');\n    expect(result.ok).toBe(false);\n  });\n  it('returns an error result for empty string', () => {\n    expect(parseConfig('').ok).toBe(false);\n  });\n});\n\ndescribe('deriveAgentState', () => {\n  it('returns idle when hasRoom is false regardless of status', () => {\n    expect(deriveAgentState('speaking', true, false)).toBe('idle');\n  });\n  it('returns idle for explicit idle/disconnected status', () => {\n    expect(deriveAgentState('idle', false, true)).toBe('idle');\n    expect(deriveAgentState('Disconnected', false, true)).toBe('idle');\n  });\n  it('returns connecting for creating/connecting/requesting/reconnecting substrings', () => {\n    expect(deriveAgentState('Reconnecting to room', false, true)).toBe('connecting');\n  });\n  it('returns speaking when remoteAudioReady is true even if status is unrelated', () => {\n    expect(deriveAgentState('some other status', true, true)).toBe('speaking');\n  });\n  it('returns thinking for waiting-for-bot/participant-joined status', () => {\n    expect(deriveAgentState('participant joined', false, true)).toBe('thinking');\n  });\n  it('falls back to listening for unrecognized status', () => {\n    expect(deriveAgentState('nonsense-status', false, true)).toBe('listening');\n  });\n});\n```\n\n",
        "level": 3
      },
      {
        "title": "3. `src/utils/errors.ts` — untested",
        "content": "**Gaps:** each branch of `classifyNetworkError` (both `context` values), non-Error thrown values, `summarizeDetails` truncation past 4 keys and object-value stringification, `average` empty-array and rounding, `buildDiagnostic` message truncation at 220 chars.\n\n```ts\n// src/utils/errors.test.ts\nimport { describe, it, expect } from 'vitest';\nimport { friendlyApiError, friendlyTestError, summarizeDetails, average, buildDiagnostic } from './errors';\n\ndescribe('friendlyApiError', () => {\n  it('adds guidance for \"failed to fetch\"', () => {\n    expect(friendlyApiError(new Error('Failed to fetch'))).toContain('Cannot reach the FastAPI backend');\n  });\n  it('adds guidance for network timeout', () => {\n    expect(friendlyApiError(new Error('Network timeout'))).toContain('Mongo/LiveKit');\n  });\n  it('passes through unrelated errors unchanged', () => {\n    expect(friendlyApiError(new Error('weird error'))).toBe('weird error');\n  });\n  it('stringifies non-Error thrown values', () => {\n    expect(friendlyApiError('plain string')).toBe('plain string');\n  });\n});\n\ndescribe('friendlyTestError', () => {\n  it('gives test-specific network timeout guidance', () => {\n    expect(friendlyTestError(new Error('Network timeout'))).toContain('backend logs');\n  });\n  it('flags LiveKit not configured', () => {\n    expect(friendlyTestError(new Error('LiveKit is not configured'))).toContain('LIVEKIT_URL');\n  });\n  it('flags LiveKit room creation failure', () => {\n    expect(friendlyTestError(new Error('Could not create LiveKit test room'))).toContain('LiveKit server');\n  });\n  it('flags microphone permission errors', () => {\n    expect(friendlyTestError(new Error('Permission denied for microphone'))).toContain('microphone');\n  });\n  it('flags websocket/network errors', () => {\n    expect(friendlyTestError(new Error('websocket closed'))).toContain('ws/wss');\n  });\n  it('falls back to generic message for unknown errors', () => {\n    expect(friendlyTestError(new Error(''))).toBe('Unknown test call error. Check backend logs and LiveKit server status.');\n  });\n});\n\ndescribe('summarizeDetails', () => {\n  it('joins up to 4 entries with key: value', () => {\n    expect(summarizeDetails({ a: 1, b: 'x' })).toBe('a: 1 | b: x');\n  });\n  it('truncates beyond 4 keys', () => {\n    const details = { a: 1, b: 2, c: 3, d: 4, e: 5 };\n    expect(summarizeDetails(details).split(' | ')).toHaveLength(4);\n  });\n  it('JSON-stringifies object values', () => {\n    expect(summarizeDetails({ obj: { x: 1 } })).toBe('obj: {\"x\":1}');\n  });\n});\n\ndescribe('average', () => {\n  it('returns 0 for empty array', () => {\n    expect(average([])).toBe(0);\n  });\n  it('rounds to nearest integer', () => {\n    expect(average([1, 2])).toBe(2); // 1.5 rounds to 2\n    expect(average([1, 2, 4])).toBe(2); // 2.33 -> 2\n  });\n});\n\ndescribe('buildDiagnostic', () => {\n  it('truncates messages longer than 220 chars with ellipsis', () => {\n    const longMsg = 'x'.repeat(300);\n    const diag = buildDiagnostic('scope', new Error(longMsg));\n    expect(diag.message.endsWith('...')).toBe(true);\n    expect(diag.message.length).toBe(223);\n  });\n  it('defaults severity to error and sets scope/action/createdAt', () => {\n    const diag = buildDiagnostic('scope', new Error('e'), 'retry');\n    expect(diag.severity).toBe('error');\n    expect(diag.action).toBe('retry');\n    expect(diag.scope).toBe('scope');\n    expect(diag.id).toContain('scope-');\n  });\n});\n```\n\n",
        "level": 3
      },
      {
        "title": "4. `src/utils/transcript.ts` — untested, most logic-dense file shown",
        "content": "**Gaps:** `verified_transcript` preferred only when status is `succeeded` AND non-empty; fallback chain `transcript → live_transcript → []`; event ordering when turns lack timestamps vs when they have them; `interrupted` detection via flag vs `event_type` substring; unknown role → `'system'`; malformed/missing `created_at` sorts to `MAX_SAFE_INTEGER`.\n\n```ts\n// src/utils/transcript.test.ts\nimport { describe, it, expect } from 'vitest';\nimport {\n  buildConversationItems, normalizeTranscriptRole, timestampValue,\n  transcriptSourceLabel, maxResponseDelayLabel\n} from './transcript';\nimport type { Transcript, CallEvent } from '../api';\n\ndescribe('buildConversationItems', () => {\n  it('returns empty array when transcript is undefined', () => {\n    expect(buildConversationItems(undefined, [])).toEqual([]);\n  });\n\n  it('prefers verified_transcript only when status succeeded and non-empty', () => {\n    const t = {\n      _id: '1', created_at: '2024-01-01T00:00:00Z',\n      verified_transcript_status: 'succeeded',\n      verified_transcript: [{ role: 'user', text: 'verified' }],\n      transcript: [{ role: 'user', text: 'raw' }],\n    } as Transcript;\n    const items = buildConversationItems(t, []);\n    expect(items.some((i) => i.kind === 'turn' && i.text === 'verified')).toBe(true);\n  });\n\n  it('falls back to transcript then live_transcript when verified is empty/pending', () => {\n    const t = {\n      _id: '1', created_at: '2024-01-01T00:00:00Z',\n      verified_transcript_status: 'pending',\n      transcript: [],\n      live_transcript: [{ role: 'user', text: 'live' }],\n    } as Transcript;\n    const items = buildConversationItems(t, []);\n    expect(items.some((i) => i.kind === 'turn' && i.text === 'live')).toBe(true);\n  });\n\n  it('marks a turn interrupted via explicit flag or event_type substring', () => {\n    const t = {\n      _id: '1', created_at: '2024-01-01T00:00:00Z',\n      transcript: [\n        { role: 'user', text: 'a', interrupted: true },\n        { role: 'user', text: 'b', event_type: 'user_interruption' },\n        { role: 'user', text: 'c' },\n      ],\n    } as Transcript;\n    const items = buildConversationItems(t, []).filter((i) => i.kind === 'turn') as any[];\n    expect(items[0].interrupted).toBe(true);\n    expect(items[1].interrupted).toBe(true);\n    expect(items[2].interrupted).toBe(false);\n  });\n\n  it('sorts by timestamp when turns have created_at, else buckets events around turns', () => {\n    const t = {\n      _id: '1', created_at: '2024-01-01T00:00:00Z',\n      transcript: [{ role: 'user', text: 'no-ts' }],\n    } as Transcript;\n    const events = [\n      { _id: 'e1', event_type: 'call_started', created_at: '2024-01-01T00:00:00Z' } as CallEvent,\n      { _id: 'e2', event_type: 'call_ended', created_at: '2024-01-01T00:01:00Z' } as CallEvent,\n    ];\n    const items = buildConversationItems(t, events);\n    expect(items[0].kind).toBe('event');\n    expect(items[items.length - 1].kind).toBe('event');\n  });\n});\n\ndescribe('normalizeTranscriptRole', () => {\n  it('maps known assistant/user/recording aliases', () => {\n    expect(normalizeTranscriptRole('agent')).toBe('assistant');\n    expect(normalizeTranscriptRole('caller')).toBe('user');\n    expect(normalizeTranscriptRole('verified_recording')).toBe('recording');\n  });\n  it('falls back to system for unknown/empty role', () => {\n    expect(normalizeTranscriptRole('')).toBe('system');\n    expect(normalizeTranscriptRole('weird')).toBe('system');\n  });\n});\n\ndescribe('timestampValue', () => {\n  it('returns MAX_SAFE_INTEGER for missing or unparsable dates', () => {\n    expect(timestampValue(undefined)).toBe(Number.MAX_SAFE_INTEGER);\n    expect(timestampValue('not-a-date')).toBe(Number.MAX_SAFE_INTEGER);\n  });\n});\n\ndescribe('transcriptSourceLabel', () => {\n  it('covers each verified_transcript_status branch', () => {\n    const base = { _id: '1', created_at: 'x' } as Transcript;\n    expect(transcriptSourceLabel({ ...base, verified_transcript_status: 'succeeded' })).toBe('Verified recording');\n    expect(transcriptSourceLabel({ ...base, verified_transcript_status: 'pending' })).toContain('pending');\n    expect(transcriptSourceLabel({ ...base, verified_transcript_status: 'failed' })).toContain('failed');\n    expect(transcriptSourceLabel({ ...base, verified_transcript_status: 'unavailable' })).toContain('unavailable');\n    expect(transcriptSourceLabel(base)).toBe('Gemini Live');\n  });\n});\n\ndescribe('maxResponseDelayLabel', () => {\n  it('returns \"-\" when no latency metrics', () => {\n    expect(maxResponseDelayLabel({ _id: '1', created_at: 'x' } as Transcript)).toBe('-');\n  });\n  it('flags high (>=8000ms) and slow (>=3000ms) delays', () => {\n    const high = { _id: '1', created_at: 'x', latency_metrics: { max_response_delay_ms: 9000 } } as Transcript;\n    const slow = { _id: '1', created_at: 'x', latency_metrics: { max_response_delay_ms: 3500 } } as Transcript;\n    expect(maxResponseDelayLabel(high)).toContain('high');\n    expect(maxResponseDelayLabel(slow)).toContain('slow');\n  });\n});\n```\n\n",
        "level": 3
      },
      {
        "title": "5. `src/utils/formatting.ts` — untested",
        "content": "**Gaps:** `shortId` boundary at exactly 12 chars, date strings without timezone suffix getting `Z` appended, invalid date fallback to raw string, `timeAgo` boundaries (60s/3600s/86400s/172800s).\n\n```ts\n// src/utils/formatting.test.ts\nimport { describe, it, expect, vi } from 'vitest';\nimport { shortId, parseApiDate, formatDate, titleCase, timeAgo } from './formatting';\n\ndescribe('shortId', () => {\n  it('returns \"-\" for empty string', () => expect(shortId('')).toBe('-'));\n  it('leaves 12-char ids untouched (boundary)', () => {\n    const id = '123456789012';\n    expect(shortId(id)).toBe(id);\n  });\n  it('truncates ids longer than 12 chars', () => {\n    expect(shortId('1234567890123')).toBe('12345678...0123');\n  });\n});\n\ndescribe('parseApiDate', () => {\n  it('appends Z when no timezone suffix present', () => {\n    const d = parseApiDate('2024-01-01T00:00:00');\n    expect(d.toISOString()).toBe('2024-01-01T00:00:00.000Z');\n  });\n  it('leaves timezone-qualified strings unchanged', () => {\n    const d = parseApiDate('2024-01-01T00:00:00+05:30');\n    expect(Number.isNaN(d.getTime())).toBe(false);\n  });\n});\n\ndescribe('formatDate / titleCase / timeAgo', () => {\n  it('returns raw value for unparsable date', () => {\n    expect(formatDate('garbage')).toBe('garbage');\n  });\n  it('returns \"-\" for undefined', () => {\n    expect(formatDate(undefined)).toBe('-');\n    expect(titleCase(undefined)).toBe('-');\n  });\n  it('titleCases snake/kebab/space-separated strings', () => {\n    expect(titleCase('call_started')).toBe('Call Started');\n    expect(titleCase('some-value here')).toBe('Some Value Here');\n  });\n\n  it('buckets timeAgo across boundaries', () => {\n    vi.useFakeTimers();\n    vi.setSystemTime(new Date('2024-01-02T00:00:00Z'));\n    expect(timeAgo(new Date(Date.now() - 30_000).toISOString())).toBe('just now');\n    expect(timeAgo(new Date(Date.now() - 5 * 60_000).toISOString())).toBe('5 min ago');\n    expect(timeAgo(new Date(Date.now() - 2 * 3600_000).toISOString())).toBe('2 hr ago');\n    expect(timeAgo(new Date(Date.now() - 90_000_000).toISOString())).toBe('yesterday');\n    expect(timeAgo(new Date(Date.now() - 3 * 86_400_000).toISOString())).not.toBe('yesterday');\n    vi.useRealTimers();\n  });\n});\n```\n\n",
        "level": 3
      },
      {
        "title": "6. Hooks — untested, and two have known leak bugs per prior session notes",
        "content": "**`useCountUp`** — RAF loop isn't cancelled on unmount (confirmed leak). **`useToasts`** — `setTimeout` isn't cleared on unmount or early `dismissToast`. Tests should codify the *current* behavior first, then the fix.\n\n```ts\n// src/hooks/useCountUp.test.ts\nimport { describe, it, expect, vi } from 'vitest';\nimport { renderHook, act } from '@testing-library/react';\nimport { useCountUp } from './useCountUp';\n\ndescribe('useCountUp', () => {\n  it('counts from 0 to target', async () => {\n    const { result } = renderHook(() => useCountUp(100, 50));\n    await act(async () => new Promise((r) => setTimeout(r, 100)));\n    expect(result.current.value).toBe(100);\n  });\n\n  it('resets to 0 immediately when target is 0', () => {\n    const { result } = renderHook(() => useCountUp(0));\n    expect(result.current.value).toBe(0);\n  });\n\n  it('does not call setState after unmount (regression test for RAF leak)', async () => {\n    const { unmount } = renderHook(() => useCountUp(1000, 500));\n    const rafSpy = vi.spyOn(window, 'requestAnimationFrame');\n    unmount();\n    // Whatever frame was pending should not fire a state update on an unmounted component.\n    // With current code this will log an act()/unmounted-state warning — asserting no warning\n    // is the regression check once the cleanup fix lands.\n    expect(rafSpy).toBeDefined();\n  });\n});\n```\n\n```ts\n// src/hooks/useToasts.test.ts\nimport { describe, it, expect, vi } from 'vitest';\nimport { renderHook, act } from '@testing-library/react';\nimport { useToasts } from './useToasts';\n\ndescribe('useToasts', () => {\n  it('adds a toast and auto-dismisses after duration', () => {\n    vi.useFakeTimers();\n    const { result } = renderHook(() => useToasts());\n    act(() => { result.current.showToast('hi'); });\n    expect(result.current.toasts).toHaveLength(1);\n    act(() => { vi.advanceTimersByTime(4000); });\n    expect(result.current.toasts).toHaveLength(0);\n    vi.useRealTimers();\n  });\n\n  it('does not auto-dismiss when durationMs is 0', () => {\n    vi.useFakeTimers();\n    const { result } = renderHook(() => useToasts());\n    act(() => { result.current.showToast('sticky', 'info', 0); });\n    act(() => { vi.advanceTimersByTime(10_000); });\n    expect(result.current.toasts).toHaveLength(1);\n    vi.useRealTimers();\n  });\n\n  it('dismissToast removes only the targeted toast', () => {\n    const { result } = renderHook(() => useToasts());\n    let id1 = '';\n    act(() => { id1 = result.current.showToast('a', 'success', 0); result.current.showToast('b', 'success', 0); });\n    act(() => { result.current.dismissToast(id1); });\n    expect(result.current.toasts).toHaveLength(1);\n    expect(result.current.toasts[0].message).toBe('b');\n  });\n\n  it('clears pending timers on unmount (regression test for timer leak)', () => {\n    vi.useFakeTimers();\n    const { result, unmount } = renderHook(() => useToasts());\n    act(() => { result.current.showToast('leak-check'); });\n    unmount();\n    expect(() => vi.advanceTimersByTime(5000)).not.toThrow();\n    vi.useRealTimers();\n  });\n});\n```\n\n```ts\n// src/hooks/useKeyboardShortcuts.test.ts\nimport { describe, it, expect, vi } from 'vitest';\nimport { renderHook } from '@testing-library/react';\nimport { useKeyboardShortcuts } from './useKeyboardShortcuts';\n\ndescribe('useKeyboardShortcuts', () => {\n  it('ignores keystrokes while focused in an input/textarea/select', () => {\n    const navigate = vi.fn();\n    renderHook(() => useKeyboardShortcuts(navigate, vi.fn(), vi.fn()));\n    const input = document.createElement('input');\n    document.body.appendChild(input);\n    input.dispatchEvent(new KeyboardEvent('keydown', { key: 'b', bubbles: true }));\n    expect(navigate).not.toHaveBeenCalled();\n    input.remove();\n  });\n\n  it('calls closeModal on Escape and toggle on \"?\"', () => {\n    const close = vi.fn();\n    const toggle = vi.fn();\n    renderHook(() => useKeyboardShortcuts(vi.fn(), toggle, close));\n    window.dispatchEvent(new KeyboardEvent('keydown', { key: 'Escape' }));\n    window.dispatchEvent(new KeyboardEvent('keydown', { key: '?' }));\n    expect(close).toHaveBeenCalled();\n    expect(toggle).toHaveBeenCalled();\n  });\n\n  it('ignores keystrokes combined with modifier keys', () => {\n    const navigate = vi.fn();\n    renderHook(() => useKeyboardShortcuts(navigate, vi.fn(), vi.fn()));\n    window.dispatchEvent(new KeyboardEvent('keydown', { key: 'b', metaKey: true }));\n    expect(navigate).not.toHaveBeenCalled();\n  });\n\n  it('picks up latest callback via ref without re-registering listener', () => {\n    const navigate1 = vi.fn();\n    const navigate2 = vi.fn();\n    const { rerender } = renderHook(({ nav }) => useKeyboardShortcuts(nav, vi.fn(), vi.fn()), {\n      initialProps: { nav: navigate1 },\n    });\n    rerender({ nav: navigate2 });\n    // dispatch a mapped shortcut key from SHORTCUT_MAP, e.g. 'b' if mapped\n    window.dispatchEvent(new KeyboardEvent('keydown', { key: 'b' }));\n    expect(navigate1).not.toHaveBeenCalled();\n  });\n});\n```\n\n",
        "level": 3
      },
      {
        "title": "7. `src/utils/cache.ts` — untested",
        "content": "**Gaps:** `localStorage.setItem` throwing (quota exceeded) is swallowed; `cacheGet` with corrupted JSON falls back safely; `pruneOldCache` only drops keys with the old prefix, not the current one.\n\n```ts\n// src/utils/cache.test.ts\nimport { describe, it, expect, vi, beforeEach } from 'vitest';\nimport { cacheSet, cacheGet, CACHE_PREFIX } from './cache';\n\ndescribe('cacheSet/cacheGet', () => {\n  beforeEach(() => localStorage.clear());\n  it('round-trips a value', () => {\n    cacheSet('k', { a: 1 });\n    expect(cacheGet('k', null)).toEqual({ a: 1 });\n  });\n  it('returns fallback when key missing', () => {\n    expect(cacheGet('missing', 'fallback')).toBe('fallback');\n  });\n  it('returns fallback when stored value is corrupted JSON', () => {\n    localStorage.setItem(`${CACHE_PREFIX}bad`, '{not json');\n    expect(cacheGet('bad', 'fallback')).toBe('fallback');\n  });\n  it('swallows setItem errors (e.g. quota exceeded)', () => {\n    const spy = vi.spyOn(Storage.prototype, 'setItem').mockImplementation(() => { throw new Error('quota'); });\n    expect(() => cacheSet('k', 1)).not.toThrow();\n    spy.mockRestore();\n  });\n});\n```\n\n",

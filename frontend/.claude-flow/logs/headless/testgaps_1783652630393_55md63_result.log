  "output": "## Test Coverage Analysis\n\n**Tested already:** `utils/routes.ts`, `utils/validation.ts` — good coverage.\n\n**Untested (no `.test.ts` found for these):** `src/api.ts`, `utils/config.ts`, `utils/errors.ts`, `utils/formatting.ts`, `utils/transcript.ts`, `utils/cache.ts`, `hooks/useCountUp.ts`, `hooks/useKeyboardShortcuts.ts`, `hooks/useToasts.ts`.\n\n### 1. `src/api.ts` — `request()` / token handling (highest priority — auth + network core)\n\nGaps: 401 clears token, non-ok throws `ApiError` with body vs statusText fallback, 204 returns undefined, `apiUrl` for absolute vs relative paths, missing Authorization header when no token.\n\n```ts\n// src/api.test.ts\nimport { describe, it, expect, vi, beforeEach } from 'vitest';\nimport { apiUrl, getToken, setToken, clearToken, ApiError } from './api';\n\ndescribe('token storage', () => {\n  beforeEach(() => localStorage.clear());\n  it('returns empty string when no token stored', () => {\n    expect(getToken()).toBe('');\n  });\n  it('round-trips set/get/clear', () => {\n    setToken('abc');\n    expect(getToken()).toBe('abc');\n    clearToken();\n    expect(getToken()).toBe('');\n  });\n});\n\ndescribe('apiUrl', () => {\n  it('passes through absolute http(s) urls unchanged', () => {\n    expect(apiUrl('https://x.com/y')).toBe('https://x.com/y');\n  });\n  it('prefixes relative paths with API_BASE, normalizing missing leading slash', () => {\n    expect(apiUrl('bots')).toMatch(/\\/bots$/);\n    expect(apiUrl('/bots')).toMatch(/\\/bots$/);\n  });\n});\n\ndescribe('request() [via a public function that calls it, e.g. listBots]', () => {\n  beforeEach(() => { vi.restoreAllMocks(); localStorage.clear(); });\n\n  it('clears token and throws ApiError on 401', async () => {\n    setToken('stale');\n    global.fetch = vi.fn().mockResolvedValue({ status: 401, ok: false, text: async () => 'Unauthorized' });\n    await expect(/* call an exported function hitting request() */ Promise.reject()).rejects.toBeDefined();\n    expect(getToken()).toBe('');\n  });\n\n  it('throws ApiError with response body text on non-ok', async () => {\n    global.fetch = vi.fn().mockResolvedValue({ status: 500, ok: false, text: async () => 'boom' });\n    // await expect(someApiCall()).rejects.toThrow(ApiError);\n  });\n\n  it('falls back to statusText when body text is empty', async () => {\n    global.fetch = vi.fn().mockResolvedValue({ status: 500, ok: false, statusText: 'Server Error', text: async () => '' });\n  });\n\n  it('returns undefined for 204 No Content', async () => {\n    global.fetch = vi.fn().mockResolvedValue({ status: 204, ok: true });\n  });\n\n  it('omits Authorization header when no token is set', async () => {\n    const fetchMock = vi.fn().mockResolvedValue({ status: 200, ok: true, json: async () => ({}) });\n    global.fetch = fetchMock;\n    // trigger request(), then:\n    // expect(fetchMock.mock.calls[0][1].headers.Authorization).toBeUndefined();\n  });\n});\n```\n\n### 2. `utils/errors.ts` — `friendlyApiError` / `friendlyTestError` / `classifyNetworkError` / `buildDiagnostic`\n\nGaps: every branch of the message-matching chain, `average([])`, `summarizeDetails` truncation at 4 entries, `buildDiagnostic` message truncation at 220 chars.\n\n```ts\n// src/utils/errors.test.ts\nimport { describe, it, expect } from 'vitest';\nimport { friendlyApiError, friendlyTestError, summarizeDetails, average, buildDiagnostic } from './errors';\n\ndescribe('friendlyApiError', () => {\n  it('adds context for \"network timeout\"', () => {\n    expect(friendlyApiError(new Error('network timeout'))).toContain('backend may be slow');\n  });\n  it('adds context for \"failed to fetch\"', () => {\n    expect(friendlyApiError(new Error('failed to fetch'))).toContain('Cannot reach the FastAPI backend');\n  });\n  it('passes through unrecognized errors verbatim', () => {\n    expect(friendlyApiError(new Error('weird'))).toBe('weird');\n  });\n  it('handles non-Error thrown values', () => {\n    expect(friendlyApiError('plain string')).toBe('plain string');\n  });\n});\n\ndescribe('friendlyTestError', () => {\n  it('gives test-specific guidance for network timeout', () => {\n    expect(friendlyTestError(new Error('network timeout'))).toContain('too slow');\n  });\n  it('flags missing LiveKit config', () => {\n    expect(friendlyTestError(new Error('LiveKit is not configured'))).toMatch(/LIVEKIT_URL/);\n  });\n  it('flags LiveKit room creation failure', () => {\n    expect(friendlyTestError(new Error('Could not create LiveKit test room'))).toMatch(/LiveKit room/);\n  });\n  it('flags microphone permission errors', () => {\n    expect(friendlyTestError(new Error('permission denied'))).toMatch(/microphone/i);\n  });\n  it('flags websocket/network errors', () => {\n    expect(friendlyTestError(new Error('websocket closed'))).toMatch(/LIVEKIT_URL/);\n  });\n  it('falls back to generic message for unknown errors', () => {\n    expect(friendlyTestError(new Error(''))).toBe('Unknown test call error. Check backend logs and LiveKit server status.');\n  });\n});\n\ndescribe('average', () => {\n  it('returns 0 for empty array', () => {\n    expect(average([])).toBe(0);\n  });\n  it('rounds the mean', () => {\n    expect(average([1, 2])).toBe(2); // (1+2)/2=1.5 -> round\n  });\n});\n\ndescribe('summarizeDetails', () => {\n  it('caps output at 4 entries', () => {\n    const details = { a: 1, b: 2, c: 3, d: 4, e: 5 };\n    expect(summarizeDetails(details).split(' | ')).toHaveLength(4);\n  });\n  it('JSON-stringifies object values but not primitives', () => {\n    expect(summarizeDetails({ x: { y: 1 } })).toContain('{\"y\":1}');\n    expect(summarizeDetails({ x: 5 })).toBe('x: 5');\n  });\n});\n\ndescribe('buildDiagnostic', () => {\n  it('truncates messages over 220 chars with ellipsis', () => {\n    const d = buildDiagnostic('scope', new Error('a'.repeat(300)));\n    expect(d.message.endsWith('...')).toBe(true);\n    expect(d.message.length).toBe(223);\n  });\n  it('defaults severity to error', () => {\n    expect(buildDiagnostic('scope', new Error('x')).severity).toBe('error');\n  });\n});\n```\n\n### 3. `utils/transcript.ts` — `buildConversationItems` (most complex, zero coverage)\n\nGaps: verified vs live vs plain transcript selection, sort-by-timestamp path vs the no-timestamp bucketed fallback, event inlining filter, `normalizeTranscriptRole` alias mapping, `timestampValue` invalid/missing date fallback to `MAX_SAFE_INTEGER`.\n\n```ts\n// src/utils/transcript.test.ts\nimport { describe, it, expect } from 'vitest';\nimport { buildConversationItems, normalizeTranscriptRole, timestampValue, transcriptSourceLabel, maxResponseDelayLabel } from './transcript';\n\ndescribe('buildConversationItems', () => {\n  it('returns [] when transcript is undefined', () => {\n    expect(buildConversationItems(undefined, [])).toEqual([]);\n  });\n  it('prefers verified_transcript when status is succeeded and non-empty', () => {\n    const t = { verified_transcript_status: 'succeeded', verified_transcript: [{ role: 'user', text: 'hi' }], transcript: [{ role: 'user', text: 'wrong' }] } as any;\n    expect(buildConversationItems(t)[0]).toMatchObject({ text: 'hi' });\n  });\n  it('falls back to transcript, then live_transcript, when verified is unavailable', () => {\n    const t = { transcript: [], live_transcript: [{ role: 'user', text: 'live' }] } as any;\n    expect(buildConversationItems(t)[0]).toMatchObject({ text: 'live' });\n  });\n  it('sorts turns and events by timestamp when turns have created_at', () => {\n    // interleave out-of-order turn/event created_at, assert ascending sortAt\n  });\n  it('buckets events into start/middle/end when turns have no created_at', () => {\n    // assert START_EVENT_TYPES appear first, END_EVENT_TYPES appear last\n  });\n  it('only inlines events whose event_type is in INLINE_EVENT_TYPES', () => {\n    const events = [{ _id: '1', event_type: 'not_inline', created_at: 'x' }] as any;\n    expect(buildConversationItems({ transcript: [] } as any, events)).toEqual([]);\n  });\n  it('marks interrupted turns via interrupted flag or event_type substring', () => {\n    const t = { transcript: [{ role: 'user', text: 'x', event_type: 'user_interruption' }] } as any;\n    expect(buildConversationItems(t)[0]).toMatchObject({ interrupted: true });\n  });\n});\n\ndescribe('normalizeTranscriptRole', () => {\n  it.each([\n    ['agent', 'assistant'], ['bot', 'assistant'], ['model', 'assistant'],\n    ['customer', 'user'], ['caller', 'user'],\n    ['recording', 'recording'], ['verified_recording', 'recording'],\n    ['', 'system'], ['unknown_role', 'unknown_role'],\n  ])('maps %s -> %s', (input, expected) => {\n    expect(normalizeTranscriptRole(input)).toBe(expected);\n  });\n});\n\ndescribe('timestampValue', () => {\n  it('returns MAX_SAFE_INTEGER for missing value', () => {\n    expect(timestampValue(undefined)).toBe(Number.MAX_SAFE_INTEGER);\n  });\n  it('returns MAX_SAFE_INTEGER for unparseable date string', () => {\n    expect(timestampValue('not-a-date')).toBe(Number.MAX_SAFE_INTEGER);\n  });\n});\n\ndescribe('transcriptSourceLabel', () => {\n  it.each([\n    ['succeeded', 'Verified recording'],\n    ['pending', 'Live transcript, verification pending'],\n    ['failed', 'Live transcript, verification failed'],\n    ['unavailable', 'Live transcript, recording unavailable'],\n  ])('status=%s -> %s', (status, label) => {\n    expect(transcriptSourceLabel({ verified_transcript_status: status } as any)).toBe(label);\n  });\n  it('falls back to analysis_transcript_source title-cased', () => {\n    expect(transcriptSourceLabel({ analysis_transcript_source: 'gemini_live' } as any)).toBe('Gemini Live');\n  });\n});\n\ndescribe('maxResponseDelayLabel', () => {\n  it('returns \"-\" when no latency metrics', () => {\n    expect(maxResponseDelayLabel({} as any)).toBe('-');\n  });\n  it('flags >=8000ms as high, >=3000ms as slow, else plain ms', () => {\n    expect(maxResponseDelayLabel({ latency_metrics: { max_response_delay_ms: 8000 } } as any)).toBe('8000ms high');\n    expect(maxResponseDelayLabel({ latency_metrics: { max_response_delay_ms: 3000 } } as any)).toBe('3000ms slow');\n    expect(maxResponseDelayLabel({ latency_metrics: { max_response_delay_ms: 500 } } as any)).toBe('500ms');\n  });\n});\n```\n\n### 4. `utils/config.ts` — `parseConfig` / `deriveAgentState`\n\n```ts\n// src/utils/config.test.ts\nimport { describe, it, expect } from 'vitest';\nimport { parseConfig, deriveAgentState } from './config';\n\ndescribe('parseConfig', () => {\n  it('returns ok:true with parsed value for valid JSON', () => {\n    expect(parseConfig('{\"a\":1}')).toEqual({ ok: true, value: { a: 1 } });\n  });\n  it('returns ok:false with error message for invalid JSON', () => {\n    const result = parseConfig('{bad');\n    expect(result.ok).toBe(false);\n  });\n});\n\ndescribe('deriveAgentState', () => {\n  it('returns idle when hasRoom is false regardless of status', () => {\n    expect(deriveAgentState('speaking', true, false)).toBe('idle');\n  });\n  it('returns idle for disconnected status', () => {\n    expect(deriveAgentState('Disconnected', false, true)).toBe('idle');\n  });\n  it('returns connecting for creating/connecting/requesting/reconnecting', () => {\n    expect(deriveAgentState('Reconnecting...', false, true)).toBe('connecting');\n  });\n  it('returns speaking when remoteAudioReady is true even if status is neutral', () => {\n    expect(deriveAgentState('room joined', true, true)).toBe('speaking');\n  });\n  it('returns thinking for \"waiting for bot\"', () => {\n    expect(deriveAgentState('Waiting for bot', false, true)).toBe('thinking');\n  });\n  it('defaults to listening for unmatched non-idle status', () => {\n    expect(deriveAgentState('active', false, true)).toBe('listening');\n  });\n});\n```\n\n### 5. `utils/cache.ts` — localStorage error handling (silent-fail paths are untested)\n\n```ts\n// src/utils/cache.test.ts\nimport { describe, it, expect, vi, beforeEach } from 'vitest';\nimport { cacheSet, cacheGet, pruneOldCache, CACHE_PREFIX } from './cache';\n\ndescribe('cacheSet/cacheGet', () => {\n  beforeEach(() => localStorage.clear());\n  it('round-trips a value', () => {\n    cacheSet('k', { a: 1 });\n    expect(cacheGet('k', null)).toEqual({ a: 1 });\n  });\n  it('returns fallback when key is missing', () => {\n    expect(cacheGet('missing', 'fallback')).toBe('fallback');\n  });\n  it('returns fallback silently when localStorage.setItem throws (quota exceeded)', () => {\n    const spy = vi.spyOn(Storage.prototype, 'setItem').mockImplementation(() => { throw new Error('quota'); });\n    expect(() => cacheSet('k', 1)).not.toThrow();\n    spy.mockRestore();\n  });\n  it('returns fallback silently when stored JSON is corrupt', () => {\n    localStorage.setItem(`${CACHE_PREFIX}k`, '{not json');\n    expect(cacheGet('k', 'fallback')).toBe('fallback');\n  });\n});\n\ndescribe('pruneOldCache', () => {\n  it('removes keys with old jd-vb: prefix but not current CACHE_PREFIX', () => {\n    localStorage.setItem('jd-vb:v1:old', '1');\n    localStorage.setItem(`${CACHE_PREFIX}new`, '1');\n    pruneOldCache();\n    expect(localStorage.getItem('jd-vb:v1:old')).toBeNull();\n    expect(localStorage.getItem(`${CACHE_PREFIX}new`)).not.toBeNull();\n  });\n});\n```\n\n### 6. Hooks — `useKeyboardShortcuts`, `useToasts`, `useCountUp` (render-hook tests, zero coverage)\n\n```ts\n// src/hooks/useToasts.test.ts\nimport { describe, it, expect, vi } from 'vitest';\nimport { renderHook, act } from '@testing-library/react';\nimport { useToasts } from './useToasts';\n\ndescribe('useToasts', () => {\n  it('adds a toast with an incrementing id', () => {\n    const { result } = renderHook(() => useToasts());\n    act(() => { result.current.showToast('hello'); });\n    expect(result.current.toasts).toHaveLength(1);\n    expect(result.current.toasts[0].message).toBe('hello');\n  });\n  it('auto-dismisses after durationMs', () => {\n    vi.useFakeTimers();\n    const { result } = renderHook(() => useToasts());\n    act(() => { result.current.showToast('bye', 'error', 1000); });\n    act(() => { vi.advanceTimersByTime(1000); });\n    expect(result.current.toasts).toHaveLength(0);\n    vi.useRealTimers();\n  });\n  it('does not schedule dismissal when durationMs is 0', () => {\n    vi.useFakeTimers();\n    const { result } = renderHook(() => useToasts());\n    act(() => { result.current.showToast('sticky', 'info', 0); });\n    act(() => { vi.advanceTimersByTime(100000); });\n    expect(result.current.toasts).toHaveLength(1);\n    vi.useRealTimers();\n  });\n  it('dismissToast removes only the targeted toast', () => {\n    const { result } = renderHook(() => useToasts());\n    let id1 = '';\n    act(() => { id1 = result.current.showToast('a', 'info', 0); result.current.showToast('b', 'info', 0); });\n    act(() => { result.current.dismissToast(id1); });\n    expect(result.current.toasts).toHaveLength(1);\n    expect(result.current.toasts[0].message).toBe('b');\n  });\n});\n```\n\n```ts\n// src/hooks/useKeyboardShortcuts.test.ts\n// Gaps: Escape/`?` handled even with modifiers ignored; input/textarea/select/contentEditable\n// targets are ignored; unmapped keys are no-ops; refs stay current across re-renders without\n// re-registering the listener (a stale-closure regression this pattern is prone to).\nimport { describe, it, expect, vi } from 'vitest';\nimport { renderHook } from '@testing-library/react';\nimport { useKeyboardShortcuts } from './useKeyboardShortcuts';\n\nfunction fireKey(key: string, target: EventTarget = document.body, opts = {}) {\n  const event = new KeyboardEvent('keydown', { key, bubbles: true, ...opts });\n  Object.defineProperty(event, 'target', { value: target });\n  window.dispatchEvent(event);\n}\n\ndescribe('useKeyboardShortcuts', () => {\n  it('calls closeModal on Escape', () => {\n    const closeModal = vi.fn();\n    renderHook(() => useKeyboardShortcuts(vi.fn(), vi.fn(), closeModal));\n    fireKey('Escape');\n    expect(closeModal).toHaveBeenCalled();\n  });\n  it('calls toggleShortcuts on \"?\"', () => {\n    const toggle = vi.fn();\n    renderHook(() => useKeyboardShortcuts(vi.fn(), toggle, vi.fn()));\n    fireKey('?');\n    expect(toggle).toHaveBeenCalled();\n  });\n  it('ignores keystrokes when target is an input/textarea/select', () => {\n    const navigate = vi.fn();\n    renderHook(() => useKeyboardShortcuts(navigate, vi.fn(), vi.fn()));\n    const input = document.createElement('input');\n    fireKey('g', input);\n    expect(navigate).not.toHaveBeenCalled();\n  });\n  it('ignores keystrokes with modifier keys held', () => {\n    const navigate = vi.fn();\n    renderHook(() => useKeyboardShortcuts(navigate, vi.fn(), vi.fn()));\n    fireKey('g', document.body, { metaKey: true });\n    expect(navigate).not.toHaveBeenCalled();\n  });\n  it('uses the latest navigate callback after re-render without re-adding listeners', () => {\n    const nav1 = vi.fn();\n    const nav2 = vi.fn();\n    const { rerender } = renderHook(({ nav }) => useKeyboardShortcuts(nav, vi.fn(), vi.fn()), { initialProps: { nav: nav1 } });\n    rerender({ nav: nav2 });\n    // fire a mapped shortcut key from SHORTCUT_MAP; expect nav2 called, not nav1\n  });\n});\n```\n\n```ts\n// src/hooks/useCountUp.test.ts\n// Gaps: target===0 short-circuits to 0 without animating; counting class add/remove lifecycle.\nimport { describe, it, expect } from 'vitest';\nimport { renderHook } from '@testing-library/react';\nimport { useCountUp } from './useCountUp';\n\ndescribe('useCountUp', () => {\n  it('returns 0 immediately when target is 0', () => {\n    const { result } = renderHook(() => useCountUp(0));\n    expect(result.current.value).toBe(0);\n  });\n  it('eventually reaches target for a non-zero value', async () => {\n    const { result } = renderHook(() => useCountUp(100, 50));\n    await new Promise((r) => setTimeout(r, 150));\n    expect(result.current.value).toBe(100);\n  });\n});\n```\n\n### Integration gaps (no view-level tests exist for any `src/views/*` in this context)\n- **BuilderView**: config parse failure → error state; localStorage-backed draft persistence (setup.ts explicitly calls this out as relying on real Storage semantics — untested).\n- **TranscriptsView**: interaction between `buildConversationItems`, `friendlyApiError`, and live API failures (401 → token clear → redirect).\n- No test exercises `request()`'s 401 path end-to-end through an actual view (e.g., session expiring mid-use).\n\n### Priority order\n1. `api.ts` `request()` — auth/error core, currently fully untested.\n2. `utils/transcript.ts` `buildConversationItems` — most complex pure function, zero coverage, drives the transcript UI.\n3. `utils/errors.ts` — many branches, easy wins.\n4. Hooks (`useToasts`, `useKeyboardShortcuts`) — stateful, regression-prone (stale closures).\n5. `utils/cache.ts` / `utils/config.ts` — smaller but currently 0%.\n",

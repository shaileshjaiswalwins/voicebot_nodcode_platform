        "code": "// src/hooks/useKeyboardShortcuts.test.ts\nimport { renderHook } from '@testing-library/react';\nimport { useKeyboardShortcuts } from './useKeyboardShortcuts';\n\nfunction fireKey(key: string, opts: Partial<KeyboardEventInit> = {}, target: EventTarget = document.body) {\n  const event = new KeyboardEvent('keydown', { key, bubbles: true, ...opts });\n  Object.defineProperty(event, 'target', { value: target });\n  window.dispatchEvent(event);\n}\n\ndescribe('useKeyboardShortcuts', () => {\n  it('ignores keys typed into an input', () => {\n    const navigate = vi.fn();\n    renderHook(() => useKeyboardShortcuts(navigate, vi.fn(), vi.fn()));\n    const input = document.createElement('input');\n    fireKey('b', {}, input);\n    expect(navigate).not.toHaveBeenCalled();\n  });\n\n  it('calls closeModal on Escape', () => {\n    const closeModal = vi.fn();\n    renderHook(() => useKeyboardShortcuts(vi.fn(), vi.fn(), closeModal));\n    fireKey('Escape');\n    expect(closeModal).toHaveBeenCalled();\n  });\n\n  it('toggles shortcuts help on \"?\"', () => {\n    const toggle = vi.fn();\n    renderHook(() => useKeyboardShortcuts(vi.fn(), toggle, vi.fn()));\n    fireKey('?');\n    expect(toggle).toHaveBeenCalled();\n  });\n\n  it('ignores navigation shortcuts when a modifier key is held', () => {\n    const navigate = vi.fn();\n    renderHook(() => useKeyboardShortcuts(navigate, vi.fn(), vi.fn()));\n    fireKey('b', { metaKey: true });\n    expect(navigate).not.toHaveBeenCalled();\n  });\n\n  it('uses the latest navigate callback without re-registering the listener', () => {\n    const first = vi.fn();\n    const second = vi.fn();\n    const { rerender } = renderHook(({ nav }) => useKeyboardShortcuts(nav, vi.fn(), vi.fn()), {\n      initialProps: { nav: first },\n    });\n    rerender({ nav: second });\n    fireKey('b');\n    expect(first).not.toHaveBeenCalled();\n    expect(second).toHaveBeenCalled();\n  });\n});"
      },

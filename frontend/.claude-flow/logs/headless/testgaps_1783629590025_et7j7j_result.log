  "output": "## Test Coverage Analysis — `frontend/src`\n\nTwo files have tests (`routes.test.ts`, `validation.test.ts`). Everything else — `api.ts`, hooks, and most `utils/` — is untested.\n\n### 1. `src/utils/formatting.ts` — untested, pure functions, high value\nGaps: `parseApiDate` (no-TZ vs Z vs offset), `formatDate`/`formatTime` invalid input, `titleCase` edge cases (empty string, multiple separators), `timeAgo` boundary values (59s/60s, 3599s/3600s, 86399s/86400s), `shortId` exactly-12-char boundary.\n\n```ts\n// src/utils/formatting.test.ts\nimport { shortId, parseApiDate, formatDate, formatTime, titleCase, timeAgo } from './formatting';\n\ndescribe('shortId', () => {\n  it('returns \"-\" for empty string', () => expect(shortId('')).toBe('-'));\n  it('leaves strings <=12 chars untouched', () => expect(shortId('123456789012')).toBe('123456789012'));\n  it('truncates strings >12 chars', () => expect(shortId('abcdefghijklmnop')).toBe('abcdefgh...mnop'));\n});\n\ndescribe('parseApiDate', () => {\n  it('appends Z when no timezone present', () => {\n    expect(parseApiDate('2026-01-01T00:00:00').toISOString()).toBe('2026-01-01T00:00:00.000Z');\n  });\n  it('respects an explicit Z', () => {\n    expect(parseApiDate('2026-01-01T00:00:00Z').toISOString()).toBe('2026-01-01T00:00:00.000Z');\n  });\n  it('respects an explicit offset', () => {\n    expect(parseApiDate('2026-01-01T05:30:00+05:30').toISOString()).toBe('2026-01-01T00:00:00.000Z');\n  });\n});\n\ndescribe('formatDate / formatTime', () => {\n  it('returns \"-\" for undefined', () => {\n    expect(formatDate(undefined)).toBe('-');\n    expect(formatTime(undefined)).toBe('-');\n  });\n  it('returns the raw string for unparseable input', () => {\n    expect(formatDate('not-a-date')).toBe('not-a-date');\n  });\n});\n\ndescribe('titleCase', () => {\n  it('handles empty string', () => expect(titleCase('')).toBe(''));\n  it('collapses multiple separators', () => expect(titleCase('a__b--c  d')).toBe('A B C D'));\n});\n\ndescribe('timeAgo', () => {\n  it('returns \"-\" for undefined', () => expect(timeAgo(undefined)).toBe('-'));\n  it('boundary: 59s vs 60s', () => {\n    const now = Date.now();\n    expect(timeAgo(new Date(now - 59_000).toISOString())).toBe('just now');\n    expect(timeAgo(new Date(now - 60_000).toISOString())).toContain('min ago');\n  });\n  it('boundary: just under vs at 24h -> \"yesterday\"', () => {\n    const now = Date.now();\n    expect(timeAgo(new Date(now - 86_400_000).toISOString())).toBe('yesterday');\n  });\n  it('falls back to formatDate at/after 48h', () => {\n    const now = Date.now();\n    expect(timeAgo(new Date(now - 172_800_000).toISOString())).not.toBe('yesterday');\n  });\n});\n```\n\n### 2. `src/utils/transcript.ts` — untested, complex branching logic (highest risk gap)\nGaps: `buildConversationItems` with no transcript, verified vs live vs raw selection priority, sort-by-time vs event-bucket fallback when turns lack timestamps, `normalizeTranscriptRole` unknown roles, `maxResponseDelayLabel` thresholds (3000/8000ms boundaries), `transcriptSourceLabel` all four `verified_transcript_status` branches.\n\n```ts\n// src/utils/transcript.test.ts\nimport {\n  buildConversationItems, normalizeTranscriptRole, transcriptSourceLabel, maxResponseDelayLabel\n} from './transcript';\nimport type { Transcript } from '../api';\n\ndescribe('buildConversationItems', () => {\n  it('returns [] when transcript is undefined', () => {\n    expect(buildConversationItems(undefined, [])).toEqual([]);\n  });\n\n  it('prefers verified_transcript when status succeeded and non-empty', () => {\n    const t = {\n      verified_transcript_status: 'succeeded',\n      verified_transcript: [{ role: 'user', text: 'hi', created_at: '2026-01-01T00:00:00Z' }],\n      transcript: [{ role: 'assistant', text: 'ignored' }],\n    } as unknown as Transcript;\n    const items = buildConversationItems(t, []);\n    expect(items.some(i => i.kind === 'turn' && i.text === 'hi')).toBe(true);\n  });\n\n  it('falls back to transcript then live_transcript when no verified turns', () => {\n    const t = { transcript: [], live_transcript: [{ role: 'user', text: 'fallback' }] } as unknown as Transcript;\n    const items = buildConversationItems(t, []);\n    expect(items.some(i => i.kind === 'turn' && i.text === 'fallback')).toBe(true);\n  });\n\n  it('buckets events around turns when turns have no created_at', () => {\n    const t = { transcript: [{ role: 'user', text: 'x' }] } as unknown as Transcript;\n    const events = [\n      { _id: '1', event_type: 'call_started', created_at: 't1' },\n      { _id: '2', event_type: 'call_ended', created_at: 't2' },\n    ] as any;\n    const items = buildConversationItems(t, events);\n    expect(items[0]).toMatchObject({ kind: 'event', title: 'call_started' });\n    expect(items[items.length - 1]).toMatchObject({ kind: 'event', title: 'call_ended' });\n  });\n});\n\ndescribe('normalizeTranscriptRole', () => {\n  it.each([\n    ['agent', 'assistant'], ['model', 'assistant'],\n    ['caller', 'user'], ['human', 'user'],\n    ['verified_recording', 'recording'],\n    ['', 'system'], ['unknown_role', 'unknown_role'],\n  ])('%s -> %s', (input, expected) => expect(normalizeTranscriptRole(input)).toBe(expected));\n});\n\ndescribe('transcriptSourceLabel', () => {\n  it.each([\n    ['succeeded', 'Verified recording'],\n    ['pending', 'Live transcript, verification pending'],\n    ['failed', 'Live transcript, verification failed'],\n    ['unavailable', 'Live transcript, recording unavailable'],\n  ])('status=%s', (status, expected) => {\n    expect(transcriptSourceLabel({ verified_transcript_status: status } as any)).toBe(expected);\n  });\n});\n\ndescribe('maxResponseDelayLabel', () => {\n  it('returns \"-\" when no metrics', () => expect(maxResponseDelayLabel({} as any)).toBe('-'));\n  it.each([[2999, '2999ms'], [3000, '3000ms slow'], [7999, '7999ms slow'], [8000, '8000ms high']])(\n    'delay=%d -> %s', (delay, expected) => {\n      expect(maxResponseDelayLabel({ latency_metrics: { max_response_delay_ms: delay } } as any)).toBe(expected);\n    }\n  );\n});\n```\n\n### 3. `src/utils/errors.ts` — untested; error-message classification is exactly the kind of logic that silently rots\nGaps: `friendlyApiError` vs `friendlyTestError` divergent messaging for the same raw error, non-Error thrown values, `buildDiagnostic` truncation at 220 chars.\n\n```ts\n// src/utils/errors.test.ts\nimport { friendlyApiError, friendlyTestError, buildDiagnostic, average, summarizeDetails } from './errors';\n\ndescribe('friendlyApiError', () => {\n  it('handles non-Error thrown values', () => expect(friendlyApiError('plain string')).toBe('plain string'));\n  it('classifies \"failed to fetch\" for api context', () => {\n    expect(friendlyApiError(new Error('Failed to fetch'))).toContain('Cannot reach the FastAPI backend');\n  });\n});\n\ndescribe('friendlyTestError', () => {\n  it('classifies LiveKit not configured', () => {\n    expect(friendlyTestError(new Error('LiveKit is not configured'))).toContain('LIVEKIT_URL');\n  });\n  it('classifies microphone permission errors', () => {\n    expect(friendlyTestError(new Error('permission denied'))).toContain('microphone');\n  });\n  it('falls back to raw message for unrecognized errors', () => {\n    expect(friendlyTestError(new Error('some odd error'))).toBe('some odd error');\n  });\n  it('falls back to default message when raw is empty', () => {\n    expect(friendlyTestError(new Error(''))).toBe('Unknown test call error. Check backend logs and LiveKit server status.');\n  });\n});\n\ndescribe('buildDiagnostic', () => {\n  it('truncates messages over 220 chars', () => {\n    const d = buildDiagnostic('scope', new Error('x'.repeat(300)));\n    expect(d.message.length).toBe(223); // 220 + '...'\n    expect(d.message.endsWith('...')).toBe(true);\n  });\n});\n\ndescribe('average', () => {\n  it('returns 0 for empty array', () => expect(average([])).toBe(0));\n  it('rounds', () => expect(average([1, 2])).toBe(2));\n});\n\ndescribe('summarizeDetails', () => {\n  it('caps at 4 entries and stringifies objects', () => {\n    const out = summarizeDetails({ a: 1, b: { x: 1 }, c: 3, d: 4, e: 5 });\n    expect(out.split(' | ').length).toBe(4);\n  });\n});\n```\n\n### 4. `src/utils/config.ts` — untested\nGaps: `parseConfig` invalid JSON, `deriveAgentState` all branch priority ordering (e.g. `hasRoom=false` should short-circuit to idle even if status says \"speaking\").\n\n```ts\n// src/utils/config.test.ts\nimport { parseConfig, deriveAgentState } from './config';\n\ndescribe('parseConfig', () => {\n  it('returns ok:false on invalid JSON', () => {\n    const result = parseConfig('{not json');\n    expect(result.ok).toBe(false);\n  });\n  it('returns ok:true with parsed value on valid JSON', () => {\n    expect(parseConfig('{\"a\":1}')).toEqual({ ok: true, value: { a: 1 } });\n  });\n});\n\ndescribe('deriveAgentState', () => {\n  it('is idle when hasRoom is false regardless of status', () => {\n    expect(deriveAgentState('speaking', true, false)).toBe('idle');\n  });\n  it('is speaking when remoteAudioReady even if status is neutral', () => {\n    expect(deriveAgentState('connected', true, true)).toBe('speaking');\n  });\n  it('prioritizes idle/disconnected over other keywords', () => {\n    expect(deriveAgentState('disconnected while thinking', true, true)).toBe('idle');\n  });\n  it('defaults to listening for unmatched status', () => {\n    expect(deriveAgentState('ready', false, true)).toBe('listening');\n  });\n});\n```\n\n### 5. `src/utils/cache.ts` — untested; silently swallows errors (`try/catch` around every call), so a bug here would never surface at runtime\nGaps: JSON parse failure fallback, `pruneOldCache` only removing stale-version keys not current-version keys, `localStorage.setItem` throwing (quota exceeded).\n\n```ts\n// src/utils/cache.test.ts\nimport { cacheSet, cacheGet, pruneOldCache, CACHE_PREFIX } from './cache';\n\nbeforeEach(() => window.localStorage.clear());\n\ndescribe('cacheGet/cacheSet', () => {\n  it('round-trips a value', () => {\n    cacheSet('k', { a: 1 });\n    expect(cacheGet('k', null)).toEqual({ a: 1 });\n  });\n  it('returns fallback when key missing', () => {\n    expect(cacheGet('missing', 'fallback')).toBe('fallback');\n  });\n  it('returns fallback on corrupt JSON', () => {\n    window.localStorage.setItem(`${CACHE_PREFIX}bad`, '{not json');\n    expect(cacheGet('bad', 'fallback')).toBe('fallback');\n  });\n  it('swallows setItem errors (e.g. quota exceeded)', () => {\n    const spy = vi.spyOn(Storage.prototype, 'setItem').mockImplementation(() => { throw new Error('quota'); });\n    expect(() => cacheSet('k', 1)).not.toThrow();\n    spy.mockRestore();\n  });\n});\n\ndescribe('pruneOldCache', () => {\n  it('removes keys from old jd-vb: versions but keeps current-version keys', () => {\n    window.localStorage.setItem('jd-vb:v1:old', '1');\n    cacheSet('current', 'value');\n    pruneOldCache();\n    expect(window.localStorage.getItem('jd-vb:v1:old')).toBeNull();\n    expect(cacheGet('current', null)).toBe('value');\n  });\n});\n```\n\n### 6. `src/hooks/useToasts.ts` — untested, has timer-based side effects\nGaps: auto-dismiss after duration, `durationMs=0` meaning \"never auto-dismiss\", multiple toasts get unique incrementing ids, manual `dismissToast`.\n\n```tsx\n// src/hooks/useToasts.test.ts\nimport { renderHook, act } from '@testing-library/react';\nimport { useToasts } from './useToasts';\n\ndescribe('useToasts', () => {\n  beforeEach(() => vi.useFakeTimers());\n  afterEach(() => vi.useRealTimers());\n\n  it('auto-dismisses after the default duration', () => {\n    const { result } = renderHook(() => useToasts());\n    act(() => { result.current.showToast('hi'); });\n    expect(result.current.toasts).toHaveLength(1);\n    act(() => { vi.advanceTimersByTime(4000); });\n    expect(result.current.toasts).toHaveLength(0);\n  });\n\n  it('does not auto-dismiss when durationMs is 0', () => {\n    const { result } = renderHook(() => useToasts());\n    act(() => { result.current.showToast('sticky', 'info', 0); });\n    act(() => { vi.advanceTimersByTime(10000); });\n    expect(result.current.toasts).toHaveLength(1);\n  });\n\n  it('assigns unique incrementing ids', () => {\n    const { result } = renderHook(() => useToasts());\n    act(() => {\n      result.current.showToast('a', 'info', 0);\n      result.current.showToast('b', 'info', 0);\n    });\n    const ids = result.current.toasts.map(t => t.id);\n    expect(new Set(ids).size).toBe(2);\n  });\n\n  it('dismissToast removes only the targeted toast', () => {\n    const { result } = renderHook(() => useToasts());\n    let id = '';\n    act(() => { id = result.current.showToast('a', 'info', 0); });\n    act(() => { result.current.dismissToast(id); });\n    expect(result.current.toasts).toHaveLength(0);\n  });\n});\n```\n\n### 7. `src/hooks/useKeyboardShortcuts.ts` — untested\nGaps: ignores keydown when focus is in INPUT/TEXTAREA/SELECT/contentEditable, `Escape` calls closeModal regardless of modifiers, `?` toggles shortcuts, modifier keys (cmd/ctrl/alt) suppress navigation, listener uses latest callback via ref (stale-closure regression test).\n\n```tsx\n// src/hooks/useKeyboardShortcuts.test.ts\nimport { renderHook } from '@testing-library/react';\nimport { useKeyboardShortcuts } from './useKeyboardShortcuts';\n\nfunction fireKey(key: string, opts: Partial<KeyboardEventInit> = {}, target: EventTarget = document.body) {\n  const event = new KeyboardEvent('keydown', { key, bubbles: true, ...opts });\n  Object.defineProperty(event, 'target', { value: target });\n  window.dispatchEvent(event);\n}\n\ndescribe('useKeyboardShortcuts', () => {\n  it('ignores keys typed into an input', () => {\n    const navigate = vi.fn();\n    renderHook(() => useKeyboardShortcuts(navigate, vi.fn(), vi.fn()));\n    const input = document.createElement('input');\n    fireKey('b', {}, input);\n    expect(navigate).not.toHaveBeenCalled();\n  });\n\n  it('calls closeModal on Escape', () => {\n    const closeModal = vi.fn();\n    renderHook(() => useKeyboardShortcuts(vi.fn(), vi.fn(), closeModal));\n    fireKey('Escape');\n    expect(closeModal).toHaveBeenCalled();\n  });\n\n  it('toggles shortcuts help on \"?\"', () => {\n    const toggle = vi.fn();\n    renderHook(() => useKeyboardShortcuts(vi.fn(), toggle, vi.fn()));\n    fireKey('?');\n    expect(toggle).toHaveBeenCalled();\n  });\n\n  it('ignores navigation shortcuts when a modifier key is held', () => {\n    const navigate = vi.fn();\n    renderHook(() => useKeyboardShortcuts(navigate, vi.fn(), vi.fn()));\n    fireKey('b', { metaKey: true });\n    expect(navigate).not.toHaveBeenCalled();\n  });\n\n  it('uses the latest navigate callback without re-registering the listener', () => {\n    const first = vi.fn();\n    const second = vi.fn();\n    const { rerender } = renderHook(({ nav }) => useKeyboardShortcuts(nav, vi.fn(), vi.fn()), {\n      initialProps: { nav: first },\n    });\n    rerender({ nav: second });\n    fireKey('b');\n    expect(first).not.toHaveBeenCalled();\n    expect(second).toHaveBeenCalled();\n  });\n});\n```\n\n### 8. `src/api.ts` — untested (integration-style gap)\nGaps: `request()` attaches Authorization header only when token present, 401 clears token, non-ok response throws `ApiError` with status+body, 204 returns undefined, `apiUrl` passthrough for absolute URLs.\n\n```ts\n// src/api.test.ts\nimport { apiUrl, setToken, clearToken, getToken, ApiError } from './api';\n\ndescribe('apiUrl', () => {\n  it('passes through absolute URLs unchanged', () => {\n    expect(apiUrl('https://other.example.com/x')).toBe('https://other.example.com/x');\n  });\n  it('prefixes relative paths with API_BASE', () => {\n    expect(apiUrl('/bots')).toContain('/bots');\n  });\n});\n\ndescribe('token storage', () => {\n  it('round-trips set/get/clear', () => {\n    setToken('abc');\n    expect(getToken()).toBe('abc');\n    clearToken();\n    expect(getToken()).toBe('');\n  });\n});\n\ndescribe('request() via fetch mock', () => {\n  beforeEach(() => { clearToken(); vi.stubGlobal('fetch', vi.fn()); });\n\n  it('omits Authorization header when no token is set', async () => {\n    (global.fetch as any).mockResolvedValue({ ok: true, status: 200, json: async () => ({}) });\n    const { setToken: _unused } = await import('./api');\n    await (await import('./api')).apiUrl; // ensure module loaded\n  });\n\n  it('clears token on 401 response', async () => {\n    setToken('will-be-cleared');\n    (global.fetch as any).mockResolvedValue({ ok: false, status: 401, text: async () => 'unauthorized' });\n    const api = await import('./api');\n    await expect((api as any).request?.('/x') ?? Promise.reject('request not exported')).rejects.toBeTruthy();\n    expect(getToken()).toBe('');\n  });\n\n  it('throws ApiError with status and body text on non-ok response', async () => {\n    (global.fetch as any).mockResolvedValue({ ok: false, status: 500, text: async () => 'server broke' });\n    // exercised indirectly through a public exported function that calls request(), e.g. listBots()\n  });\n});\n```\nNote: `request()` isn't exported — these tests should target it through whichever exported function (`listBots`, `getBot`, etc.) wraps it; check the full `api.ts` for exported call sites before writing these.\n\n### Priority ranking\n1. **`utils/transcript.ts`** — most complex branching (verified/live/raw selection, event bucketing), directly drives what users see as call history. Zero coverage today.\n2. **`api.ts` request/error path** — 401 handling and `ApiError` shape are relied on by every view's error handling; a regression here breaks auth silently.\n3. **`utils/errors.ts`** — message classification affects what operators see when debugging production incidents.\n4. **`hooks/useKeyboardShortcuts.ts`** — the input/contentEditable guard is exactly the kind of thing a future refactor breaks without a test screaming.\n5. **`utils/formatting.ts`, `utils/config.ts`, `utils/cache.ts`, `hooks/useToasts.ts`** — lower risk, pure/isolated, but still zero coverage.\n\nNo integration tests exist for the React views (`App.tsx`, `BuilderView.tsx`, etc.) — that's a separate, larger gap not addressed here since none of the view source was in scope.\n",

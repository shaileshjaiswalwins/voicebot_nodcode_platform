        "title": "1. `src/api.ts` — highest risk, zero coverage",
        "content": "\nUntested: `getToken`/`setToken`/`clearToken`, `apiUrl`, `request()` (auth header injection, 401 auto-clear, non-2xx → `ApiError`, 204 handling, JSON parse).\n\n**Gaps:**\n- 401 response should clear token but current code doesn't `throw` before also hitting the `!response.ok` branch — worth a test to pin behavior (does caller get `ApiError(401, ...)` after clear, or silently get `undefined`?).\n- `apiUrl` with absolute URL vs relative, leading-slash normalization.\n- `request` when body text-read itself fails (`.catch(() => '')`).\n\n```ts\n// src/api.test.ts\nimport { describe, it, expect, beforeEach, vi } from 'vitest';\nimport { getToken, setToken, clearToken, apiUrl, ApiError } from './api';\n\ndescribe('token storage', () => {\n  beforeEach(() => localStorage.clear());\n\n  it('returns empty string when no token set', () => {\n    expect(getToken()).toBe('');\n  });\n  it('round-trips a token', () => {\n    setToken('abc');\n    expect(getToken()).toBe('abc');\n  });\n  it('clearToken removes it', () => {\n    setToken('abc');\n    clearToken();\n    expect(getToken()).toBe('');\n  });\n});\n\ndescribe('apiUrl', () => {\n  it('passes through absolute http(s) urls unchanged', () => {\n    expect(apiUrl('https://foo.com/x')).toBe('https://foo.com/x');\n  });\n  it('prefixes relative paths with API_BASE, normalizing missing leading slash', () => {\n    expect(apiUrl('bots')).toMatch(/\\/bots$/);\n    expect(apiUrl('/bots')).toMatch(/\\/bots$/);\n  });\n});\n\ndescribe('request() via fetch mock', () => {\n  beforeEach(() => {\n    localStorage.clear();\n    vi.restoreAllMocks();\n  });\n\n  it('attaches Authorization header when a token is present', async () => {\n    setToken('tok123');\n    const fetchSpy = vi.spyOn(global, 'fetch').mockResolvedValue(\n      new Response(JSON.stringify({ ok: true }), { status: 200 })\n    );\n    // exercise a real exported call that hits request(), e.g. listBots()/getBot()\n    // await listBots();\n    expect(fetchSpy).toHaveBeenCalledWith(\n      expect.any(String),\n      expect.objectContaining({ headers: expect.objectContaining({ Authorization: 'Bearer tok123' }) })\n    );\n  });\n\n  it('clears token on 401 response', async () => {\n    setToken('stale');\n    vi.spyOn(global, 'fetch').mockResolvedValue(new Response('', { status: 401 }));\n    await expect(/* some api call */ Promise.resolve()).rejects; // replace with real call\n    expect(getToken()).toBe('');\n  });\n\n  it('throws ApiError with status + body text on non-ok response', async () => {\n    vi.spyOn(global, 'fetch').mockResolvedValue(new Response('bad request', { status: 400 }));\n    await expect(/* api call */ Promise.reject(new ApiError(400, 'bad request'))).rejects.toBeInstanceOf(ApiError);\n  });\n\n  it('returns undefined for 204 No Content without parsing body', async () => {\n    vi.spyOn(global, 'fetch').mockResolvedValue(new Response(null, { status: 204 }));\n    // const result = await deleteBot('id');\n    // expect(result).toBeUndefined();\n  });\n\n  it('falls back to statusText when error body text read fails', async () => {\n    const res = new Response('', { status: 500, statusText: 'Server Error' });\n    vi.spyOn(res, 'text').mockRejectedValue(new Error('stream closed'));\n    vi.spyOn(global, 'fetch').mockResolvedValue(res);\n    // expect thrown ApiError.message to be 'Server Error'\n  });\n});\n```\n\n---\n\n",

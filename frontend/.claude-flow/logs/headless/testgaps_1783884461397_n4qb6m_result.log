        "title": "2. `src/utils/errors.ts` — branch-heavy, untested",
        "content": "\n**Gaps:** every branch of `classifyNetworkError` (timeout/api, timeout/test, failed-to-fetch/api, failed-to-fetch/test), each LiveKit-specific string in `friendlyTestError`, `summarizeDetails` truncation to 4 entries, `average([])` empty-array edge case, `buildDiagnostic` message truncation at 220 chars.\n\n```ts\n// src/utils/errors.test.ts\nimport { describe, it, expect } from 'vitest';\nimport { friendlyApiError, friendlyTestError, summarizeDetails, average, buildDiagnostic } from './errors';\n\ndescribe('friendlyApiError', () => {\n  it('adds context for \"network timeout\"', () => {\n    expect(friendlyApiError(new Error('network timeout'))).toContain('Mongo/LiveKit');\n  });\n  it('adds context for \"failed to fetch\"', () => {\n    expect(friendlyApiError(new Error('failed to fetch'))).toContain('start_api.sh');\n  });\n  it('passes through unrecognized errors verbatim', () => {\n    expect(friendlyApiError(new Error('boom'))).toBe('boom');\n  });\n  it('stringifies non-Error values', () => {\n    expect(friendlyApiError('plain string')).toBe('plain string');\n  });\n});\n\ndescribe('friendlyTestError', () => {\n  it('flags unconfigured LiveKit', () => {\n    expect(friendlyTestError(new Error('LiveKit is not configured'))).toMatch(/LIVEKIT_URL/);\n  });\n  it('flags room-creation failure', () => {\n    expect(friendlyTestError(new Error('Could not create LiveKit test room'))).toMatch(/credentials/);\n  });\n  it('flags microphone permission errors case-insensitively', () => {\n    expect(friendlyTestError(new Error('Permission denied for MICROPHONE'))).toMatch(/microphone/i);\n  });\n  it('flags websocket/network errors', () => {\n    expect(friendlyTestError(new Error('WebSocket connection failed'))).toMatch(/ws\\/wss/);\n  });\n  it('falls back to generic message for unknown errors', () => {\n    expect(friendlyTestError(new Error(''))).toBe('Unknown test call error. Check backend logs and LiveKit server status.');\n  });\n});\n\ndescribe('summarizeDetails', () => {\n  it('caps output at 4 entries', () => {\n    const details = { a: 1, b: 2, c: 3, d: 4, e: 5 };\n    expect(summarizeDetails(details).split(' | ')).toHaveLength(4);\n  });\n  it('JSON-stringifies object values, stringifies primitives', () => {\n    expect(summarizeDetails({ x: { nested: 1 } })).toContain('{\"nested\":1}');\n  });\n});\n\ndescribe('average', () => {\n  it('returns 0 for empty array', () => {\n    expect(average([])).toBe(0);\n  });\n  it('rounds the mean', () => {\n    expect(average([1, 2])).toBe(2); // rounds 1.5 -> 2 (banker's? verify Math.round behavior)\n  });\n});\n\ndescribe('buildDiagnostic', () => {\n  it('truncates messages over 220 chars with ellipsis', () => {\n    const long = new Error('x'.repeat(300));\n    const d = buildDiagnostic('scope', long);\n    expect(d.message.endsWith('...')).toBe(true);\n    expect(d.message.length).toBeLessThanOrEqual(223);\n  });\n  it('defaults severity to error', () => {\n    expect(buildDiagnostic('scope', new Error('e')).severity).toBe('error');\n  });\n});\n```\n\n---\n\n",
        "level": 3

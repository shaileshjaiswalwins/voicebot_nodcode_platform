      {
        "title": "3. `src/utils/formatting.ts` — date/timezone edge cases untested",
        "content": "\n**Gaps:** `parseApiDate` timezone-suffix detection (`Z`, `+05:30`, no suffix), invalid date fallback to raw string in `formatDate`/`formatTime`, `timeAgo` boundary values (59s/60s, 3599s/3600s, 86399s/86400s, 172799s/172800s), `titleCase` with empty/undefined and multi-delimiter input.\n\n```ts\n// src/utils/formatting.test.ts\nimport { describe, it, expect, vi } from 'vitest';\nimport { shortId, parseApiDate, formatDate, timeAgo, titleCase } from './formatting';\n\ndescribe('shortId', () => {\n  it('returns \"-\" for empty string', () => expect(shortId('')).toBe('-'));\n  it('leaves short ids untouched', () => expect(shortId('abc123')).toBe('abc123'));\n  it('truncates long ids with ellipsis', () => expect(shortId('abcdefghijklmnop')).toBe('abcdefgh...mnop'));\n});\n\ndescribe('parseApiDate', () => {\n  it('treats a string without timezone as UTC by appending Z', () => {\n    const d = parseApiDate('2026-01-01T00:00:00');\n    expect(d.toISOString()).toBe('2026-01-01T00:00:00.000Z');\n  });\n  it('leaves an explicit Z suffix untouched', () => {\n    expect(parseApiDate('2026-01-01T00:00:00Z').toISOString()).toBe('2026-01-01T00:00:00.000Z');\n  });\n  it('leaves an explicit offset untouched', () => {\n    expect(parseApiDate('2026-01-01T00:00:00+05:30').getUTCHours()).toBe(18); // prev day 18:30 UTC\n  });\n});\n\ndescribe('formatDate', () => {\n  it('returns \"-\" for missing value', () => expect(formatDate(undefined)).toBe('-'));\n  it('returns raw value for unparseable date', () => expect(formatDate('not-a-date')).toBe('not-a-date'));\n});\n\ndescribe('timeAgo', () => {\n  it('returns \"-\" for missing value', () => expect(timeAgo(undefined)).toBe('-'));\n  beforeEachBoundaryCases();\n  function beforeEachBoundaryCases() {\n    it.each([\n      [30, 'just now'],\n      [90, '1 min ago'],\n      [3700, '1 hr ago'],\n    ])('classifies %i seconds ago correctly', (secs, expected) => {\n      vi.setSystemTime(Date.now());\n      const iso = new Date(Date.now() - secs * 1000).toISOString();\n      expect(timeAgo(iso)).toBe(expected);\n    });\n  }\n  it('returns \"yesterday\" for 1-2 day range', () => {\n    const iso = new Date(Date.now() - 90000 * 1000).toISOString();\n    expect(timeAgo(iso)).toBe('yesterday');\n  });\n  it('falls back to formatDate beyond 2 days', () => {\n    const iso = new Date(Date.now() - 3 * 86400 * 1000).toISOString();\n    expect(timeAgo(iso)).toBe(formatDate(iso));\n  });\n});\n\ndescribe('titleCase', () => {\n  it('returns \"-\" for empty/undefined', () => expect(titleCase(undefined)).toBe('-'));\n  it('splits on underscores, hyphens, and spaces', () => {\n    expect(titleCase('short_hangup-not interested')).toBe('Short Hangup Not Interested');\n  });\n});\n```\n\n---\n\n",
        "level": 3

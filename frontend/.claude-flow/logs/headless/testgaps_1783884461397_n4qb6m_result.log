        "language": "ts",
        "code": "// src/utils/cache.test.ts\nimport { describe, it, expect, vi, beforeEach } from 'vitest';\nimport { cacheSet, cacheGet, pruneOldCache, CACHE_PREFIX } from './cache';\n\ndescribe('cacheSet/cacheGet', () => {\n  beforeEach(() => localStorage.clear());\n\n  it('round-trips a JSON-serializable value', () => {\n    cacheSet('key', { a: 1 });\n    expect(cacheGet('key', null)).toEqual({ a: 1 });\n  });\n  it('returns fallback when key is missing', () => {\n    expect(cacheGet('missing', 'fallback')).toBe('fallback');\n  });\n  it('returns fallback when stored value is malformed JSON', () => {\n    localStorage.setItem(`${CACHE_PREFIX}bad`, '{not json');\n    expect(cacheGet('bad', 'fallback')).toBe('fallback');\n  });\n  it('swallows storage errors on set (e.g. quota exceeded)', () => {\n    vi.spyOn(Storage.prototype, 'setItem').mockImplementation(() => { throw new Error('quota'); });\n    expect(() => cacheSet('key', 'value')).not.toThrow();\n  });\n});\n\ndescribe('pruneOldCache', () => {\n  it('removes keys with the old jd-vb: prefix but not the current version', () => {\n    localStorage.setItem('jd-vb:v1:stale', 'x');\n    localStorage.setItem(`${CACHE_PREFIX}fresh`, 'y');\n    pruneOldCache();\n    expect(localStorage.getItem('jd-vb:v1:stale')).toBeNull();\n    expect(localStorage.getItem(`${CACHE_PREFIX}fresh`)).toBe('y');\n  });\n});"

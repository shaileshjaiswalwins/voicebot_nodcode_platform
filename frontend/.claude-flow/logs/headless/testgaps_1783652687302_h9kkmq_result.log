        "code": "import { parseApiDate, formatDate, formatTime, titleCase, timeAgo } from './formatting';\n\ndescribe('parseApiDate', () => {\n  it('appends Z when no timezone present', () => {\n    expect(parseApiDate('2026-07-10T10:00:00').toISOString()).toBe('2026-07-10T10:00:00.000Z');\n  });\n  it('preserves existing timezone offset', () => {\n    expect(parseApiDate('2026-07-10T10:00:00+05:30').getUTCHours()).toBe(4);\n  });\n});\n\ndescribe('formatDate / formatTime', () => {\n  it('returns \"-\" for undefined', () => {\n    expect(formatDate(undefined)).toBe('-');\n    expect(formatTime(undefined)).toBe('-');\n  });\n  it('returns raw value for unparseable date', () => {\n    expect(formatDate('not-a-date')).toBe('not-a-date');\n  });\n});\n\ndescribe('titleCase', () => {\n  it('handles mixed separators and repeated separators', () => {\n    expect(titleCase('foo__bar-baz  qux')).toBe('Foo Bar Baz Qux');\n  });\n  it('handles empty string', () => {\n    expect(titleCase('')).toBe('');\n  });\n});\n\ndescribe('timeAgo', () => {\n  it('returns \"-\" for undefined', () => {\n    expect(timeAgo(undefined)).toBe('-');\n  });\n  it('reports \"just now\" under 60s and minutes/hours boundaries', () => {\n    const now = Date.now();\n    expect(timeAgo(new Date(now - 30_000).toISOString())).toBe('just now');\n    expect(timeAgo(new Date(now - 90_000).toISOString())).toBe('1 min ago');\n    expect(timeAgo(new Date(now - 3_700_000).toISOString())).toBe('1 hr ago');\n    expect(timeAgo(new Date(now - 90_000_000).toISOString())).toBe('yesterday');\n  });\n});"

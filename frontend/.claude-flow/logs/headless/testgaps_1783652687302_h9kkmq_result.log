.toBe(2);\n  });\n});\n\ndescribe('buildDiagnostic', () => {\n  it('truncates messages over 220 chars', () => {\n    const long = 'x'.repeat(300);\n    const diag = buildDiagnostic('scope', new Error(long));\n    expect(diag.message.endsWith('...')).toBe(true);\n    expect(diag.message.length).toBeLessThanOrEqual(223);\n  });\n  it('defaults severity to error', () => {\n    expect(buildDiagnostic('scope', new Error('x')).severity).toBe('error');\n  });\n});\n```\n\n**`src/utils/transcript.ts`** — no tests; this is the most logic-dense untested file (merge/sort of turns + events, verified-transcript fallback chain)\n- `buildConversationItems`: no transcript → `[]`; verified succeeded uses `verified_transcript`; falls back to `transcript` then `live_transcript`; sorting when turns have timestamps vs. the non-timestamp branch ordering (start events first, end events last)\n- `normalizeTranscriptRole`: all role aliases + unknown fallback to `'system'`\n- `transcriptSourceLabel`: each `verified_transcript_status` branch + fallback to source fields\n- `maxResponseDelayLabel`: thresholds at 3000ms/8000ms, missing metrics\n\n```ts\nimport { buildConversationItems, normalizeTranscriptRole, transcriptSourceLabel, maxResponseDelayLabel } from './transcript';\nimport type { Transcript, CallEvent } from '../api';\n\ndescribe('buildConversationItems', () => {\n  it('returns empty array when transcript is undefined', () => {\n    expect(buildConversationItems(undefined, [])).toEqual([]);\n  });\n\n  it('prefers verified_transcript when status is succeeded', () => {\n    const t = {\n      verified_transcript_status: 'succeeded',\n      verified_transcript: [{ role: 'user', text: 'hi', created_at: '2026-07-10T00:00:00Z' }],\n      transcript: [{ role: 'assistant', text: 'should not appear' }],\n    } as unknown as Transcript;\n    const items = buildConversationItems(t, []);\n    expect(items.some((i) => i.kind === 'turn' && i.text === 'hi')).toBe(true);\n    expect(items.some((i) => i.kind === 'turn' && i.text === 'should not appear')).toBe(false);\n  });\n\n  it('falls back to live_transcript when transcript is absent', () => {\n    const t = { live_transcript: [{ role: 'user', text: 'fallback' }] } as unknown as Transcript;\n    const items = buildConversationItems(t, []);\n    expect(items.some((i) => i.kind === 'turn' && i.text === 'fallback')).toBe(true);\n  });\n\n  it('orders start events first and end events last when turns lack timestamps', () => {\n    const t = { transcript: [{ role: 'user', text: 'hi' }] } as unknown as Transcript;\n    const events = [\n      { _id: '1', event_type: 'call_ended', created_at: '' } as CallEvent,\n      { _id: '2', event_type: 'call_started', created_at: '' } as CallEvent,\n    ];\n    const items = buildConversationItems(t, events);\n    expect(items[0].kind === 'event' && items[0].title).toBe('call_started');\n    expect(items[items.length - 1].kind === 'event' && items[items.length - 1].title).toBe('call_ended');\n  });\n});\n\ndescribe('normalizeTranscriptRole', () => {\n  it.each([\n    ['agent', 'assistant'], ['model', 'assistant'],\n    ['customer', 'user'], ['human', 'user'],\n    ['recording', 'recording'],\n    ['', 'system'], ['unknown_role', 'unknown_role'],\n  ])('maps %s to %s', (input, expected) => {\n    expect(normalizeTranscriptRole(input)).toBe(expected);\n  });\n});\n\ndescribe('transcriptSourceLabel', () => {\n  it.each([\n    ['succeeded', 'Verified recording'],\n    ['pending', 'Live transcript, verification pending'],\n    ['failed', 'Live transcript, verification failed'],\n    ['unavailable', 'Live transcript, recording unavailable'],\n  ])('status %s -> %s', (status, expected) => {\n    expect(transcriptSourceLabel({ verified_transcript_status: status } as unknown as Transcript)).toBe(expected);\n  });\n  it('falls back to analysis_transcript_source when no verification status', () => {\n    expect(transcriptSourceLabel({ analysis_transcript_source: 'gemini_live' } as unknown as Transcript)).toBe('Gemini Live');\n  });\n});\n\ndescribe('maxResponseDelayLabel', () => {\n  it('returns \"-\" when no metrics', () => {\n    expect(maxResponseDelayLabel({} as Transcript)).toBe('-');\n  });\n  it.each([[2000, '2000ms'], [3500, '3500ms slow'], [9000, '9000ms high']])(\n    'labels %d as %s', (delay, expected) => {\n      expect(maxResponseDelayLabel({ latency_metrics: { max_response_delay_ms: delay } } as unknown as Transcript)).toBe(expected);\n    }\n  );\n});\n```\n\n**`src/api.ts`** — the whole HTTP layer is untested (highest-risk gap)\n- `request()`: adds Authorization header only when token present; strips token on 401 (calls `clearToken`); throws `ApiError` with status+body on non-ok; returns `undefined` on 204; parses JSON body otherwise\n- `apiUrl()`: absolute URL passthrough vs. relative path joining (leading slash present/absent)\n- `getToken`/`setToken`/`clearToken` round-trip via localStorage\n\n```ts\nimport { apiUrl, getToken, setToken, clearToken, ApiError } from './api';\n\ndescribe('apiUrl', () => {\n  it('passes through absolute URLs unchanged', () => {\n    expect(apiUrl('https://other.example.com/x')).toBe('https://other.example.com/x');\n  });\n  it('joins relative paths with API_BASE, normalizing missing leading slash', () => {\n    expect(apiUrl('foo')).toMatch(/\\/foo$/);\n    expect(apiUrl('/foo')).toMatch(/\\/foo$/);\n  });\n});\n\ndescribe('token storage', () => {\n  afterEach(() => clearToken());\n  it('round-trips token via localStorage', () => {\n    setToken('abc123');\n    expect(getToken()).toBe('abc123');\n    clearToken();\n    expect(getToken()).toBe('');\n  });\n});\n\ndescribe('request (via fetch mock)', () => {\n  const originalFetch = global.fetch;\n  afterEach(() => { global.fetch = originalFetch; clearToken(); });\n\n  it('clears token and throws ApiError on 401', async () => {\n    setToken('stale-token');\n    global.fetch = vi.fn().mockResolvedValue({ status: 401, ok: false, text: () => Promise.resolve('unauthorized') });\n    const { API_BASE } = await import('./api');\n    await expect(fetch(`${API_BASE}/x`)).resolves.toBeDefined();\n    // exercise real `request` indirectly through an exported API call, e.g. listBots()\n    expect(getToken()).toBe(''); // after request() runs\n  });\n\n  it('returns undefined for 204 responses', async () => {\n    global.fetch = vi.fn().mockResolvedValue({ status: 204, ok: true });\n    // call an exported function that hits a DELETE endpoint and assert result is undefined\n  });\n\n  it('throws ApiError with status and body text on non-ok response', async () => {\n    global.fetch = vi.fn().mockResolvedValue({ status: 500, ok: false, text: () => Promise.resolve('server error') });\n    // await expect(someApiCall()).rejects.toBeInstanceOf(ApiError)\n  });\n});\n```\n*Note: `request()` isn't exported — either export it for direct testing or test it through the exported CRUD functions (`listBots`, `getBot`, etc., not shown in the truncated excerpt but present in the full file).*\n\n**`src/utils/cache.ts`** — no tests\n- `cacheSet`/`cacheGet` round-trip; `cacheGet` returns fallback on missing key and on JSON parse failure\n- `pruneOldCache`: removes keys with old prefix, keeps current-version keys, keeps unrelated keys\n\n```ts\nimport { cacheSet, cacheGet, pruneOldCache, CACHE_PREFIX } from './cache';\n\ndescribe('cacheSet / cacheGet', () => {\n  it('round-trips a value', () => {\n    cacheSet('k', { a: 1 });\n    expect(cacheGet('k', null)).toEqual({ a: 1 });\n  });\n  it('returns fallback when key missing', () => {\n    expect(cacheGet('missing', 'default')).toBe('default');\n  });\n  it('returns fallback on corrupt JSON', () => {\n    window.localStorage.setItem(`${CACHE_PREFIX}bad`, '{not json');\n    expect(cacheGet('bad', 'fallback')).toBe('fallback');\n  });\n});\n\ndescribe('pruneOldCache', () => {\n  it('removes stale-version keys but keeps current-version and unrelated keys', () => {\n    window.localStorage.setItem('jd-vb:v1:old', '1');\n    window.localStorage.setItem(`${CACHE_PREFIX}current`, '2');\n    window.localStorage.setItem('unrelated', '3');\n    pruneOldCache();\n    expect(window.localStorage.getItem('jd-vb:v1:old')).toBeNull();\n    expect(window.localStorage.getItem(`${CACHE_PREFIX}current`)).toBe('2');\n    expect(window.localStorage.getItem('unrelated')).toBe('3');\n  });\n});\n```\n\n**`src/utils/config.ts`** — no tests\n- `parseConfig`: valid JSON → `{ok:true}`; invalid JSON → `{ok:false, error}`\n- `deriveAgentState`: every branch — no room, idle, connecting keywords, speaking via `remoteAudioReady`, thinking keywords, default listening\n\n```ts\nimport { parseConfig, deriveAgentState } from './config';\n\ndescribe('parseConfig', () => {\n  it('parses valid JSON', () => {\n    expect(parseConfig('{\"a\":1}')).toEqual({ ok: true, value: { a: 1 } });\n  });\n  it('reports error for invalid JSON', () => {\n    const result = parseConfig('{bad');\n    expect(result.ok).toBe(false);\n  });\n});\n\ndescribe('deriveAgentState', () => {\n  it('returns idle when no room even if status is active', () => {\n    expect(deriveAgentState('speaking', false, false)).toBe('idle');\n  });\n  it.each([\n    ['creating room', 'connecting'],\n    ['bot audio connected', 'speaking'],\n    ['waiting for bot', 'thinking'],\n    ['ready', 'listening'],\n  ])('status \"%s\" -> %s', (status, expected) => {\n    expect(deriveAgentState(status, false, true)).toBe(expected);\n  });\n  it('returns speaking when remoteAudioReady is true regardless of status text', () => {\n    expect(deriveAgentState('anything', true, true)).toBe('speaking');\n  });\n});\n```\n\n**Hooks — `useCountUp`, `useKeyboardShortcuts`, `useToasts`** — no tests\n- `useToasts`: `showToast` appends toast with generated id and default tone; `dismissToast` removes by id; auto-dismiss after `durationMs`; `durationMs=0` skips auto-dismiss\n- `useKeyboardShortcuts`: ignores keydown when target is INPUT/TEXTAREA/SELECT/contentEditable; Escape calls `closeModal`; `?` toggles shortcuts; ignores when modifier keys held; navigates on mapped shortcut key\n- `useCountUp`: target 0 resets to 0 immediately\n\n```ts\nimport { renderHook, act } from '@testing-library/react';\nimport { useToasts } from './useToasts';\n\ndescribe('useToasts', () => {\n  it('adds and auto-dismisses a toast after duration', () => {\n    vi.useFakeTimers();\n    const { result } = renderHook(() => useToasts());\n    act(() => { result.current.showToast('hello', 'success', 1000); });\n    expect(result.current.toasts).toHaveLength(1);\n    act(() => { vi.advanceTimersByTime(1000); });\n    expect(result.current.toasts).toHaveLength(0);\n    vi.useRealTimers();\n  });\n\n  it('does not auto-dismiss when durationMs is 0', () => {\n    vi.useFakeTimers();\n    const { result } = renderHook(() => useToasts());\n    act(() => { result.current.showToast('sticky', 'info', 0); });\n    act(() => { vi.advanceTimersByTime(10000); });\n    expect(result.current.toasts).toHaveLength(1);\n    vi.useRealTimers();\n  });\n\n  it('dismissToast removes the correct toast', () => {\n    const { result } = renderHook(() => useToasts());\n    let id = '';\n    act(() => { id = result.current.showToast('a', 'success', 0); });\n    act(() => { result.current.dismissToast(id); });\n    expect(result.current.toasts).toHaveLength(0);\n  });\n});\n```\n\n```ts\nimport { renderHook } from '@testing-library/react';\nimport { useKeyboardShortcuts } from './useKeyboardShortcuts';\n\ndescribe('useKeyboardShortcuts', () => {\n  it('calls closeModal on Escape', () => {\n    const navigate = vi.fn(), toggle = vi.fn(), close = vi.fn();\n    renderHook(() => useKeyboardShortcuts(navigate, toggle, close));\n    window.dispatchEvent(new KeyboardEvent('keydown', { key: 'Escape' }));\n    expect(close).toHaveBeenCalled();\n  });\n\n  it('ignores keydown originating from an input element', () => {\n    const navigate = vi.fn(), toggle = vi.fn(), close = vi.fn();\n    renderHook(() => useKeyboardShortcuts(navigate, toggle, close));\n    const input = document.createElement('input');\n    document.body.appendChild(input);\n    input.dispatchEvent(new KeyboardEvent('keydown', { key: '?', bubbles: true }));\n    expect(toggle).not.toHaveBeenCalled();\n    input.remove();\n  });\n\n  it('ignores shortcuts when a modifier key is held', () => {\n    const navigate = vi.fn(), toggle = vi.fn(), close = vi.fn();\n    renderHook(() => useKeyboardShortcuts(navigate, toggle, close));\n    window.dispatchEvent(new KeyboardEvent('keydown', { key: 'b', ctrlKey: true }));\n    expect(navigate).not.toHaveBeenCalled();\n  });\n});\n```\n\n",

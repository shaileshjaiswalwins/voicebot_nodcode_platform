        "code": "import { cacheSet, cacheGet, pruneOldCache, CACHE_PREFIX } from './cache';\n\ndescribe('cacheSet / cacheGet', () => {\n  it('round-trips a value', () => {\n    cacheSet('k', { a: 1 });\n    expect(cacheGet('k', null)).toEqual({ a: 1 });\n  });\n  it('returns fallback when key missing', () => {\n    expect(cacheGet('missing', 'default')).toBe('default');\n  });\n  it('returns fallback on corrupt JSON', () => {\n    window.localStorage.setItem(`${CACHE_PREFIX}bad`, '{not json');\n    expect(cacheGet('bad', 'fallback')).toBe('fallback');\n  });\n});\n\ndescribe('pruneOldCache', () => {\n  it('removes stale-version keys but keeps current-version and unrelated keys', () => {\n    window.localStorage.setItem('jd-vb:v1:old', '1');\n    window.localStorage.setItem(`${CACHE_PREFIX}current`, '2');\n    window.localStorage.setItem('unrelated', '3');\n    pruneOldCache();\n    expect(window.localStorage.getItem('jd-vb:v1:old')).toBeNull();\n    expect(window.localStorage.getItem(`${CACHE_PREFIX}current`)).toBe('2');\n    expect(window.localStorage.getItem('unrelated')).toBe('3');\n  });\n});"

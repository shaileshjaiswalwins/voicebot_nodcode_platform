  "output": "I'll analyze the given files for test coverage gaps, focusing on untested functions, edge cases, and error handling.\n\n## Coverage Analysis\n\n**Tested (has .test.ts):** `utils/routes.ts`, `utils/validation.ts`\n\n**Untested — high priority gaps:**\n\n### 1. `src/utils/formatting.ts` — zero coverage, pure functions, easy wins\nGaps: `parseApiDate` timezone inference, `formatDate`/`formatTime` invalid dates, `titleCase` edge cases, `timeAgo` boundary buckets (59s/60s, 3599s/3600s, etc.), and `shortId` truncation boundary (exactly 12 chars).\n\n```ts\nimport { shortId, parseApiDate, formatDate, formatTime, titleCase, timeAgo } from './formatting';\n\ndescribe('shortId', () => {\n  it('returns \"-\" for empty string', () => expect(shortId('')).toBe('-'));\n  it('leaves strings <=12 chars untouched', () => expect(shortId('123456789012')).toBe('123456789012'));\n  it('truncates strings >12 chars', () => expect(shortId('1234567890123')).toBe('12345678...0123'));\n});\n\ndescribe('parseApiDate', () => {\n  it('appends Z when no timezone present', () => {\n    expect(parseApiDate('2026-01-01T00:00:00').toISOString()).toBe('2026-01-01T00:00:00.000Z');\n  });\n  it('preserves an explicit timezone offset', () => {\n    expect(parseApiDate('2026-01-01T00:00:00+05:30').getTime())\n      .toBe(new Date('2026-01-01T00:00:00+05:30').getTime());\n  });\n});\n\ndescribe('formatDate / formatTime', () => {\n  it('returns \"-\" for undefined/empty input', () => {\n    expect(formatDate(undefined)).toBe('-');\n    expect(formatTime('')).toBe('-');\n  });\n  it('returns raw value for unparseable date string', () => {\n    expect(formatDate('not-a-date')).toBe('not-a-date');\n  });\n});\n\ndescribe('titleCase', () => {\n  it('returns \"-\" for falsy input', () => expect(titleCase()).toBe('-'));\n  it('splits on underscores, hyphens, and whitespace', () => {\n    expect(titleCase('hello_world-foo bar')).toBe('Hello World Foo Bar');\n  });\n  it('collapses repeated separators without empty segments', () => {\n    expect(titleCase('a__b')).toBe('A B');\n  });\n});\n\ndescribe('timeAgo', () => {\n  it('returns \"-\" for undefined', () => expect(timeAgo(undefined)).toBe('-'));\n  it('reports \"just now\" under 60s', () => {\n    expect(timeAgo(new Date(Date.now() - 5000).toISOString())).toBe('just now');\n  });\n  it('reports minutes between 60s and 1hr', () => {\n    expect(timeAgo(new Date(Date.now() - 90_000).toISOString())).toBe('1 min ago');\n  });\n  it('reports \"yesterday\" for 24-48hr range', () => {\n    expect(timeAgo(new Date(Date.now() - 90_000_000).toISOString())).toBe('yesterday');\n  });\n  it('falls back to formatDate beyond 48hr', () => {\n    const iso = new Date(Date.now() - 3 * 86_400_000).toISOString();\n    expect(timeAgo(iso)).toBe(formatDate(iso));\n  });\n});\n```\n\n### 2. `src/utils/config.ts` — untested, has branching logic\n```ts\nimport { parseConfig, deriveAgentState } from './config';\n\ndescribe('parseConfig', () => {\n  it('parses valid JSON', () => {\n    expect(parseConfig('{\"a\":1}')).toEqual({ ok: true, value: { a: 1 } });\n  });\n  it('returns ok:false with error message for invalid JSON', () => {\n    const result = parseConfig('{bad json');\n    expect(result.ok).toBe(false);\n  });\n});\n\ndescribe('deriveAgentState', () => {\n  it('returns idle when hasRoom is false regardless of status', () => {\n    expect(deriveAgentState('speaking', true, false)).toBe('idle');\n  });\n  it('returns idle for disconnected status', () => {\n    expect(deriveAgentState('Disconnected', false, true)).toBe('idle');\n  });\n  it('returns connecting for reconnecting status', () => {\n    expect(deriveAgentState('Reconnecting', false, true)).toBe('connecting');\n  });\n  it('prioritizes remoteAudioReady over status text for speaking', () => {\n    expect(deriveAgentState('waiting for bot', true, true)).toBe('speaking');\n  });\n  it('falls back to listening for unrecognized status', () => {\n    expect(deriveAgentState('unknown-state', false, true)).toBe('listening');\n  });\n});\n```\n\n### 3. `src/utils/errors.ts` — untested, string-matching branches are easy to regress\n```ts\nimport { friendlyApiError, friendlyTestError, summarizeDetails, average, buildDiagnostic } from './errors';\n\ndescribe('friendlyApiError', () => {\n  it('adds context for \"failed to fetch\"', () => {\n    expect(friendlyApiError(new Error('Failed to fetch'))).toContain('Cannot reach the FastAPI backend');\n  });\n  it('passes through unrecognized errors unchanged', () => {\n    expect(friendlyApiError(new Error('boom'))).toBe('boom');\n  });\n  it('handles non-Error thrown values', () => {\n    expect(friendlyApiError('plain string')).toBe('plain string');\n  });\n});\n\ndescribe('friendlyTestError', () => {\n  it('flags missing LiveKit configuration', () => {\n    expect(friendlyTestError(new Error('LiveKit is not configured'))).toContain('LIVEKIT_URL');\n  });\n  it('flags microphone permission errors', () => {\n    expect(friendlyTestError(new Error('permission denied'))).toContain('microphone');\n  });\n  it('falls back to generic message for empty error', () => {\n    expect(friendlyTestError(new Error(''))).toContain('Unknown test call error');\n  });\n});\n\ndescribe('average', () => {\n  it('returns 0 for empty array', () => expect(average([])).toBe(0));\n  it('rounds to nearest integer', () => expect(average([1, 2])).toBe(2));\n});\n\ndescribe('summarizeDetails', () => {\n  it('caps output at 4 entries', () => {\n    const details = { a: 1, b: 2, c: 3, d: 4, e: 5 };\n    expect(summarizeDetails(details).split(' | ')).toHaveLength(4);\n  });\n  it('stringifies nested objects', () => {\n    expect(summarizeDetails({ x: { y: 1 } })).toBe('x: {\"y\":1}');\n  });\n});\n\ndescribe('buildDiagnostic', () => {\n  it('truncates messages over 220 chars', () => {\n    const long = 'a'.repeat(300);\n    const diag = buildDiagnostic('scope', new Error(long));\n    expect(diag.message.endsWith('...')).toBe(true);\n    expect(diag.message.length).toBe(223);\n  });\n});\n```\n\n### 4. `src/utils/transcript.ts` — untested, has non-trivial sort/merge logic\nGaps: verified vs live transcript selection priority, event ordering when turns lack timestamps, unknown role normalization.\n```ts\nimport { buildConversationItems, normalizeTranscriptRole, transcriptSourceLabel, maxResponseDelayLabel } from './transcript';\n\ndescribe('buildConversationItems', () => {\n  it('returns empty array when transcript is undefined', () => {\n    expect(buildConversationItems(undefined)).toEqual([]);\n  });\n  it('prefers verified_transcript when status is succeeded', () => {\n    const t = {\n      _id: '1', created_at: '', verified_transcript_status: 'succeeded' as const,\n      verified_transcript: [{ role: 'user', text: 'v', created_at: '2026-01-01T00:00:00Z' }],\n      transcript: [{ role: 'user', text: 'live', created_at: '2026-01-01T00:00:00Z' }],\n    };\n    const items = buildConversationItems(t as any);\n    expect(items[0]).toMatchObject({ text: 'v' });\n  });\n  it('falls back to live_transcript when transcript is absent', () => {\n    const t = { _id: '1', created_at: '', live_transcript: [{ role: 'user', text: 'l' }] };\n    expect(buildConversationItems(t as any)[0]).toMatchObject({ text: 'l' });\n  });\n  it('orders start/end events around turns when turns have no timestamps', () => {\n    const t = { _id: '1', created_at: '', transcript: [{ role: 'user', text: 'hi' }] };\n    const events = [\n      { _id: 'e1', event_type: 'call_ended', created_at: '' },\n      { _id: 'e2', event_type: 'call_started', created_at: '' },\n    ];\n    const items = buildConversationItems(t as any, events as any);\n    expect(items[0]).toMatchObject({ title: 'call_started' });\n    expect(items[items.length - 1]).toMatchObject({ title: 'call_ended' });\n  });\n});\n\ndescribe('normalizeTranscriptRole', () => {\n  it('maps known aliases', () => {\n    expect(normalizeTranscriptRole('agent')).toBe('assistant');\n    expect(normalizeTranscriptRole('caller')).toBe('user');\n  });\n  it('defaults unknown roles to \"system\"', () => {\n    expect(normalizeTranscriptRole('')).toBe('system');\n    expect(normalizeTranscriptRole('weird')).toBe('weird');\n  });\n});\n\ndescribe('transcriptSourceLabel', () => {\n  it('reports pending verification', () => {\n    expect(transcriptSourceLabel({ verified_transcript_status: 'pending' } as any))\n      .toBe('Live transcript, verification pending');\n  });\n});\n\ndescribe('maxResponseDelayLabel', () => {\n  it('returns \"-\" when no delay metric present', () => {\n    expect(maxResponseDelayLabel({ latency_metrics: {} } as any)).toBe('-');\n  });\n  it('flags high delay over 8000ms', () => {\n    expect(maxResponseDelayLabel({ latency_metrics: { max_response_delay_ms: 9000 } } as any))\n      .toBe('9000ms high');\n  });\n});\n```\n\n### 5. `src/api.ts` — `request()`, token helpers, `ApiError`, `apiUrl` untested (no test file exists for api.ts)\nCritical gaps: 401 handling clears token, non-ok response throws `ApiError` with body text, 204 returns undefined, absolute URL passthrough in `apiUrl`.\n```ts\nimport { apiUrl, getToken, setToken, clearToken, ApiError } from './api';\n\ndescribe('apiUrl', () => {\n  it('passes through absolute URLs unchanged', () => {\n    expect(apiUrl('https://other.com/x')).toBe('https://other.com/x');\n  });\n  it('prefixes relative paths with API_BASE', () => {\n    expect(apiUrl('/foo')).toContain('/foo');\n  });\n  it('adds a leading slash if missing', () => {\n    expect(apiUrl('foo')).toMatch(/\\/foo$/);\n  });\n});\n\ndescribe('token storage', () => {\n  it('returns empty string when no token set', () => expect(getToken()).toBe(''));\n  it('round-trips setToken/getToken/clearToken', () => {\n    setToken('abc');\n    expect(getToken()).toBe('abc');\n    clearToken();\n    expect(getToken()).toBe('');\n  });\n});\n\ndescribe('ApiError', () => {\n  it('carries status and message', () => {\n    const err = new ApiError(404, 'not found');\n    expect(err.status).toBe(404);\n    expect(err.message).toBe('not found');\n  });\n});\n\n// request() itself needs fetch-mocked integration tests:\n// - 401 response clears stored token\n// - non-ok response throws ApiError with body text\n// - 204 response resolves to undefined\n// - Authorization header only sent when token present\n```\n\n### 6. `src/hooks/useToasts.ts`, `useCountUp.ts`, `useKeyboardShortcuts.ts` — untested React hooks\nGaps: toast auto-dismiss timing, `durationMs=0` disables auto-dismiss, keyboard shortcut ignored when focus is in input/textarea/contentEditable.\n```ts\nimport { renderHook, act } from '@testing-library/react';\nimport { useToasts } from './useToasts';\n\ndescribe('useToasts', () => {\n  it('adds a toast and auto-dismisses after duration', () => {\n    vi.useFakeTimers();\n    const { result } = renderHook(() => useToasts());\n    act(() => { result.current.showToast('hi'); });\n    expect(result.current.toasts).toHaveLength(1);\n    act(() => { vi.advanceTimersByTime(4000); });\n    expect(result.current.toasts).toHaveLength(0);\n    vi.useRealTimers();\n  });\n  it('does not auto-dismiss when durationMs is 0', () => {\n    vi.useFakeTimers();\n    const { result } = renderHook(() => useToasts());\n    act(() => { result.current.showToast('persist', 'info', 0); });\n    act(() => { vi.advanceTimersByTime(10000); });\n    expect(result.current.toasts).toHaveLength(1);\n    vi.useRealTimers();\n  });\n});\n```\n(`useKeyboardShortcuts` needs a jsdom test asserting keydown on an `<input>` is ignored, and Escape closes modal regardless of shortcut map.)\n\n## Missing error-handling tests\n- `api.ts`: no test that a fetch rejection (network down) propagates, and that malformed JSON body on `response.json()` is not swallowed.\n- `errors.ts`: `friendlyApiError`/`friendlyTestError` never tested with non-`Error` throwables (already added above) or `undefined`.\n- `cache.ts`: `cacheGet`
        "content": "Gaps: each `classifyNetworkError` branch (timeout/failed-to-fetch) x context ('api'/'test'), LiveKit-specific messages, permission/microphone/websocket branches, `summarizeDetails` truncation to 4 entries, `average` on empty array, `buildDiagnostic` message truncation at 220 chars.\n\n```ts\n// src/utils/errors.test.ts\nimport { describe, it, expect } from 'vitest';\nimport { friendlyApiError, friendlyTestError, summarizeDetails, average, buildDiagnostic } from './errors';\n\ndescribe('friendlyApiError', () => {\n  it('adds context for network timeout', () => {\n    expect(friendlyApiError(new Error('Network timeout'))).toMatch(/Mongo\\/LiveKit/);\n  });\n  it('adds context for failed to fetch', () => {\n    expect(friendlyApiError(new Error('Failed to fetch'))).toMatch(/start_api\\.sh/);\n  });\n  it('passes through unrecognized errors', () => {\n    expect(friendlyApiError(new Error('weird error'))).toBe('weird error');\n  });\n  it('stringifies non-Error values', () => {\n    expect(friendlyApiError('plain string')).toBe('plain string');\n  });\n});\n\ndescribe('friendlyTestError', () => {\n  it('gives test-specific timeout guidance', () => {\n    expect(friendlyTestError(new Error('Network timeout'))).toMatch(/too slow/);\n  });\n  it('flags missing LiveKit config', () => {\n    expect(friendlyTestError(new Error('LiveKit is not configured'))).toMatch(/LIVEKIT_URL/);\n  });\n  it('flags room creation failure', () => {\n    expect(friendlyTestError(new Error('Could not create LiveKit test room'))).toMatch(/LiveKit server/);\n  });\n  it('flags microphone permission issues', () => {\n    expect(friendlyTestError(new Error('permission denied for microphone'))).toMatch(/microphone permission/);\n  });\n  it('flags websocket/network issues', () => {\n    expect(friendlyTestError(new Error('websocket closed'))).toMatch(/ws\\/wss/);\n  });\n  it('falls back to generic message for unknown errors', () => {\n    expect(friendlyTestError(new Error(''))).toMatch(/Unknown test call error/);\n  });\n});\n\ndescribe('summarizeDetails', () => {\n  it('joins up to 4 entries with key: value', () => {\n    const result = summarizeDetails({ a: 1, b: 'x' });\n    expect(result).toBe('a: 1 | b: x');\n  });\n  it('truncates to first 4 entries', () => {\n    const result = summarizeDetails({ a: 1, b: 2, c: 3, d: 4, e: 5 });\n    expect(result.split(' | ')).toHaveLength(4);\n  });\n  it('JSON-stringifies object values', () => {\n    expect(summarizeDetails({ meta: { x: 1 } })).toBe('meta: {\"x\":1}');\n  });\n});\n\ndescribe('average', () => {\n  it('returns 0 for empty array', () => {\n    expect(average([])).toBe(0);\n  });\n  it('rounds to nearest integer', () => {\n    expect(average([1, 2])).toBe(2); // (1+2)/2 = 1.5 -> round to 2\n  });\n});\n\ndescribe('buildDiagnostic', () => {\n  it('truncates messages longer than 220 chars with ellipsis', () => {\n    const long = 'x'.repeat(300);\n    const diag = buildDiagnostic('scope', new Error(long));\n    expect(diag.message.endsWith('...')).toBe(true);\n    expect(diag.message.length).toBe(223);\n  });\n  it('defaults severity to error', () => {\n    const diag = buildDiagnostic('scope', new Error('e'));\n    expect(diag.severity).toBe('error');\n  });\n  it('includes action when provided', () => {\n    const diag = buildDiagnostic('scope', new Error('e'), 'retry');\n    expect(diag.action).toBe('retry');\n  });\n});\n```\n\n",
        "level": 3
      },
      {
        "title": "3. `src/utils/formatting.ts` — no tests",
        "content": "Gaps: `shortId` boundary at 12 chars, `parseApiDate` with/without timezone suffix, `formatDate`/`formatTime` invalid date fallback, `titleCase` empty/undefined, `timeAgo` boundary buckets (60s, 1hr, 24hr, 48hr).\n\n```ts\n// src/utils/formatting.test.ts\nimport { describe, it, expect, vi } from 'vitest';\nimport { shortId, parseApiDate, formatDate, formatTime, titleCase, timeAgo } from './formatting';\n\ndescribe('shortId', () => {\n  it('returns \"-\" for empty string', () => expect(shortId('')).toBe('-'));\n  it('returns unchanged string at or under 12 chars', () => expect(shortId('123456789012')).toBe('123456789012'));\n  it('truncates strings over 12 chars', () => expect(shortId('abcdefghijklmnop')).toBe('abcdefgh...mnop'));\n});\n\ndescribe('parseApiDate', () => {\n  it('appends Z when no timezone present', () => {\n    expect(parseApiDate('2026-01-01T00:00:00').toISOString()).toBe('2026-01-01T00:00:00.000Z');\n  });\n  it('leaves timezone-suffixed strings untouched', () => {\n    expect(parseApiDate('2026-01-01T00:00:00+05:30').getUTCHours()).toBe(18);\n  });\n});\n\ndescribe('formatDate / formatTime', () => {\n  it('returns \"-\" for undefined input', () => {\n    expect(formatDate(undefined)).toBe('-');\n    expect(formatTime(undefined)).toBe('-');\n  });\n  it('returns raw value for unparseable date', () => {\n    expect(formatDate('not-a-date')).toBe('not-a-date');\n  });\n});\n\ndescribe('titleCase', () => {\n  it('returns \"-\" for undefined/empty', () => {\n    expect(titleCase(undefined)).toBe('-');\n    expect(titleCase('')).toBe('-');\n  });\n  it('splits on underscores/hyphens/spaces and capitalizes', () => {\n    expect(titleCase('call_started-now')).toBe('Call Started Now');\n  });\n});\n\ndescribe('timeAgo', () => {\n  it('returns \"-\" for undefined', () => expect(timeAgo(undefined)).toBe('-'));\n  it('returns \"just now\" under 60s', () => {\n    expect(timeAgo(new Date(Date.now() - 30_000).toISOString())).toBe('just now');\n  });\n  it('returns minutes under 1hr', () => {\n    expect(timeAgo(new Date(Date.now() - 5 * 60_000).toISOString())).toBe('5 min ago');\n  });\n  it('returns hours under 24hr', () => {\n    expect(timeAgo(new Date(Date.now() - 3 * 3600_000).toISOString())).toBe('3 hr ago');\n  });\n  it('returns \"yesterday\" between 24-48hr', () => {\n    expect(timeAgo(new Date(Date.now() - 30 * 3600_000).toISOString())).toBe('yesterday');\n  });\n  it('falls back to formatDate beyond 48hr', () => {\n    const iso = new Date(Date.now() - 100 * 3600_000).toISOString();\n    expect(timeAgo(iso)).toBe(formatDate(iso));\n  });\n});\n```\n\n",
        "level": 3
      },
      {
        "title": "4. `src/utils/transcript.ts` — no tests (complex branching logic)",
        "content": "Gaps: `buildConversationItems` with no transcript, verified vs live vs plain transcript selection, sorting when turns have timestamps vs event-bucketed fallback when they don't, `normalizeTranscriptRole` mapping table, `transcriptSourceLabel` all 4 verified-status branches, `maxResponseDelayLabel` thresholds (0/3000/8000ms).\n\n```ts\n// src/utils/transcript.test.ts\nimport { describe, it, expect } from 'vitest';\nimport {\n  buildConversationItems, normalizeTranscriptRole, transcriptSourceLabel, maxResponseDelayLabel\n} from './transcript';\nimport type { Transcript } from '../api';\n\ndescribe('buildConversationItems', () => {\n  it('returns empty array when transcript is undefined', () => {\n    expect(buildConversationItems(undefined, [])).toEqual([]);\n  });\n\n  it('prefers verified_transcript when status is succeeded', () => {\n    const t = {\n      verified_transcript_status: 'succeeded',\n      verified_transcript: [{ role: 'user', text: 'v', created_at: '2026-01-01T00:00:00Z' }],\n      transcript: [{ role: 'user', text: 'plain', created_at: '2026-01-01T00:00:00Z' }],\n    } as unknown as Transcript;\n    const items = buildConversationItems(t, []);\n    expect(items.some(i => i.kind === 'turn' && i.text === 'v')).toBe(true);\n  });\n\n  it('falls back to transcript then live_transcript when unverified', () => {\n    const t = { live_transcript: [{ role: 'user', text: 'live' }] } as unknown as Transcript;\n    const items = buildConversationItems(t, []);\n    expect(items.some(i => i.kind === 'turn' && i.text === 'live')).toBe(true);\n  });\n\n  it('sorts by timestamp when turns have created_at', () => {\n    const t = {\n      transcript: [\n        { role: 'user', text: 'second', created_at: '2026-01-01T00:00:02Z' },\n        { role: 'assistant', text: 'first', created_at: '2026-01-01T00:00:01Z' },\n      ],\n    } as unknown as Transcript;\n    const items = buildConversationItems(t, []);\n    expect(items.map(i => (i as { text: string }).text)).toEqual(['first', 'second']);\n  });\n\n  it('buckets start/middle/end events around turns when no timestamps present', () => {\n    const t = { transcript: [{ role: 'user', text: 'hi' }] } as unknown as Transcript;\n    const events = [\n      { _id: '1', event_type: 'call_started', created_at: '' },\n      { _id: '2', event_type: 'call_ended', created_at: '' },\n    ];\n    const items = buildConversationItems(t, events as never);\n    expect(items[0]).toMatchObject({ title: 'call_started' });\n    expect(items[items.length - 1]).toMatchObject({ title: 'call_ended' });\n  });\n\n  it('filters out events not in INLINE_EVENT_TYPES', () => {\n    const t = { transcript: [{ role: 'user', text: 'hi', created_at: '2026-01-01T00:00:00Z' }] } as unknown as Transcript;\n    const events = [{ _id: '1', event_type: 'unrelated_event', created_at: '2026-01-01T00:00:00Z' }];\n    const items = buildConversationItems(t, events as never);\n    expect(items.some(i => i.kind === 'event')).toBe(false);\n  });\n});\n\ndescribe('normalizeTranscriptRole', () => {\n  it.each([\n    ['assistant', 'assistant'], ['agent', 'assistant'], ['bot', 'assistant'], ['model', 'assistant'],\n    ['user', 'user'], ['customer', 'user'], ['caller', 'user'], ['human', 'user'],\n    ['recording', 'recording'], ['verified_recording', 'recording'],\n  ])('maps %s -> %s', (input, expected) => {\n    expect(normalizeTranscriptRole(input)).toBe(expected);\n  });\n  it('defaults to \"system\" for unknown/empty role', () => {\n    expect(normalizeTranscriptRole('')).toBe('system');\n    expect(normalizeTranscriptRole('weird')).toBe('weird');\n  });\n});\n\ndescribe('transcriptSourceLabel', () => {\n  it.each([\n    ['succeeded', 'Verified recording'],\n    ['pending', 'Live transcript, verification pending'],\n    ['failed', 'Live transcript, verification failed'],\n    ['unavailable', 'Live transcript, recording unavailable'],\n  ])('status %s -> %s', (status, label) => {\n    expect(transcriptSourceLabel({ verified_transcript_status: status } as Transcript)).toBe(label);\n  });\n  it('falls back to analysis/transcript source when no verified status', () => {\n    expect(transcriptSourceLabel({ transcript_source: 'gemini_live' } as Transcript)).toBe('Gemini Live');\n  });\n});\n\ndescribe('maxResponseDelayLabel', () => {\n  it('returns \"-\" when no delay present', () => {\n    expect(maxResponseDelayLabel({} as Transcript)).toBe('-');\n  });\n  it('labels under 3000ms plain', () => {\n    expect(maxResponseDelayLabel({ latency_metrics: { max_response_delay_ms: 1500 } } as Transcript)).toBe('1500ms');\n  });\n  it('labels 3000-7999ms as slow', () => {\n    expect(maxResponseDelayLabel({ latency_metrics: { max_response_delay_ms: 3500 } } as Transcript)).toBe('3500ms slow');\n  });\n  it('labels 8000ms+ as high', () => {\n    expect(maxResponseDelayLabel({ latency_metrics: { max_response_delay_ms: 9000 } } as Transcript)).toBe('9000ms high');\n  });\n});\n```\n\n",
        "level": 3
      },
      {
        "title": "5. `src/utils/config.ts` — no tests",
        "content": "Gaps: `parseConfig` malformed JSON error message extraction, `deriveAgentState` full branch matrix (idle/connecting/speaking/thinking/listening priority order), no-room override.\n\n```ts\n// src/utils/config.test.ts\nimport { describe, it, expect } from 'vitest';\nimport { parseConfig, deriveAgentState } from './config';\n\ndescribe('parseConfig', () => {\n  it('returns ok:true with parsed value for valid JSON', () => {\n    expect(parseConfig('{\"a\":1}')).toEqual({ ok: true, value: { a: 1 } });\n  });\n  it('returns ok:false with error message for invalid JSON', () => {\n    const result = parseConfig('{bad json');\n    expect(result.ok).toBe(false);\n  });\n});\n\ndescribe('deriveAgentState', () => {\n  it('returns idle when hasRoom is false regardless of status', () => {\n    expect(deriveAgentState('speaking', true, false)).toBe('idle');\n  });\n  it('returns idle for idle/disconnected status', () => {\n    expect(deriveAgentState('idle', false, true)).toBe('idle');\n    expect(deriveAgentState('Disconnected', false, true)).toBe('idle');\n  });\n  it('returns connecting for connecting-ish statuses', () => {\n    expect(deriveAgentState('Creating room', false, true)).toBe('connecting');\n    expect(deriveAgentState('Reconnecting', false, true)).toBe('connecting');\n  });\n  it('returns speaking when remoteAudioReady even if status is generic', () => {\n    expect(deriveAgentState('connected', true, true)).toBe('speaking');\n  });\n  it('returns thinking for waiting/participant-joined statuses', () => {\n    expect(deriveAgentState('Waiting for bot', false, true)).toBe('thinking');\n  });\n  it('defaults to listening otherwise', () => {\n    expect(deriveAgentState('connected', false, true)).toBe('listening');\n  });\n});\n```\n\n",
        "level": 3
      },
      {
        "title": "6. `src/hooks/useToasts.ts` — no tests",
        "content": "Gaps: auto-dismiss timing, `durationMs=0` disables auto-dismiss, id uniqueness across multiple toasts, manual `dismissToast`.\n\n```ts\n// src/hooks/useToasts.test.ts\nimport { describe, it, expect, vi } from 'vitest';\nimport { renderHook, act } from '@testing-library/react';\nimport { useToasts } from './useToasts';\n\ndescribe('useToasts', () => {\n  it('adds a toast with default tone and duration', () => {\n    const { result } = renderHook(() => useToasts());\n    act(() => { result.current.showToast('hi'); });\n    expect(result.current.toasts).toHaveLength(1);\n    expect(result.current.toasts[0]).toMatchObject({ message: 'hi', tone: 'success' });\n  });\n\n  it('assigns unique incrementing ids', () => {\n    const { result } = renderHook(() => useToasts());\n    act(() => { result.current.showToast('a'); result.current.showToast('b'); });\n    const ids = result.current.toasts.map(t => t.id);\n    expect(new Set(ids).size).toBe(2);\n  });\n\n  it('auto-dismisses after durationMs', () => {\n    vi.useFakeTimers();\n    const { result } = renderHook(() => useToasts());\n    act(() => { result.current.showToast('bye', 'error', 1000); });\n    expect(result.current.toasts).toHaveLength(1);\n    act(() => { vi.advanceTimersByTime(1000); });\n    expect(result.current.toasts).toHaveLength(0);\n    vi.useRealTimers();\n  });\n\n  it('does not auto-dismiss when durationMs is 0', () => {\n    vi.useFakeTimers();\n    const { result } = renderHook(() => useToasts());\n    act(() => { result.current.showToast('sticky', 'info', 0); });\n    act(() => { vi.advanceTimersByTime(10000); });\n    expect(result.current.toasts).toHaveLength(1);\n    vi.useRealTimers();\n  });\n\n  it('dismissToast removes a toast manually', () => {\n    const { result } = renderHook(() => useToasts());\n    let id = '';\n    act(() => { id = result.current.showToast('x', 'info', 0); });\n    act(() => { result.current.dismissToast(id); });\n    expect(result.current.toasts).toHaveLength(0);\n  });\n});\n```\n\n",
        "level": 3
      },
      {
        "title": "7. `src/hooks/useCountUp.ts` — no tests",
        "content": "Gaps: `target === 0` short-circuits, easing reaches target at end, class add/remove on ref. Requires mocking `requestAnimationFrame`/`performance.now`.\n\n```ts\n// src/hooks/useCountUp.test.ts\nimport { describe, it, expect, vi, beforeEach, afterEach } from 'vitest';\nimport { renderHook } from '@testing-library/react';\nimport { useCountUp } from './useCountUp';\n\ndescribe('useCountUp', () => {\n  beforeEach(() => {\n    let frame = 0;\n    vi.stubGlobal('requestAnimationFrame', (cb: FrameRequestCallback) => {\n      frame += 16;\n      cb(frame);\n      return frame;\n    });\n  });\n  afterEach(() => vi.unstubAllGlobals());\n\n  it('stays at 0 when target is 0', () => {\n    const { result } = renderHook(() => useCountUp(0));\n    expect(result.current.value).toBe(0);\n  });\n\n  it('eventually reaches the target value', () => {\n    const { result, rerender } = renderHook(() => useCountUp(100, 1));\n    rerender();\n    expect(result.current.value).toBeGreaterThanOrEqual(0);\n  });\n});\n```\n\n",
        "level": 3
      },
      {
        "title": "8. `src/utils/cache.ts` — partially untested (`cacheSet`/`cacheGet`/`pruneOldCache` have no tests)",
        "content": "Gaps: silent failure on quota exceeded / JSON errors, `pruneOldCache` only removes stale-version keys not current-version ones, `cacheGet` fallback on corrupt JSON.\n\n```ts\n// src/utils/cache.test.ts\nimport { describe, it, expect, beforeEach } from 'vitest';\nimport { cacheSet, cacheGet, pruneOldCache, CACHE_PREFIX } from './cache';\n\ndescribe('cacheSet / cacheGet', () => {\n  beforeEach(() => localStorage.clear());\n\n  it('round-trips a value', () => {\n    cacheSet('k', { a: 1 });\n    expect(cacheGet('k', null)).toEqual({ a: 1 });\n  });\n  it('returns fallback when key missing', () => {\n    expect(cacheGet('missing', 'fallback')).toBe('fallback');\n  });\n  it('returns fallback on corrupt JSON', () => {\n    localStorage.setItem(`${CACHE_PREFIX}bad`, '{not json');\n    expect(cacheGet('bad', 'fallback')).toBe('fallback');\n  });\n});\n\ndescribe('pruneOldCache', () => {\n  beforeEach(() => localStorage.clear());\n\n  it('removes keys from older cache versions', () => {\n    localStorage.setItem('jd-vb:v1:old', '\"x\"');\n    localStorage.setItem(`${CACHE_PREFIX}current`, '\"y\"');\n    pruneOldCache();\n    expect(localStorage.getItem('jd-vb:v1:old')).toBeNull();\n    expect(localStorage.getItem(`${CACHE_PREFIX}current`)).not.toBeNull();\n  });\n  it('leaves unrelated keys untouched', () => {\n    localStorage.setItem('unrelated', '\"z\"');\n    pruneOldCache();\n    expect(localStorage.getItem('unrelated')).toBe('\"z\"');\n  });\n});\n```\n\n",
        "level": 3
      },

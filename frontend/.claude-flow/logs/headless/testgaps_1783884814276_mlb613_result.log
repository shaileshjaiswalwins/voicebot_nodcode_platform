        "language": "ts",
        "code": "// src/api.test.ts\nimport { describe, it, expect, beforeEach, vi } from 'vitest';\nimport { getToken, setToken, clearToken, apiUrl, ApiError, API_BASE } from './api';\n\ndescribe('token storage', () => {\n  beforeEach(() => localStorage.clear());\n  it('returns empty string when no token set', () => {\n    expect(getToken()).toBe('');\n  });\n  it('round-trips set/get/clear', () => {\n    setToken('abc');\n    expect(getToken()).toBe('abc');\n    clearToken();\n    expect(getToken()).toBe('');\n  });\n});\n\ndescribe('apiUrl', () => {\n  it('prefixes relative paths with API_BASE', () => {\n    expect(apiUrl('/bots')).toBe(`${API_BASE}/bots`);\n    expect(apiUrl('bots')).toBe(`${API_BASE}/bots`);\n  });\n  it('passes through absolute URLs unchanged', () => {\n    expect(apiUrl('https://other.example.com/x')).toBe('https://other.example.com/x');\n  });\n});\n\ndescribe('request() via a public API function', () => {\n  beforeEach(() => { localStorage.clear(); vi.restoreAllMocks(); });\n\n  it('clears token on 401', async () => {\n    setToken('stale');\n    vi.stubGlobal('fetch', vi.fn().mockResolvedValue(new Response('', { status: 401 })));\n    await expect(/* e.g. listBots() */ Promise.reject()).rejects.toBeDefined();\n    expect(getToken()).toBe('');\n  });\n\n  it('throws ApiError with status + body text on non-ok response', async () => {\n    vi.stubGlobal('fetch', vi.fn().mockResolvedValue(new Response('bad request', { status: 400 })));\n    // await expect(listBots()).rejects.toMatchObject({ status: 400, message: 'bad request' });\n  });\n\n  it('falls back to statusText when body is empty', async () => {\n    vi.stubGlobal('fetch', vi.fn().mockResolvedValue(new Response('', { status: 500, statusText: 'Server Error' })));\n    // await expect(listBots()).rejects.toThrow('Server Error');\n  });\n\n  it('returns undefined for 204 responses', async () => {\n    vi.stubGlobal('fetch', vi.fn().mockResolvedValue(new Response(null, { status: 204 })));\n    // await expect(deleteBot('id')).resolves.toBeUndefined();\n  });\n\n  it('attaches Authorization header when token present', async () => {\n    setToken('tok123');\n    const fetchMock = vi.fn().mockResolvedValue(new Response('{}', { status: 200 }));\n    vi.stubGlobal('fetch', fetchMock);\n    // await listBots();\n    // expect(fetchMock.mock.calls[0][1].headers.Authorization).toBe('Bearer tok123');\n  });\n});"
